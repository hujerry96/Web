---
import type { Locale } from '../i18n/config';
import { LOCALES } from '../i18n/config';
import { withBase } from '../consts';

interface Props { path: string; locale: Locale; }
const { path, locale } = Astro.props;

function switchPath(target: Locale): string {
  return withBase(`/${target}`);
}
const others = LOCALES.filter((l) => l !== locale);
const flag: Record<Locale, string> = { zh: '🇹🇼', en: '🇺🇸' };
---
<div class="inline-flex items-center gap-[0.2rem] text-[0.85rem] leading-none font-serif">
  <span aria-current="true" class="cursor-default drop-shadow-[0_0_1px_rgba(0,0,0,0.1)]">{flag[locale]}</span>
  <span class="text-lab-text-muted text-[0.7rem]" aria-hidden="true">·</span>
  {others.map((l) => (
    <a href={switchPath(l)} hreflang={l === 'en' ? 'en-US' : 'zh-TW'} class="no-underline opacity-55 transition-opacity duration-150 hover:opacity-100">{flag[l]}</a>
  ))}
</div>
