---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getPosts } from '../../../lib/content';
import { useTranslations } from '../../../i18n/ui';
import { SITE, type Locale } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const paths: { params: { locale: string; category: string }; props: { posts: any[] } }[] = [];
  for (const locale of ['zh', 'en'] as Locale[]) {
    const cats = Object.keys(SITE.categories[locale]);
    for (const category of cats) {
      const inCat = posts.filter((p: any) => p.id.startsWith(`${locale}/${category}/`));
      paths.push({ params: { locale, category }, props: { posts: inCat } });
    }
  }
  return paths;
}

const { locale, category } = Astro.params as { locale: Locale; category: string };
const { posts } = Astro.props as { posts: any[] };
const t = useTranslations(locale);
const catName =
  (SITE.categories[locale] as Record<string, string>)[category] ?? category;
const path = `/${locale}/${category}`;
---
<BaseLayout title={`${catName} | ${SITE.name}`} description={`${catName} — ${SITE.name}`} path={path} wide>
  <Breadcrumb locale={locale} items={[{ name: catName, url: path }]} />
  <h1 class="text-[clamp(1.8rem,1rem+3vw,2.6rem)]">{catName}</h1>
  <p class="text-lab-text-muted">{t('home.postsCount', { n: posts.length })}</p>
  {posts.length > 0 ? (
    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,280px),1fr))] gap-5 my-6">
      {posts.map((post) => <ArticleCard post={post} locale={locale} />)}
    </div>
  ) : (
    <p class="text-lab-text-muted text-[1.05rem] py-8">{t('category.empty')}</p>
  )}
</BaseLayout>
