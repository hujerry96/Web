---
import type { Post } from '../lib/content';
import { parseId, postPath } from '../lib/content';
import { SITE } from '../consts';
import { useTranslations } from '../i18n/ui';
import { Image } from 'astro:assets';

interface Props { post: Post; locale: 'zh' | 'en'; }
const { post, locale } = Astro.props;
const t = useTranslations(locale);
const { category } = parseId(post.id);
const href = postPath(post);
const cover = post.data.cover;
const catName = (SITE.categories[locale] as Record<string, string>)[category] ?? category;
---
<article class="article-card group">
  <a href={href} class="block text-inherit no-underline">
    <div class="article-card__image">
      {cover ? (
        <Image src={cover} alt={post.data.title} width={640} height={360} class="w-full h-full object-cover" loading="lazy" />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-[var(--color-accent-muted)] text-[var(--color-accent)] text-sm tracking-wide">
          <span>{catName}</span>
        </div>
      )}
    </div>
    <div class="article-card__body">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-[0.7rem] font-medium uppercase tracking-[0.08em] text-[var(--color-accent)]">{catName}</span>
      </div>
      <h3 class="text-[1rem] font-display font-semibold leading-snug mb-1.5 group-hover:text-[var(--color-accent)] transition-colors duration-200">{post.data.title}</h3>
      <p class="text-[0.85rem] text-[var(--color-text-secondary)] m-0 mb-3 line-clamp-2 leading-relaxed">{post.data.description}</p>
      <time datetime={post.data.date.toISOString()} class="text-[0.75rem] text-[var(--color-text-tertiary)]">
        {post.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}
      </time>
    </div>
  </a>
</article>

<style>
  .article-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    transition: transform 450ms var(--ease-out-expo),
                border-color 450ms var(--ease-out),
                box-shadow 450ms var(--ease-out);
    will-change: transform;
  }
  .article-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 15px;
    background: linear-gradient(135deg, var(--color-accent), transparent 40%, transparent 60%, var(--color-accent-dim));
    opacity: 0;
    transition: opacity 450ms var(--ease-out);
    z-index: 0;
    pointer-events: none;
  }
  .article-card:hover::before {
    opacity: 0.35;
  }
  .article-card:hover {
    transform: translateY(-6px) scale(1.01);
    border-color: transparent;
    box-shadow:
      0 12px 40px -8px var(--color-accent-glow),
      0 4px 16px rgba(0,0,0,0.2);
  }
  .article-card__image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-surface-raised);
    position: relative;
    z-index: 1;
  }
  .article-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out-expo);
    will-change: transform;
  }
  .article-card:hover .article-card__image :global(img) {
    transform: scale(1.06);
  }
  .article-card__body {
    padding: 1rem 1.15rem 1.25rem;
    position: relative;
    z-index: 1;
    transition: transform 400ms var(--ease-out-expo);
    background: var(--color-surface);
  }
  .article-card:hover .article-card__body {
    transform: translateY(-2px);
  }

  /* Category badge animation */
  .article-card__body :global(.text-\[0\.7rem\]) {
    transition: color 300ms var(--ease-out);
  }
  .article-card:hover .article-card__body :global(.text-\[0\.7rem\]) {
    color: var(--color-accent);
  }
</style>
