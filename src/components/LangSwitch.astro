---
import type { Locale } from '../i18n/config';
import { LOCALE_NAMES, LOCALES } from '../i18n/config';
import { withBase } from '../consts';

interface Props { path: string; locale: Locale; }
const { path, locale } = Astro.props;

// 把當前路徑的語系段替換為目標語系，產生跨語系同頁連結
function switchPath(target: Locale): string {
  const parts = path.split('/');
  if (parts[1] === 'zh' || parts[1] === 'en') parts[1] = target;
  else parts.splice(1, 0, target);
  const raw = parts.join('/') || `/${target}`;
  return withBase(raw);
}
const others = LOCALES.filter((l) => l !== locale);
---
<div class="lang-switch" aria-label="language">
  <span class="current">{LOCALE_NAMES[locale]}</span>
  {others.map((l) => (
    <a href={switchPath(l)} hreflang={l === 'en' ? 'en-US' : 'zh-TW'}>{LOCALE_NAMES[l]}</a>
  ))}
</div>

<style>
  .lang-switch {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.85rem;
  }
  .current { color: var(--text); font-weight: 600; }
  .lang-switch a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .lang-switch a:hover { color: var(--text); }
</style>
