---
import { SITE, withBase } from '../consts';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import LangSwitch from './LangSwitch.astro';

interface Props { path: string; locale: Locale; }
const { path, locale } = Astro.props;
const t = useTranslations(locale);

type NavItem = { href: string; key: Parameters<typeof t>[0] };

const nav: NavItem[] = locale === 'zh'
  ? [
      { href: '/zh/ai', key: 'nav.ai' },
      { href: '/zh/shopee', key: 'nav.shopee' },
      { href: '/zh/python', key: 'nav.python' },
      { href: '/zh/reviews', key: 'nav.reviews' },
      { href: '/zh/blog', key: 'nav.blog' },
    ]
  : [
      { href: '/en/books', key: 'nav.books' },
      { href: '/en/study', key: 'nav.study' },
      { href: '/en/blog', key: 'nav.blog' },
      { href: '/en/lab', key: 'nav.lab' },
      { href: '/en/printable', key: 'nav.printable' },
      { href: '/en/engineering', key: 'nav.engineering' },
    ];
const staticLinks: NavItem[] = [
  { href: `/${locale}/free-resources`, key: 'nav.free' },
  { href: `/${locale}/about`, key: 'nav.about' },
  { href: `/${locale}/contact`, key: 'nav.contact' },
];
---
<header class="site-header" id="site-header">
  <div class="container header-top">
    <button class="hamburger" id="hamburger" aria-label={t('nav.home')}>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
    <a href={withBase(`/${locale}`)} class="brand">
      <span class="brand-name">{SITE.name}</span>
      <span class="brand-sub">{SITE.authorZh} · {SITE.author}</span>
    </a>
    <div class="header-actions">
      <a class="header-search" href={withBase(`/${locale}/search`)} aria-label={t('nav.search')} title={t('nav.search')}>🔍</a>
      <button class="theme-toggle" id="theme-toggle" aria-label={t('a11y.theme')} title={t('a11y.theme')}>
        <span class="tt-icon" aria-hidden="true">🌙</span>
      </button>
      <LangSwitch path={path} locale={locale} />
    </div>
  </div>
  <nav class="container header-nav" aria-label="primary">
    {nav.map((item) => (
      <a href={withBase(item.href)}>{t(item.key)}</a>
    ))}
    <span class="nav-slash" aria-hidden="true">·</span>
    {staticLinks.map((item) => (
      <a href={withBase(item.href)} class="muted-link">{t(item.key)}</a>
    ))}
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const hamburger = document.getElementById('hamburger');
  if (header && hamburger) {
    hamburger.addEventListener('click', () => {
      header.classList.toggle('nav-open');
    });
    header.querySelectorAll('.header-nav a').forEach((link) => {
      link.addEventListener('click', () => {
        header.classList.remove('nav-open');
      });
    });
  }
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: rgba(244, 239, 230, 0.85);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    backdrop-filter: saturate(180%) blur(8px);
  }
  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
  }
  .brand {
    font-family: var(--font-serif-display);
    font-weight: 500;
    font-size: 1.2rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .brand-name { white-space: nowrap; }
  .brand-sub {
    font-family: var(--font-serif-body);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: none;
    color: var(--color-text-faint);
    margin-top: 3px;
    font-weight: 400;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .header-search {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    text-decoration: none;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    transition: background var(--duration-fast) var(--ease), color var(--duration-fast) var(--ease);
  }
  .header-search:hover { background: var(--color-accent-soft); color: var(--color-accent); }
  .theme-toggle {
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 1rem;
    padding: 0;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--duration-fast) var(--ease), transform var(--duration-fast) var(--ease);
    color: var(--color-text-muted);
  }
  .theme-toggle:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent);
    transform: rotate(-15deg);
  }
  .tt-icon { display: inline-block; line-height: 1; }

  /* ── 下層 nav：連結 ── */
  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 4px 0 10px;
    flex-wrap: wrap;
  }
  .header-nav a {
    font-family: var(--font-serif-body);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 2px 0;
    border-bottom: 1px solid transparent;
    transition: color var(--duration-fast) var(--ease), border-color var(--duration-fast) var(--ease);
  }
  .header-nav a:hover { color: var(--color-accent); border-bottom-color: var(--color-accent); }
  .header-nav .muted-link { color: var(--color-text-muted); font-weight: 400; }
  .header-nav .muted-link:hover { color: var(--color-accent); }
  .nav-slash {
    font-family: var(--font-serif-body);
    font-size: 0.7rem;
    color: var(--color-text-faint);
    margin: 0 0.1rem;
    letter-spacing: 0.04em;
  }

  /* ── 行動版 ── */
  .hamburger { display: none; }

  @media (max-width: 640px) {
    .hamburger {
      display: block;
      width: 40px;
      height: 40px;
      border: none;
      background: none;
      cursor: pointer;
      padding: var(--space-3);
      position: relative;
      z-index: var(--z-sticky);
      color: var(--color-text);
      margin-left: -8px;
    }
    .hamburger-line {
      display: block;
      width: 100%;
      height: 2px;
      background: currentColor;
      border-radius: 2px;
      transition: transform var(--duration-normal) var(--ease),
        opacity var(--duration-fast) var(--ease);
    }
    .hamburger-line + .hamburger-line { margin-top: 5px; }
    .nav-open .hamburger-line:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-open .hamburger-line:nth-child(2) { opacity: 0; }
    .nav-open .hamburger-line:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .header-nav {
      display: none;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding: var(--space-4) 0 var(--space-5);
      border-top: 1px solid var(--color-border);
    }
    .nav-open .header-nav { display: flex; }
    .nav-flourish, .nav-slash { display: none; }
    .header-nav a { font-size: var(--text-base); }
  }
</style>
