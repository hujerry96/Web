---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, type Locale } from '../../consts';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const path = `/${locale}/contact`;
const social = SITE.social as Record<string, string>;
---
<BaseLayout title={`${t('nav.contact')} | ${SITE.name}`} description={t('page.contactDesc', { name: SITE.name })} path={path}>
  <Breadcrumb locale={locale} items={[{ name: t('nav.contact'), url: path }]} />
  <h1 class="text-[clamp(1.8rem,1rem+3vw,2.6rem)] m-0 mb-4">{t('nav.contact')}</h1>
  <article class="prose">
    <p>{t('page.contactLead')}</p>

    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,240px),1fr))] gap-4 my-8">
      <a class="flex flex-col gap-1.5 no-underline p-[1.1rem_1.2rem] border border-border rounded-[10px] bg-lab-surface transition-all duration-150 hover:border-lab-accent hover:shadow-md hover:-translate-y-0.5" href={`mailto:${SITE.email}`}>
        <span class="text-[0.72rem] tracking-[0.16em] uppercase text-lab-accent">{t('contact.email')}</span>
        <span class="font-serif text-lab-text text-[0.95rem] break-all">{SITE.email}</span>
      </a>
      {social.github && (
        <a class="flex flex-col gap-1.5 no-underline p-[1.1rem_1.2rem] border border-border rounded-[10px] bg-lab-surface transition-all duration-150 hover:border-lab-accent hover:shadow-md hover:-translate-y-0.5" href={social.github} rel="me">
          <span class="text-[0.72rem] tracking-[0.16em] uppercase text-lab-accent">GitHub</span>
          <span class="font-serif text-lab-text text-[0.95rem] break-all">{social.github}</span>
        </a>
      )}
      {social.x && (
        <a class="flex flex-col gap-1.5 no-underline p-[1.1rem_1.2rem] border border-border rounded-[10px] bg-lab-surface transition-all duration-150 hover:border-lab-accent hover:shadow-md hover:-translate-y-0.5" href={social.x} rel="me">
          <span class="text-[0.72rem] tracking-[0.16em] uppercase text-lab-accent">X</span>
          <span class="font-serif text-lab-text text-[0.95rem] break-all">{social.x}</span>
        </a>
      )}
    </div>
  </article>
</BaseLayout>
