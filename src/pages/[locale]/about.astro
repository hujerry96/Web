---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, type Locale } from '../../consts';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const path = `/${locale}/about`;
---
<BaseLayout title={`${t('nav.about')} | ${SITE.name}`} description={t('nav.about') + ' — ' + SITE.name} path={path}>
  <Breadcrumb locale={locale} items={[{ name: t('nav.about'), url: path }]} />
  <h1>{t('nav.about')}</h1>
  <article class="prose">
    <p>{t('page.aboutDesc', { name: SITE.name, author: SITE.authorZh })}</p>
    <p>{t('page.aboutDesc2')}</p>
  </article>
</BaseLayout>
