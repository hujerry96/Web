---
import { SITE, withBase } from '../consts';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const cats = SITE.categories[locale] as Record<string, string>;
---
<footer class="mt-12 border-t border-[var(--color-border)] text-[var(--color-term-text-muted)] text-sm font-mono">
  <div class="mx-auto max-w-4xl px-5 py-8">
    <div class="term-prompt text-xs mb-6">exit</div>
    <div class="grid grid-cols-[2fr_1fr_1fr] gap-8 mb-6 max-sm:!grid-cols-1 max-sm:!gap-4">
      <div class="flex flex-col gap-1.5">
        <span class="text-[var(--color-term-text)] font-medium tracking-[0.08em]">{SITE.name}</span>
        <p class="m-0 leading-normal max-w-[28rem] text-xs">{SITE.meta[locale].description}</p>
        <div class="flex gap-3 mt-2 text-xs">
          {SITE.social.github && <a class="text-[var(--color-term-text-muted)] no-underline hover:text-[var(--color-term-accent)]" href={SITE.social.github} rel="me">github</a>}
          {SITE.social.x && <a class="text-[var(--color-term-text-muted)] no-underline hover:text-[var(--color-term-accent)]" href={SITE.social.x} rel="me">x</a>}
        </div>
      </div>
      <div class="flex flex-col gap-1.5 text-xs">
        <span class="text-[var(--color-term-accent)] tracking-[0.08em] uppercase mb-1">{t('home.categories')}</span>
        {Object.entries(cats).map(([key, name]) => (
          <a href={withBase(`/${locale}/${key}`)} class="text-[var(--color-term-text-muted)] no-underline hover:text-[var(--color-term-accent)]">{name}</a>
        ))}
      </div>
      <div class="flex flex-col gap-1.5 text-xs">
        <span class="text-[var(--color-term-accent)] tracking-[0.08em] uppercase mb-1">{t('nav.about')}</span>
        <a href={withBase(`/${locale}/about`)} class="text-[var(--color-term-text-muted)] no-underline hover:text-[var(--color-term-accent)]">{t('nav.about')}</a>
        <a href={withBase(`/${locale}/contact`)} class="text-[var(--color-term-text-muted)] no-underline hover:text-[var(--color-term-accent)]">{t('nav.contact')}</a>
        <a href={withBase(`/${locale}/free-resources`)} class="text-[var(--color-term-text-muted)] no-underline hover:text-[var(--color-term-accent)]">{t('nav.free')}</a>
        <a href={withBase(`/${locale}/rss.xml`)} class="text-[var(--color-term-text-muted)] no-underline hover:text-[var(--color-term-accent)]">rss</a>
      </div>
    </div>
    <div class="flex justify-between items-center flex-wrap gap-2 pt-4 border-t border-[var(--color-border-soft)] text-xs">
      <span>&copy; {year} {SITE.name}</span>
      <span class="opacity-60">session closed</span>
    </div>
  </div>
</footer>
