---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, readingTime } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const all = await getPosts();
  const locales = ['zh', 'en'] as Locale[];
  return locales.map((locale) => {
    const posts = all.filter((p) => p.id.startsWith(`${locale}/`));
    return { params: { locale }, props: { posts } };
  });
}

const { locale } = Astro.params as { locale: Locale };
const { posts } = Astro.props as { posts: any[] };
const t = useTranslations(locale);
const path = `/${locale}`;

const projects = posts.filter((p) => p.data.project).slice(0, 2);
const latest = posts.slice(0, 6);
const catCounts: Record<string, number> = {};
for (const p of posts) { const c = p.id.split('/')[1]; catCounts[c] = (catCounts[c] ?? 0) + 1; }
const cats = SITE.categories[locale] as Record<string, string>;
---
<BaseLayout title={SITE.meta[locale].title} description={SITE.meta[locale].description} path={path} wide>

  <!-- ── Hero ── -->
  <section class="hero" id="hero">
    <canvas class="hero-canvas" id="hero-canvas" aria-hidden="true"></canvas>
    <div class="hero-content">
      <span class="hero-badge">{t('home.tagline')}</span>
      <h1 class="hero-title">Hu Lab</h1>
      <p class="hero-desc">{t('home.intro')}</p>
      <div class="hero-cats">
        {Object.entries(cats).map(([key, name]) => (
          <a href={withBase(`/${locale}/${key}`)} class="hero-cat">
            {name}
            <span class="hero-cat-count">{catCounts[key] ?? 0}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Projects ── -->
  {projects.length > 0 && (
    <section class="section reveal">
      <h2 class="section-label">{t('home.projects')}</h2>
      <div class="project-grid">
        {projects.map((post) => {
          const cat = post.id.split('/')[1];
          const catName = cats[cat] ?? cat;
          const slug = post.data.slug ?? post.id.split('/').slice(2).join('/');
          return (
            <a href={withBase(`/${locale}/${cat}/${slug}`)} class="project-card group">
              <div class="project-card__image">
                {post.data.cover
                  ? <Image src={post.data.cover} alt={post.data.title} width={640} height={400} class="w-full h-full object-cover" loading="lazy" />
                  : <div class="w-full h-full flex items-center justify-center bg-[var(--color-accent-muted)] text-[var(--color-accent)] text-sm">{catName}</div>
                }
              </div>
              <div class="project-card__body">
                <span class="project-card__cat">{catName}</span>
                <h3 class="project-card__title">{post.data.title}</h3>
                <p class="project-card__desc">{post.data.description}</p>
                <div class="project-card__meta">
                  <span>{post.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</span>
                  <span class="opacity-40">·</span>
                  <span>{readingTime(post.body, locale)}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- ── Latest posts ── -->
  <section class="section reveal reveal-delay-1">
    <h2 class="section-label">{t('home.latest')}</h2>
    <div class="post-grid">
      {latest.map((post) => (
        <ArticleCard post={post} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 4rem;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(ellipse at 50% 60%, var(--color-accent-muted) 0%, transparent 60%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 640px;
  }
  .js .hero-content > * {
    opacity: 0;
    transform: translateY(20px);
  }
  .hero-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 1.5rem + 6vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 1rem;
    color: var(--color-text);
  }
  .hero-desc {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.2rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 480px;
    margin: 0 auto 2rem;
  }
  .hero-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .hero-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: all 200ms var(--ease);
  }
  .hero-cat:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-muted);
  }
  .hero-cat-count {
    font-size: 0.7rem;
    opacity: 0.6;
  }

  .section {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }
  .section-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin: 0 0 1.5rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 280ms var(--ease), box-shadow 280ms var(--ease), transform 280ms var(--ease);
    background: var(--color-surface);
  }
  .project-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 12px 40px -10px var(--color-accent-glow), 0 4px 12px rgba(0,0,0,0.15);
    transform: translateY(-3px);
  }
  .project-card__image {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--color-surface-raised);
  }
  .project-card__image :global(img) {
    transition: transform 500ms var(--ease);
  }
  .project-card:hover .project-card__image :global(img) {
    transform: scale(1.04);
  }
  .project-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }
  .project-card__cat {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .project-card__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    color: var(--color-text);
    transition: color 200ms var(--ease);
  }
  .project-card:hover .project-card__title {
    color: var(--color-accent);
  }
  .project-card__desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-card__meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--color-text-tertiary);
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
    .hero {
      min-height: 80vh;
      padding: 4rem 1.5rem 3rem;
    }
  }
</style>

<script>
import * as THREE from 'three';
import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
import { gsap } from 'gsap';

(function() {
  const canvas = document.getElementById('hero-canvas');
  const hero = document.getElementById('hero');
  const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!canvas || !hero) return;

  function getAccent() {
    return getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim() || '#6c8cff';
  }

  const accent = new THREE.Color(getAccent());

  // Scene
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(45, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
  camera.position.z = 9;

  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(canvas.clientWidth, canvas.clientHeight);
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.2;

  // Group for all geometries
  const group = new THREE.Group();

  // Main: torus knot
  const geo1 = new THREE.TorusKnotGeometry(1.3, 0.45, 180, 24);
  const mat1 = new THREE.MeshStandardMaterial({
    color: accent,
    emissive: accent,
    emissiveIntensity: 0.35,
    metalness: 0.6,
    roughness: 0.25,
  });
  const mesh1 = new THREE.Mesh(geo1, mat1);
  mesh1.position.set(0, 0.5, 0);
  group.add(mesh1);

  // Secondary: icosahedron wireframe
  const geo2 = new THREE.IcosahedronGeometry(0.7, 0);
  const mat2 = new THREE.MeshStandardMaterial({
    color: accent,
    emissive: accent,
    emissiveIntensity: 0.15,
    metalness: 0.2,
    roughness: 0.7,
    wireframe: true,
    transparent: true,
    opacity: 0.7,
  });
  const mesh2 = new THREE.Mesh(geo2, mat2);
  mesh2.position.set(-2.5, -1, -1.5);
  group.add(mesh2);

  // Tertiary: thin ring
  const geo3 = new THREE.TorusGeometry(0.9, 0.05, 24, 80);
  const mat3 = new THREE.MeshStandardMaterial({
    color: accent,
    emissive: accent,
    emissiveIntensity: 0.2,
    metalness: 0.5,
    roughness: 0.4,
    transparent: true,
    opacity: 0.5,
  });
  const mesh3 = new THREE.Mesh(geo3, mat3);
  mesh3.position.set(2.2, -0.3, -3);
  mesh3.rotation.x = Math.PI / 3;
  group.add(mesh3);

  scene.add(group);

  // Lights
  const ambient = new THREE.AmbientLight(0x404060, 0.4);
  scene.add(ambient);
  const light1 = new THREE.PointLight(accent, 2, 20);
  light1.position.set(5, 5, 5);
  scene.add(light1);
  const light2 = new THREE.PointLight(accent, 0.8, 15);
  light2.position.set(-4, -2, 4);
  scene.add(light2);

  // Bloom
  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  const bloom = new UnrealBloomPass(
    new THREE.Vector2(canvas.clientWidth, canvas.clientHeight),
    0.45, 0.4, 0.85
  );
  composer.addPass(bloom);

  // Mouse
  let mouseX = 0, mouseY = 0, targetX = 0, targetY = 0;
  canvas.addEventListener('mousemove', (e) => {
    const r = canvas.getBoundingClientRect();
    mouseX = ((e.clientX - r.left) / r.width - 0.5) * 2;
    mouseY = ((e.clientY - r.top) / r.height - 0.5) * 2;
  });

  // Resize
  function resize() {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
    composer.setSize(w, h);
  }
  window.addEventListener('resize', resize);
  resize();

  // Scroll fade
  function updateOpacity() {
    const rect = hero.getBoundingClientRect();
    const progress = Math.max(0, Math.min(1, rect.bottom / window.innerHeight));
    canvas.style.opacity = progress * progress;
  }
  window.addEventListener('scroll', updateOpacity, { passive: true });

  // Theme toggle
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    setTimeout(() => {
      const c = new THREE.Color(getAccent());
      [mat1, mat2, mat3].forEach(m => { m.color.copy(c); m.emissive.copy(c); });
      light1.color.copy(c);
      light2.color.copy(c);
    }, 50);
  });

  // Animate
  function animate() {
    requestAnimationFrame(animate);

    targetX += (mouseX - targetX) * 0.05;
    targetY += (mouseY - targetY) * 0.05;

    mesh1.rotation.x += 0.004;
    mesh1.rotation.y += 0.01;
    const t = Date.now() * 0.001;
    mesh1.scale.setScalar(1 + Math.sin(t * 0.3) * 0.02);

    mesh2.rotation.x += 0.008;
    mesh2.rotation.y += 0.006;

    mesh3.rotation.z += 0.003;
    mesh3.rotation.y += 0.005;

    if (!isReduced) {
      group.rotation.x = targetY * 0.15;
      group.rotation.y = targetX * 0.2;
    }

    composer.render();
  }
  animate();

  updateOpacity();

  // Hero entrance
  if (!isReduced) {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 0.8 } });
    tl.to('.hero-badge', { opacity: 1, y: 0, duration: 0.5 })
      .to('.hero-title', { opacity: 1, y: 0 }, '-=0.3')
      .to('.hero-desc', { opacity: 1, y: 0 }, '-=0.3')
      .to('.hero-cat', { opacity: 1, y: 0, stagger: 0.08 }, '-=0.25');
  }
})();
</script>
