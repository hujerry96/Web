---
// root / → 導向 /zh 或 /en（專案頁需含 base 前綴，來自 consts.BASE）
import { BASE } from '../consts';

const accept = Astro.request?.headers?.get('accept-language') ?? '';
const prefersEn = /^en/i.test(accept.split(',')[0] ?? '');
const target = (BASE.replace(/\/$/, '') + '/' + (prefersEn ? 'en' : 'zh') + '/').replace(/\/{2,}/g, '/');
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>載入中…</title>
  </head>
  <body>
    <p>正在前往 <a href={target}>首頁</a>…</p>
    <script is:inline>
      const base = '{BASE}';
      const nav = (navigator.language || 'zh').toLowerCase().startsWith('en') ? 'en/' : 'zh/';
      const t = (base.replace(/\/$/, '') + '/' + nav).replace(/\/{2,}/g, '/');
      if (location.pathname === base || location.pathname === base.replace(/\/$/, '') || location.pathname === '/') {
        location.replace(t);
      }
    </script>
  </body>
</html>
