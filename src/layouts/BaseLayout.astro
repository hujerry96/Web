---
import '../styles/global.css';
import { SITE } from '../consts';
import { HREFLANG } from '../i18n/config';
import type { Post } from '../lib/content';
import { buildCanonical, buildHreflang, articleLd, breadcrumbLd, websiteLd } from '../lib/seo';
import Meta from '../components/seo/Meta.astro';
import OpenGraph from '../components/seo/OpenGraph.astro';
import TwitterCard from '../components/seo/TwitterCard.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  path: string;
  post?: Post | null;
  type?: 'website' | 'article';
  breadcrumb?: { name: string; url: string }[];
  wide?: boolean;
}

const { title, description, path, post = null, type = post ? 'article' : 'website', breadcrumb, wide = false } = Astro.props;
const locale = (path.startsWith('/en') ? 'en' : 'zh') as keyof typeof HREFLANG;
const t = useTranslations(locale);
const url = `${SITE.url}${path}`;
const canonical = buildCanonical(post, path);
const hreflang = buildHreflang(post, path);
const image = post?.data.cover ? post.data.cover.src : `${SITE.url}/images/og-default.png`;

const jsonLd: Record<string, unknown>[] = [];
if (post) jsonLd.push(articleLd(post, url));
if (breadcrumb && breadcrumb.length > 0) jsonLd.push(breadcrumbLd(breadcrumb, SITE.url));
if (/^\/(en|zh)?$/.test(path)) jsonLd.push(websiteLd());
---
<!doctype html>
<html lang={HREFLANG[locale]}>
  <head>
    <Meta title={title} description={description} canonical={canonical} path={path} hreflang={hreflang}
      published={post?.data.date.toISOString()} modified={post?.data.updated?.toISOString()} />
    <OpenGraph title={title} description={description} url={url} image={image} locale={HREFLANG[locale]} siteName={SITE.name} type={type} />
    <TwitterCard title={title} description={description} image={image} twitter={SITE.twitter} />
    {jsonLd.length > 0 && <JsonLd data={jsonLd} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <script>
      (function() {
        const saved = localStorage.getItem('theme');
        const prefers = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', saved || prefers);
      })();
    </script>
  </head>
  <body>
    <Header path={path} locale={locale} />
    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
    <main class={`mx-auto px-5 ${wide ? 'max-w-6xl' : 'max-w-4xl'}`}>
      <slot />
    </main>
    <Footer locale={locale} />
    <button class="back-to-top" id="back-to-top" aria-label={t('a11y.top')}>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12V4M4 7l4-4 4 4"/></svg>
    </button>
  <script>
    // ── Unified scroll manager ──
    (function() {
      const header = document.getElementById('site-header');
      const btn = document.getElementById('back-to-top');
      const bar = document.getElementById('reading-progress');
      const html = document.documentElement;
      let ticking = false;

      function onScroll() {
        const y = window.scrollY;
        const max = Math.max(html.scrollHeight - html.clientHeight, 1);
        if (header) header.classList.toggle('is-scrolled', y > 20);
        if (btn) btn.classList.toggle('is-visible', y > 400);
        if (bar) bar.style.transform = `scaleX(${Math.min(1, y / max)})`;
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(onScroll); ticking = true; }
      }, { passive: true });
      onScroll();

      // Back to top click
      if (btn) {
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    })();

    // ── Theme toggle ──
    (function() {
      const toggle = document.getElementById('theme-toggle');
      const html = document.documentElement;
      if (!toggle) return;
      const icon = toggle.querySelector('.tt-icon');
      const updateIcon = () => {
        const isDark = html.getAttribute('data-theme') === 'dark';
        if (icon) icon.textContent = isDark ? '☀' : '☾';
      };
      updateIcon();
      toggle.addEventListener('click', () => {
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateIcon();
      });
    })();

    // ── Premium scroll reveal ──
    (function() {
      if (!('IntersectionObserver' in window)) return;
      const selector = '.reveal, .reveal-fade, .reveal-scale, .reveal-slide-left, .reveal-slide-right, .stagger-children';
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -60px 0px' });

      function scan() {
        document.querySelectorAll(selector).forEach((el) => observer.observe(el));
      }
      scan();
      // Re-scan on DOM mutations (dynamic content)
      new MutationObserver(scan).observe(document.body, { childList: true, subtree: true });
    })();
  </script>
  </body>
</html>
