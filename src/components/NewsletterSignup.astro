---
// Email 訂閱表單：送到 Kit（Hu Lab website signup 表單）。
// 用 fetch 送出並在原頁顯示結果；沒有 JavaScript 時改走一般表單送出。
// fields[source]（product | guide | tools）/ fields[lang] 對應 Kit 的自訂欄位，方便之後分眾寄送。
import { withBase, type Locale } from '../consts';

interface Props {
  locale: Locale;
  source: 'product' | 'guide' | 'tools';
}
const { locale, source } = Astro.props;
const zh = locale === 'zh';

const KIT_FORM_ACTION = 'https://app.kit.com/forms/10137880/subscriptions';

const copy = {
  product: {
    label: zh ? '新版本通知' : 'RELEASE NOTES',
    title: zh ? 'Spectra Studio 有新版本時通知我' : 'Tell me when Spectra Studio updates',
    body: zh
      ? '只在推出新版本或重要修正時寄信，一年幾封，不寄廣告。'
      : 'One email when a new version or an important fix ships. A few a year, no ads.',
  },
  tools: {
    label: zh ? '新工具' : 'NEW TOOLS',
    title: zh ? '有新的免費工具時通知我' : 'Hear about new free tools',
    body: zh
      ? '新的計算器、分析軟體或重要更新推出時寄信，大約每月一封。'
      : 'An email when a new calculator, analysis app or major update ships, about once a month.',
  },
  guide: {
    label: zh ? '新教學' : 'NEW GUIDES',
    title: zh ? '新的分析教學，直接寄給你' : 'Get new analysis guides by email',
    body: zh
      ? 'XRD、光譜分析與論文繪圖的新教學發布時寄出，大約每月一封。'
      : 'New XRD, spectroscopy and paper-figure guides when they publish, about once a month.',
  },
}[source];

const t = {
  email: zh ? 'Email' : 'Email',
  placeholder: zh ? '你的 Email' : 'you@university.edu',
  submit: zh ? '訂閱' : 'Subscribe',
  sending: zh ? '送出中…' : 'Sending…',
  success: zh
    ? '快完成了！請到信箱點擊確認連結，才會開始收到信。'
    : 'Almost done — check your inbox and click the confirmation link.',
  invalid: zh ? '這個 Email 看起來不正確，請再檢查一次。' : 'That email address doesn’t look right. Please check it.',
  error: zh ? '送出失敗，請稍後再試。' : 'Something went wrong. Please try again later.',
  consentA: zh ? '隨時可在信中一鍵退訂。詳見' : 'Unsubscribe anytime from any email. See our',
  consentB: zh ? '隱私權政策' : 'privacy policy',
  consentC: zh ? '。' : '.',
};
const id = `newsletter-${source}`;
---
<aside class="newsletter" aria-labelledby={`${id}-title`}>
  <div class="newsletter__copy">
    <span class="newsletter__label">{copy.label}</span>
    <h2 id={`${id}-title`}>{copy.title}</h2>
    <p>{copy.body}</p>
  </div>
  <form
    class="newsletter__form"
    action={KIT_FORM_ACTION}
    method="post"
    data-newsletter
    data-msg-sending={t.sending}
    data-msg-success={t.success}
    data-msg-invalid={t.invalid}
    data-msg-error={t.error}
  >
    <div class="newsletter__row">
      <label class="sr-only" for={`${id}-email`}>{t.email}</label>
      <input id={`${id}-email`} type="email" name="email_address" required autocomplete="email" inputmode="email" placeholder={t.placeholder} />
      <button type="submit">{t.submit}</button>
    </div>
    <input type="hidden" name="fields[source]" value={source} />
    <input type="hidden" name="fields[lang]" value={locale} />
    <!-- 防機器人：真人看不到也不會填 -->
    <div class="newsletter__trap" aria-hidden="true">
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <p class="newsletter__status" role="status" aria-live="polite"></p>
    <p class="newsletter__consent">
      {t.consentA} <a href={withBase('/privacy.md')} target="_blank" rel="noopener noreferrer">{t.consentB}</a>{t.consentC}
    </p>
  </form>
</aside>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.newsletter__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const input = form.querySelector<HTMLInputElement>('input[name="email_address"]')!;
    const trap = form.querySelector<HTMLInputElement>('input[name="website"]')!;
    const msg = form.dataset;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (trap.value) return;
      const body = new FormData(form);
      body.delete('website');
      button.disabled = true;
      status.dataset.state = 'pending';
      status.textContent = msg.msgSending ?? '';
      try {
        const res = await fetch(form.action, { method: 'POST', body, headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.status === 'success') {
          status.dataset.state = 'success';
          status.textContent = msg.msgSuccess ?? '';
          form.reset();
          input.blur();
        } else {
          const invalid = JSON.stringify(data.errors ?? '').includes('email');
          status.dataset.state = 'error';
          status.textContent = (invalid ? msg.msgInvalid : msg.msgError) ?? '';
          button.disabled = false;
        }
      } catch {
        status.dataset.state = 'error';
        status.textContent = msg.msgError ?? '';
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .newsletter { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 1.8rem; align-items: center; margin: 2.5rem 0; padding: 1.75rem; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface); text-align: left; }
  .newsletter__label { font-size: .62rem; font-weight: 600; letter-spacing: .1em; color: var(--color-accent); }
  h2 { font-size: 1.15rem; margin: .7rem 0 .5rem; line-height: 1.5; }
  .newsletter__copy p { color: var(--color-text-secondary); font-size: .84rem; line-height: 1.8; margin: 0; }
  .newsletter__row { display: flex; gap: .5rem; }
  input[type='email'] { flex: 1; min-width: 0; min-height: 2.75rem; padding: .6rem .85rem; border: 1px solid var(--color-border); border-radius: 7px; background: var(--color-bg); color: var(--color-text); font: inherit; font-size: .85rem; }
  input[type='email']::placeholder { color: var(--color-text-tertiary); }
  input[type='email']:focus-visible { outline: 3px solid var(--color-accent-glow); border-color: var(--color-accent); }
  button { flex-shrink: 0; min-height: 2.75rem; padding: .6rem 1.1rem; border: 0; border-radius: 7px; background: var(--color-accent); color: var(--color-on-accent); font: inherit; font-size: .8rem; font-weight: 600; cursor: pointer; }
  button:hover { background: var(--color-accent-dim); }
  button:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  button:disabled { opacity: .6; cursor: default; }
  .newsletter__status { min-height: 1.2em; margin: .6rem 0 0; font-size: .78rem; line-height: 1.6; color: var(--color-text-secondary); }
  .newsletter__status[data-state='success'] { color: var(--color-accent); font-weight: 600; }
  .newsletter__status[data-state='error'] { color: var(--color-text); font-weight: 600; }
  .newsletter__status:empty { display: none; }
  .newsletter__consent { margin: .6rem 0 0; font-size: .7rem; line-height: 1.6; color: var(--color-text-tertiary); }
  .newsletter__consent a { color: inherit; text-decoration: underline; }
  .newsletter__trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (max-width: 760px) {
    .newsletter { grid-template-columns: 1fr; gap: 1.1rem; padding: 1.4rem; }
    .newsletter__row { flex-direction: column; }
  }
</style>
