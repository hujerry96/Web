---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const path = `/${locale}/free-resources`;
const cats = SITE.categories[locale] as Record<string, string>;
const freeOverrides: Record<string, Record<string, string>> = {
  zh: { reviews: '工具', guides: '指南' },
  en: { reviews: 'Tools', guides: 'Guides' },
};
const freeKeys = ['guides'];
const toolsPath = withBase(`/${locale}/tools`);
const freeCats = Object.fromEntries(
  Object.entries(cats)
    .filter(([k]) => freeKeys.includes(k))
    .map(([k, v]) => [k, freeOverrides[k] ?? v])
);
---
<BaseLayout title={`${t('nav.free')} | ${SITE.name}`} description={t('page.freeDescTitle', { name: SITE.name })} path={path}>
  <section class="py-8 max-w-3xl mx-auto">
    <Breadcrumb locale={locale} items={[{ name: t('nav.free'), url: path }]} />
    <h1 class="text-[clamp(2rem,1rem+3vw,2.8rem)] font-display font-semibold mb-4 reveal">{t('nav.free')}</h1>
    <article class="prose mb-8 reveal reveal-delay-1">
      <p>{t('page.freeDesc')}</p>
    </article>

    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,240px),1fr))] gap-4 reveal reveal-delay-2">
      {Object.entries(freeCats).map(([key, name]) => (
        <a class="resource-card" href={`/${locale}/${key}`}>
          <span>{name}</span>
          <span class="text-[var(--color-accent)] opacity-0 transition-opacity duration-200 group-hover:opacity-100" aria-hidden="true">→</span>
        </a>
      ))}
      <a class="resource-card" href={toolsPath}>
        <span>{t('nav.tools')}</span>
        <span class="text-[var(--color-accent)] opacity-0 transition-opacity duration-200 group-hover:opacity-100" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .resource-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    font-size: 1.05rem;
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 300ms var(--ease-out), transform 300ms var(--ease-out-expo), box-shadow 300ms var(--ease-out);
  }
  .resource-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px) scale(1.01);
    box-shadow: 0 8px 24px -6px var(--color-accent-glow);
  }
  .resource-card:active {
    transform: scale(0.98);
  }
  .resource-card:hover span:last-child {
    opacity: 1;
  }
</style>
