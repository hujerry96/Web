---
import '../styles/global.css';
import { SITE } from '../consts';
import { HREFLANG } from '../i18n/config';
import type { Post } from '../lib/content';
import { buildCanonical, buildHreflang, articleLd, breadcrumbLd, websiteLd } from '../lib/seo';
import { getContentZone } from '../lib/content';
import Meta from '../components/seo/Meta.astro';
import OpenGraph from '../components/seo/OpenGraph.astro';
import TwitterCard from '../components/seo/TwitterCard.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  path: string;
  post?: Post | null;
  type?: 'website' | 'article';
  breadcrumb?: { name: string; url: string }[];
  wide?: boolean;
}

const { title, description, path, post = null, type = post ? 'article' : 'website', breadcrumb, wide = false } = Astro.props;
const locale = (path.startsWith('/en') ? 'en' : 'zh') as keyof typeof HREFLANG;
const pathParts = path.split('/').filter(Boolean);
const category = pathParts.length >= 2 ? pathParts[1] : '';
const zone = category ? getContentZone(category, post?.data?.brand) : 'lab';
const t = useTranslations(locale);
const url = `${SITE.url}${path}`;
const canonical = buildCanonical(post, path);
const hreflang = buildHreflang(post, path);
const image = post?.data.cover ? post.data.cover.src : `${SITE.url}/images/og-default.png`;

const jsonLd: Record<string, unknown>[] = [];
if (post) jsonLd.push(articleLd(post, url));
if (breadcrumb && breadcrumb.length > 0) jsonLd.push(breadcrumbLd(breadcrumb, SITE.url));
if (/^\/(en|zh)?$/.test(path)) jsonLd.push(websiteLd());
---
<!doctype html>
<html lang={HREFLANG[locale]}>
  <head>
    <Meta title={title} description={description} canonical={canonical} path={path} hreflang={hreflang}
      published={post?.data.date.toISOString()} modified={post?.data.updated?.toISOString()} />
    <OpenGraph title={title} description={description} url={url} image={image} locale={HREFLANG[locale]} siteName={SITE.name} type={type} />
    <TwitterCard title={title} description={description} image={image} twitter={SITE.twitter} />
    {jsonLd.length > 0 && <JsonLd data={jsonLd} />}
    <!-- Terminal direction: JetBrains Mono + Noto Sans TC + Inter (Select body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700&family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700&family=Inter:wght@400;500;600&display=swap" />
    <script>
      (function() {
        const saved = localStorage.getItem('theme');
        const prefers = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', saved || prefers);
      })();
    </script>
  </head>
  <body data-zone={zone}>
    <Header path={path} locale={locale} zone={zone} />
    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
    <main class={`container${wide ? ' wide' : ''}`}>
      <slot />
    </main>
    <Footer locale={locale} />
    <span class="back-to-top" id="back-to-top">↑ <span class="max-sm:hidden">back</span></span>
  <script>
    const btn = document.getElementById('back-to-top');
    if (btn) {
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            btn.classList.toggle('is-visible', window.scrollY > 300);
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    const toggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    if (toggle) {
      const icon = toggle.querySelector('.tt-icon');
      const updateIcon = () => {
        const isDark = html.getAttribute('data-theme') === 'dark';
        if (icon) icon.textContent = isDark ? '☀' : '☾';
      };
      updateIcon();
      toggle.addEventListener('click', () => {
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateIcon();
      });
    }

    const bar = document.getElementById('reading-progress');
    if (bar) {
      let ticking = false;
      const update = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        const p = max > 0 ? Math.min(1, h.scrollTop / max) : 0;
        bar.style.transform = `scaleX(${p})`;
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(update); ticking = true; }
      }, { passive: true });
      update();
    }
  </script>
  </body>
</html>
