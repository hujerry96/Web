---
import { SITE, withBase } from '../consts';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import LangSwitch from './LangSwitch.astro';

interface Props { path: string; locale: Locale; }
const { path, locale } = Astro.props;
const t = useTranslations(locale);

const allCats = SITE.categories[locale] as Record<string, string>;
const catNav = Object.keys(allCats).map((key) => ({ href: `/${locale}/${key}`, key: `nav.${key}` as Parameters<typeof t>[0] }));
const staticLinks: { href: string; key: Parameters<typeof t>[0] }[] = [
  { href: `/${locale}/free-resources`, key: 'nav.free' },
  { href: `/${locale}/about`, key: 'nav.about' },
  { href: `/${locale}/contact`, key: 'nav.contact' },
];
---
<header class="site-header" id="site-header">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 h-16">
    <a href={withBase(`/${locale}`)} class="flex items-center gap-2 no-underline group">
      <span class="font-display font-semibold text-[var(--color-text)] text-lg tracking-tight">{SITE.name}</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="primary">
      {catNav.map((item) => (
        <a href={withBase(item.href)} class="nav-link">{t(item.key)}</a>
      ))}
      <span class="w-px h-4 bg-[var(--color-border)] mx-1"></span>
      {staticLinks.map((item) => (
        <a href={withBase(item.href)} class="nav-link">{t(item.key)}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a class="icon-btn" href={withBase(`/${locale}/search`)} aria-label={t('nav.search')} title={t('nav.search')}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="6.5" cy="6.5" r="4.5"/><path d="M10 10l4 4"/></svg>
      </a>
      <button class="icon-btn" id="theme-toggle" aria-label={t('a11y.theme')} title={t('a11y.theme')}>
        <span class="tt-icon" aria-hidden="true">☾</span>
      </button>
      <div class="hidden sm:block">
        <LangSwitch path={path} locale={locale} />
      </div>

      <!-- Mobile menu button -->
      <button class="icon-btn md:hidden" id="mobile-menu-btn" aria-label="Menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3 5h12M3 9h12M3 13h12"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav class="mobile-nav md:hidden" id="mobile-nav" aria-label="mobile">
    <div class="flex flex-col gap-1 px-5 pb-4">
      {catNav.map((item) => (
        <a href={withBase(item.href)} class="mobile-nav-link">{t(item.key)}</a>
      ))}
      <div class="h-px bg-[var(--color-border-subtle)] my-1"></div>
      {staticLinks.map((item) => (
        <a href={withBase(item.href)} class="mobile-nav-link">{t(item.key)}</a>
      ))}
      <div class="h-px bg-[var(--color-border-subtle)] my-1"></div>
      <div class="py-1">
        <LangSwitch path={path} locale={locale} />
      </div>
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');
  if (menuBtn && mobileNav) {
    menuBtn.addEventListener('click', () => {
      const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!expanded));
      mobileNav.classList.toggle('is-open');
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border-subtle);
    background: transparent;
    transition: background 300ms var(--ease), border-color 300ms var(--ease), backdrop-filter 300ms var(--ease);
  }
  .site-header.is-scrolled {
    background: var(--color-surface-overlay);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.65rem;
    font-size: 0.875rem;
    font-family: var(--font-body);
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: 6px;
    transition: color 200ms var(--ease), background 200ms var(--ease);
  }
  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-accent-muted);
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.9rem;
    transition: all 200ms var(--ease);
  }
  .icon-btn:hover {
    color: var(--color-text);
    border-color: var(--color-border-hover);
    background: var(--color-surface-raised);
  }

  .mobile-nav {
    display: none;
    border-top: 1px solid var(--color-border-subtle);
    background: var(--color-surface);
  }
  .mobile-nav.is-open {
    display: block;
  }
  .mobile-nav-link {
    display: block;
    padding: 0.5rem 0;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 200ms var(--ease);
  }
  .mobile-nav-link:hover {
    color: var(--color-text);
  }
</style>
