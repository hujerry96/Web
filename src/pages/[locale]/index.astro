---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, readingTime } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';

export async function getStaticPaths() {
  const all = await getPosts();
  const locales = ['zh', 'en'] as Locale[];
  return locales.map((locale) => {
    const posts = all.filter((p) => p.id.startsWith(`${locale}/`));
    const counts: Record<string, number> = {};
    for (const p of posts) {
      const cat = p.id.split('/')[1];
      counts[cat] = (counts[cat] ?? 0) + 1;
    }
    return { params: { locale }, props: { posts, counts } };
  });
}

const { locale } = Astro.params as { locale: Locale };
const { posts, counts } = Astro.props as { posts: any[]; counts: Record<string, number> };
const t = useTranslations(locale);
const cats = SITE.categories[locale] as Record<string, string>;
const path = `/${locale}`;

const featured = posts[0];
const rest = posts.slice(1, 10);
const featuredCat = featured ? (featured.id.split('/')[1] as string) : '';
const featuredCatName = featured ? ((SITE.categories[locale] as Record<string, string>)[featuredCat] ?? featuredCat) : '';
---
<BaseLayout title={SITE.meta[locale].title} description={SITE.meta[locale].description} path={path} post={featured} breadcrumb={[]} wide>
  <!-- 雜誌刊頭 -->
  <section class="masthead">
    <span class="kicker" data-hero>{t('home.tagline')}</span>
    <h1 class="masthead-title" data-hero>{SITE.name}</h1>
    <p class="masthead-sub muted serif-body" data-hero>{t('home.intro')}</p>
  </section>

  <!-- 精選大卡 -->
  {featured && (
    <a class="featured print-frame reveal" href={withBase(`/${locale}/${featuredCat}/${featured.data.slug ?? featured.id.split('/').slice(2).join('/')}`)}>
      <div class="featured-media">
        {featured.data.cover
          ? <img src={withBase(featured.data.cover)} alt={featured.data.title} width={800} height={500} class="featured-cover" loading="eager" />
          : <div class="featured-cover featured-cover--empty"><span>{featuredCatName}</span></div>}
      </div>
      <div class="featured-body">
        <span class="cat">{featuredCatName}</span>
        <h2 class="serif-display">{featured.data.title}</h2>
        <p class="serif-body muted">{featured.data.description}</p>
        <div class="featured-meta">
          <span>{featured.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</span>
          <i>·</i>
          <span>{readingTime(featured.body, locale)}</span>
        </div>
      </div>
    </a>
  )}

  <!-- 分類入口（收斂為細導覽，不再重複大卡） -->
  <nav class="cat-strip reveal" aria-label="categories">
    {Object.entries(cats).map(([key, name]) => (
      <a class="cat-pill" href={withBase(`/${locale}/${key}`)}>
        {name}<span class="cat-count">{counts[key] ?? 0}</span>
      </a>
    ))}
  </nav>

  <div class="rule-line section-rule reveal"><span>✦</span></div>
  <h2 class="section-title serif-display reveal">{t('home.latest')}</h2>
  <div class="grid">
    {rest.map((post) => (
      <div class="stagger-card">
        <ArticleCard post={post} locale={locale} />
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  /* ── 刊頭 ── */
  .masthead {
    padding: clamp(3rem, 6vw, 5.5rem) 0 clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
  }
  .masthead-title {
    font-family: var(--font-serif-display);
    font-size: var(--text-5xl);
    font-weight: 500;
    margin: 0.6rem 0 0;
    letter-spacing: -0.02em;
    line-height: 1.02;
  }
  .masthead-sub {
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.2rem);
    max-width: 36rem;
    margin: 1.4rem auto 0;
  }

  /* ── 精選大卡 ── */
  .featured {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    margin: 1.5rem 0 2.5rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-md);
    transition: border-color var(--duration-fast) var(--ease), box-shadow var(--duration-fast) var(--ease), transform var(--duration-fast) var(--ease);
  }
  .featured:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }
  .featured-media { position: relative; min-height: 320px; }
  .featured-cover { width: 100%; height: 100%; object-fit: cover; }
  .featured-cover--empty {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background:
      repeating-linear-gradient(45deg, transparent, transparent 12px, rgba(156,59,46,0.05) 12px, rgba(156,59,46,0.05) 13px),
      linear-gradient(135deg, var(--color-accent-soft), var(--color-surface));
    color: var(--color-accent-deep);
    font-family: var(--font-serif-display);
    font-weight: 500;
    font-size: 1.3rem;
    letter-spacing: 0.06em;
  }
  .featured-body { padding: clamp(1.5rem, 3vw, 2.5rem); display: flex; flex-direction: column; justify-content: center; }
  .featured .cat {
    font-family: var(--font-serif-body);
    font-size: 0.72rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 3px;
    align-self: flex-start;
  }
  .featured h2 {
    font-size: clamp(1.2rem, 0.9rem + 1.2vw, 1.6rem);
    font-weight: 500;
    margin: 1rem 0 0.8rem;
    line-height: 1.18;
  }
  .featured .muted { margin: 0 0 1.2rem; }
  .featured-meta {
    display: flex; gap: 0.6rem; align-items: center;
    font-family: var(--font-serif-body);
    font-size: 0.78rem;
    color: var(--color-text-faint);
    letter-spacing: 0.03em;
  }
  .featured-meta i { color: var(--color-accent); font-style: normal; }

  /* ── 分類細導覽 ── */
  .cat-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin: 0.5rem 0 1rem;
  }
  .cat-pill {
    font-family: var(--font-serif-body);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.4rem 1rem;
    transition: border-color var(--duration-fast) var(--ease), color var(--duration-fast) var(--ease), background var(--duration-fast) var(--ease);
  }
  .cat-pill:hover { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-accent-soft); }
  .cat-count {
    font-size: 0.7rem;
    color: var(--color-text-faint);
    margin-left: 0.4rem;
  }

  .section-rule { max-width: 22rem; margin-left: auto; margin-right: auto; }
  .section-title {
    text-align: center;
    font-family: var(--font-serif-display);
    font-size: clamp(1.8rem, 1rem + 3vw, 2.4rem);
    font-weight: 500;
    margin: var(--space-4) 0 var(--space-6);
  }

  @media (max-width: 760px) {
    .featured { grid-template-columns: 1fr; }
    .featured-media { min-height: 200px; }
  }
</style>
