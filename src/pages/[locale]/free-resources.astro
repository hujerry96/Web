---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const path = `/${locale}/free-resources`;
const cats = SITE.categories[locale] as Record<string, string>;
const freeOverrides: Record<string, Record<string, string>> = {
  zh: { reviews: '工具', guides: '指南' },
  en: { reviews: 'Tools', guides: 'Guides' },
};
const freeKeys = ['guides'];
const toolsPath = withBase(`/${locale}/tools`);
const freeCats = Object.fromEntries(
  Object.entries(cats)
    .filter(([k]) => freeKeys.includes(k))
    .map(([k, v]) => [k, freeOverrides[k] ?? v])
);
---
<BaseLayout title={`${t('nav.free')} | ${SITE.name}`} description={t('page.freeDescTitle', { name: SITE.name })} path={path}>
  <Breadcrumb locale={locale} items={[{ name: t('nav.free'), url: path }]} />
  <h1 class="text-[clamp(1.8rem,1rem+3vw,2.6rem)] m-0 mb-4">{t('nav.free')}</h1>
  <article class="prose">
    <p>{t('page.freeDesc')}</p>
  </article>

  <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,220px),1fr))] gap-4 my-8">
    {Object.entries(freeCats).map(([key, name]) => (
      <a class="relative flex items-center justify-between no-underline p-5 border border-border rounded-[10px] bg-lab-surface font-serif text-[1.2rem] font-medium text-lab-text transition-all duration-150 hover:border-lab-accent hover:shadow-md hover:-translate-y-0.5 group" href={`/${locale}/${key}`}>
        <span>{name}</span>
        <span class="text-lab-accent opacity-0 -translate-x-1 transition-all duration-150 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true">→</span>
      </a>
    ))}
    <a class="relative flex items-center justify-between no-underline p-5 border border-border rounded-[10px] bg-lab-surface font-serif text-[1.2rem] font-medium text-lab-text transition-all duration-150 hover:border-lab-accent hover:shadow-md hover:-translate-y-0.5 group" href={toolsPath}>
      <span>{t('nav.tools')}</span>
      <span class="text-lab-accent opacity-0 -translate-x-1 transition-all duration-150 group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true">→</span>
    </a>
  </div>
</BaseLayout>
