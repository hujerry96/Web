---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, withBase } from '../consts';

const path = '/404';
---
<BaseLayout title={`404 — ${SITE.name}`} description="找不到頁面" path={path}>
  <section class="notfound">
    <span class="kicker">404</span>
    <h1 class="serif-display">這一頁走失了</h1>
    <p class="muted serif-body">你找的頁面可能已經移動或不存在。</p>
    <a class="btn" href={withBase('/zh')}>回到首頁 →</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding: clamp(4rem, 10vw, 8rem) 0;
    max-width: 36rem;
    margin: 0 auto;
  }
  .notfound h1 {
    font-size: clamp(2rem, 1rem + 4vw, 3.5rem);
    font-weight: 500;
    margin: 1rem 0 1rem;
  }
  .btn {
    display: inline-block;
    margin-top: 1.5rem;
    background: var(--color-accent);
    color: #fbf8f1;
    text-decoration: none;
    font-family: var(--font-serif-body);
    font-weight: 500;
    font-size: 0.98rem;
    letter-spacing: 0.04em;
    padding: 0.7rem 1.8rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-accent-deep);
    transition: background 0.18s var(--ease), transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .btn:hover {
    background: var(--color-accent-deep);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
</style>
