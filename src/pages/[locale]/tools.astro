---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const path = `/${locale}/tools`;

const tools = [
  {
    name: locale === 'zh' ? 'SEM 粒徑分析工具' : 'SEM Particle Analyzer',
    tag: 'Particle Analyzer',
    desc:
      locale === 'zh'
        ? '從 SEM 影像自動量測顆粒與孔洞的粒徑分布，支援 Watershed 與 Hough 圓形偵測雙演算法，可直接校正比例尺並匯出統計報表。'
        : 'Measure particle and pore size distributions from SEM images automatically. Two algorithms (Watershed and Hough Circle), interactive scale calibration, and exportable statistics.',
    points:
      locale === 'zh'
        ? ['Watershed 分割重疊顆粒', 'Hough 圓形偵測圓形顆粒', '互動校正 SEM 比例尺', '匯出 CSV / 統計 / 分布圖']
        : ['Watershed for overlapping particles', 'Hough Circle for round particles', 'Interactive SEM scale-bar calibration', 'Export CSV / stats / distribution plot'],
    repo: 'https://github.com/hujerry96/particle-analyzer',
    lang: locale === 'zh' ? '中文 / English' : '中文 / English',
    guide: locale === 'zh' ? '/zh/guides/particle-analyzer-guide' : '/en/guides/particle-analyzer-guide-en',
  },
  {
    name: locale === 'zh' ? '論文格式修正工具' : 'Thesis Format Fixer',
    tag: 'Thesis Formatter',
    desc:
      locale === 'zh'
        ? '一鍵修正 Word 碩博士論文格式：頁碼、圖表編號、標題階層、參考文獻與封面，規則以 YAML 設定，GUI 拖檔即用。'
        : 'One-click fix for Word thesis formatting: page numbers, figure/table numbering, heading levels, references, and cover. Rules live in YAML, and the GUI takes a drag-and-drop file.',
    points:
      locale === 'zh'
        ? ['頁碼羅馬/阿拉伯自動切換', '圖表編號與標題統一', '標題階層與縮排修正', '參考文獻交叉參照']
        : ['Auto Roman/Arabic page numbers', 'Unified figure & table numbering', 'Heading levels and indents', 'Reference cross-references'],
    repo: 'https://github.com/hujerry96/thesis-formatter',
    lang: locale === 'zh' ? '中文 / English' : '中文 / English',
    guide: locale === 'zh' ? '/zh/guides/thesis-formatter-guide' : '/en/guides/thesis-formatter-guide-en',
  },
];
---
<BaseLayout title={`${t('nav.tools')} | ${SITE.name}`} description={t('page.toolsDesc', { name: SITE.name })} path={path}>
  <Breadcrumb locale={locale} items={[{ name: t('nav.tools'), url: path }]} />
  <h1 class="text-[clamp(1.8rem,1rem+3vw,2.6rem)] m-0 mb-4">{t('nav.tools')}</h1>
  <article class="prose">
    <p>{t('page.toolsDesc')}</p>
  </article>

  <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,340px),1fr))] gap-6 my-8">
    {tools.map((tool) => (
      <section class="border border-border rounded-[10px] bg-lab-surface overflow-hidden shadow-sm transition-all duration-150 hover:border-lab-accent hover:shadow-md hover:-translate-y-0.5">
        <div class="h-[150px] flex items-center justify-center bg-gradient-to-br from-lab-accent-soft to-lab-surface text-lab-accent-deep font-serif font-medium text-lg tracking-wide">
          <span>{tool.tag}</span>
        </div>
        <div class="p-5">
          <h2 class="text-[1.35rem] m-0 mb-2.5">{tool.name}</h2>
          <p class="text-lab-text-muted m-0 mb-3.5">{tool.desc}</p>
          <ul class="list-none p-0 m-0 mb-4 grid gap-1.5">
            {tool.points.map((p) => (
              <li class="relative pl-[1.1rem] text-[0.92rem] text-lab-text-secondary before:content-[''] before:absolute before:left-0 before:top-[0.55em] before:w-1.5 before:h-1.5 before:rounded-full before:bg-lab-accent">{p}</li>
            ))}
          </ul>
          <div class="flex items-center justify-between border-t border-border pt-4">
            <span class="font-serif text-[0.78rem] text-lab-text-muted tracking-wide">{tool.lang}</span>
            <span class="flex gap-4 flex-wrap">
              <a class="font-semibold text-lab-accent no-underline hover:underline" href={withBase(tool.guide)}>{locale === 'zh' ? '使用指南 →' : 'Guide →'}</a>
              <a class="font-semibold text-lab-accent no-underline hover:underline" href={tool.repo} target="_blank" rel="noopener">{locale === 'zh' ? 'GitHub →' : 'GitHub →'}</a>
            </span>
          </div>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
