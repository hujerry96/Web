---
import type { Post } from '../lib/content';
import { postPath } from '../lib/content';
import { topicOf } from '../lib/topics';
import { Image } from 'astro:assets';

interface Props { post: Post; locale: 'zh' | 'en'; showImage?: boolean; }
const { post, locale, showImage = true } = Astro.props;
const href = postPath(post);
const cover = post.data.cover;
const topic = topicOf(post);
const date = post.data.updated ?? post.data.date;
---
<article class="article-card group">
  <a href={href} class="article-card__link">
    {showImage && (
      <div class="article-card__image">
        {cover ? (
          <Image src={cover} alt={post.data.title} width={640} height={360} class="w-full h-full object-cover" loading="lazy" />
        ) : (
          <div class="article-card__placeholder graph-paper" aria-hidden="true"><span>{topic.code}</span></div>
        )}
      </div>
    )}
    <div class="article-card__body">
      <span class="article-card__topic">{topic.code}</span>
      <h3 class="article-card__title">{post.data.title}</h3>
      <p class="article-card__desc">{post.data.description}</p>
      <time datetime={date.toISOString()} class="article-card__date">
        {date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
    </div>
  </a>
</article>

<style>
  .article-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 220ms var(--ease), box-shadow 220ms var(--ease), transform 220ms var(--ease);
  }
  .article-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: 0 10px 28px -14px var(--color-accent-glow);
  }
  .article-card__link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .article-card__image { aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .article-card__image :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease); }
  .article-card:hover .article-card__image :global(img) { transform: scale(1.03); }
  .article-card__placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.1em; color: var(--color-accent); }
  .article-card__body { display: flex; flex-direction: column; gap: 0.45rem; flex: 1; padding: 1rem 1.15rem 1.15rem; }
  .article-card__topic { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.1em; color: var(--color-accent); }
  .article-card__title { margin: 0; font-size: 1.02rem; font-weight: 600; line-height: 1.4; color: var(--color-text); transition: color 200ms var(--ease); }
  .article-card:hover .article-card__title { color: var(--color-accent); }
  .article-card__desc { margin: 0; font-size: 0.86rem; line-height: 1.6; color: var(--color-text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .article-card__date { margin-top: auto; padding-top: 0.35rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-text-tertiary); }
</style>
