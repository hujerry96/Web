---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, withBase } from '../consts';

const path = '/404';
const locale = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
const home = withBase(`/${locale}`);
const title = locale === 'zh' ? '這一頁走失了' : 'This page is lost';
const desc = locale === 'zh' ? '你找的頁面可能已經移動或不存在。' : 'The page you are looking for may have moved or no longer exists.';
const btn = locale === 'zh' ? '回到首頁' : 'Back to home';
---
<BaseLayout title={`404 — ${SITE.name}`} description={desc} path={path}>
  <section class="text-center py-[clamp(5rem,12vw,10rem)] max-w-[36rem] mx-auto">
    <span class="inline-block text-[0.75rem] font-medium tracking-[0.15em] uppercase text-[var(--color-accent)] mb-4">404</span>
    <h1 class="text-[clamp(2.2rem,1rem+5vw,3.75rem)] font-display font-semibold mt-0 mb-4">{title}</h1>
    <p class="text-[var(--color-text-secondary)] text-[1.05rem] mb-8">{desc}</p>
    <a class="inline-flex items-center gap-2 bg-[var(--color-accent)] text-white no-underline text-sm font-medium py-2.5 px-6 rounded-lg transition-all duration-300 hover:bg-[var(--color-accent-dim)] hover:shadow-lg hover:shadow-[var(--color-accent-glow)] hover:-translate-y-0.5 active:scale-95" href={home}>{btn} →</a>
  </section>
</BaseLayout>
