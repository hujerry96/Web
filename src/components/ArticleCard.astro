---
import type { Post } from '../lib/content';
import { parseId, postPath, getContentZone } from '../lib/content';
import { SITE } from '../consts';
import { useTranslations } from '../i18n/ui';
import { Image } from 'astro:assets';

interface Props { post: Post; locale: 'zh' | 'en'; }
const { post, locale } = Astro.props;
const t = useTranslations(locale);
const { category } = parseId(post.id);
const zone = getContentZone(category);
const href = postPath(post);
const cover = post.data.cover;
const catName = (SITE.categories[locale] as Record<string, string>)[category] ?? category;
const isSelect = zone === 'select';
---
<article class:list={['card', isSelect && 'card-select']}>
  <a href={href} class="card-link">
    {cover ? (
      <Image src={cover} alt={post.data.title} width={640} height={360} class="thumb" loading="lazy" />
    ) : (
      <div class="thumb thumb-empty"><span>{catName}</span></div>
    )}
  <div class="card-body">
    <span class="cat">{catName}{isSelect && <span class="badge">{t('nav.select')}</span>}</span>
    <h3 class="title serif-display">{post.data.title}</h3>
    <p class="desc serif-body">{post.data.description}</p>
    <time datetime={post.data.date.toISOString()}>
      {post.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}
    </time>
  </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
    height: 100%;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lg);
  }
  .card-link { color: inherit; text-decoration: none; display: block; }
  .thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .thumb-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      repeating-linear-gradient(45deg, transparent, transparent 12px, rgba(156,59,46,0.05) 12px, rgba(156,59,46,0.05) 13px),
      linear-gradient(135deg, var(--color-accent-soft), var(--color-surface));
    color: var(--color-accent-deep);
    font-family: var(--font-serif-display);
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }
  .card-body {
    padding: 1.1rem 1.15rem 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .cat {
    font-family: var(--font-serif-body);
    font-size: 0.72rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--color-accent);
  }
  .title { font-size: 1.15rem; margin: 0.6rem 0 0.45rem; line-height: 1.35; font-weight: 500; }
  .desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0 0 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  time {
    font-family: var(--font-serif-body);
    font-size: 0.76rem;
    color: var(--color-text-faint);
    letter-spacing: 0.03em;
  }
  .badge {
    display: inline-block;
    margin-left: 6px;
    padding: 0 6px;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft, #f0b8a0);
    color: var(--color-accent-deep, #8b3a20);
    vertical-align: middle;
    line-height: 1.5;
  }
  .card-select { border-color: var(--color-accent-soft, #f0b8a0); }
  .card-select .cat { color: var(--color-accent-deep, #8b3a20); border-bottom-color: var(--color-accent-soft); }
</style>
