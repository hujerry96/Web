---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, readingTime } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const all = await getPosts();
  const locales = ['zh', 'en'] as Locale[];
  return locales.map((locale) => {
    const posts = all.filter((p) => p.id.startsWith(`${locale}/`) && p.data.brand !== 'select');
    return { params: { locale }, props: { posts } };
  });
}

const { locale } = Astro.params as { locale: Locale };
const { posts } = Astro.props as { posts: any[] };
const t = useTranslations(locale);
const cats = SITE.categories[locale] as Record<string, string>;
const path = `/${locale}`;

const featured = posts[0];
const rest = posts.slice(1, 10);
const featuredCat = featured ? (featured.id.split('/')[1] as string) : '';
const featuredCatName = featured ? ((SITE.categories[locale] as Record<string, string>)[featuredCat] ?? featuredCat) : '';
const catCounts: Record<string, number> = {};
for (const p of posts) { const c = p.id.split('/')[1]; catCounts[c] = (catCounts[c] ?? 0) + 1; }
---
<BaseLayout title={SITE.meta[locale].title} description={SITE.meta[locale].description} path={path} post={featured} breadcrumb={[]} wide>
  <section class="py-[clamp(2rem,4vw,4rem)]">
    <header class="mb-6">
      <span class="text-[0.75rem] tracking-[0.15em] uppercase text-[var(--color-term-accent)] opacity-70">{t('home.tagline')}</span>
      <h1 class="text-[clamp(1.8rem,1rem+4vw,2.8rem)] tracking-tight leading-[1.1] mt-1 mb-0 text-[var(--color-term-text)]">{SITE.name}</h1>
      <p class="term-prompt text-sm mt-3 mb-0 max-w-[42rem]">{t('home.intro')}</p>
    </header>

    <nav class="flex flex-wrap gap-1.5 mt-8 mb-6 text-sm" aria-label="categories">
      <span class="text-[var(--color-term-text-muted)] opacity-60">$ ls /</span>
      {Object.entries(cats).map(([key, name]) => {
        const isSel = key === 'select';
        return (<a class={`no-underline px-2 py-0.5 border border-[var(--color-border)] text-sm ${isSel ? 'text-[var(--color-sel-accent)] border-[var(--color-sel-accent-bg)]' : 'text-[var(--color-term-text-muted)] hover:text-[var(--color-term-accent)] hover:border-[var(--color-term-accent)]'}`} href={withBase(`/${locale}/${key}`)}>
          {name} <span class="opacity-50">{catCounts[key] ?? 0}</span>
        </a>);
      })}
    </nav>
  </section>

  {featured && (
    <section class="mb-8">
      <span class="text-[0.75rem] tracking-[0.1em] uppercase text-[var(--color-term-text-muted)] mb-2 block border-t border-[var(--color-border)] pt-4">featured</span>
      <a class="grid grid-cols-[1.25fr_1fr] border border-[var(--color-border)] text-inherit no-underline hover:border-[var(--color-term-accent)] transition-colors duration-150 max-sm:!grid-cols-1" href={withBase(`/${locale}/${featuredCat}/${featured.data.slug ?? featured.id.split('/').slice(2).join('/')}`)}>
        <div class="relative min-h-[260px] max-sm:min-h-[180px]">
          {featured.data.cover
            ? <Image src={featured.data.cover} alt={featured.data.title} width={800} height={500} class="w-full h-full object-cover" loading="eager" />
            : <div class="w-full h-full flex items-center justify-center bg-[var(--color-term-accent-bg)] text-[var(--color-term-accent-dim)] text-sm tracking-wide"><span>{featuredCatName}</span></div>}
        </div>
        <div class="p-[clamp(1.25rem,2.5vw,2rem)] flex flex-col justify-center border-l border-[var(--color-border)] max-sm:border-l-0">
          <span class="text-[0.72rem] text-[var(--color-term-accent)] uppercase tracking-[0.12em]">{featuredCatName}</span>
          <h2 class="text-[clamp(1rem,0.8rem+0.8vw,1.2rem)] font-medium mt-3 mb-2 leading-snug">{featured.data.title}</h2>
          <p class="text-[var(--color-term-text-muted)] text-[0.82rem] mb-2">{featured.data.description}</p>
          <div class="flex gap-2.5 items-center text-[0.78rem] text-[var(--color-term-text-muted)]">
            <span>{featured.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</span>
            <span>·</span>
            <span>{readingTime(featured.body, locale)}</span>
          </div>
        </div>
      </a>
    </section>
  )}

  <section class="my-8">
    <span class="text-[0.75rem] tracking-[0.1em] uppercase text-[var(--color-term-text-muted)] mb-3 block border-t border-[var(--color-border)] pt-4">latest</span>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,280px),1fr))] gap-px bg-[var(--color-border)]">
      {rest.map((post) => (
        <ArticleCard post={post} locale={locale} />
      ))}
    </div>
  </section>

  <div class="term-cursor text-[var(--color-term-accent)] text-sm mt-8 mb-12"> </div>
</BaseLayout>
