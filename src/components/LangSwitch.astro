---
import type { Locale } from '../i18n/config';
import { LOCALE_NAMES, LOCALES } from '../i18n/config';
import { withBase } from '../consts';

interface Props { path: string; locale: Locale; }
const { path, locale } = Astro.props;

// 把當前路徑的語系段替換為目標語系，產生跨語系同頁連結
function switchPath(target: Locale): string {
  const parts = path.split('/');
  if (parts[1] === 'zh' || parts[1] === 'en') parts[1] = target;
  else parts.splice(1, 0, target);
  const raw = parts.join('/') || `/${target}`;
  return withBase(raw);
}
const others = LOCALES.filter((l) => l !== locale);
---
<div class="lang-switch" role="group" aria-label="language">
  <span class="current" aria-current="true">{LOCALE_NAMES[locale]}</span>
  {others.map((l) => (
    <a class="opt" href={switchPath(l)} hreflang={l === 'en' ? 'en-US' : 'zh-TW'}>{LOCALE_NAMES[l]}</a>
  ))}
</div>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-family: var(--font-serif-body);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .current {
    color: var(--color-surface);
    background: var(--color-accent);
    font-weight: 600;
    padding: 0.22rem 0.7rem;
    border-radius: var(--radius-full);
    line-height: 1.2;
  }
  .opt {
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.22rem 0.7rem;
    border-radius: var(--radius-full);
    line-height: 1.2;
    transition: color var(--duration-fast) var(--ease), background var(--duration-fast) var(--ease);
  }
  .opt:hover { color: var(--color-text); background: var(--color-accent-soft); }
</style>
