---
import type { Post } from '../lib/content';
import { parseId, postPath } from '../lib/content';
import { SITE } from '../consts';

interface Props { post: Post; locale: 'zh' | 'en'; }
const { post, locale } = Astro.props;
const { category } = parseId(post.id);
const href = postPath(post);
const coverSrc = post.data.cover;
const catName = (SITE.categories[locale] as Record<string, string>)[category] ?? category;
---
<article class="card">
  <a href={href} class="card-link">
    {coverSrc ? (
      <img src={coverSrc} alt={post.data.title} width={640} height={360} class="thumb" loading="lazy" />
    ) : (
      <div class="thumb thumb-empty"><span>{catName}</span></div>
    )}
  <div class="card-body">
    <span class="cat">{catName}</span>
    <h3 class="title serif-display">{post.data.title}</h3>
    <p class="desc serif-body">{post.data.description}</p>
    <time datetime={post.data.date.toISOString()}>
      {post.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}
    </time>
  </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
    height: 100%;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lg);
  }
  .card-link { color: inherit; text-decoration: none; display: block; }
  .thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .thumb-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      repeating-linear-gradient(45deg, transparent, transparent 12px, rgba(156,59,46,0.05) 12px, rgba(156,59,46,0.05) 13px),
      linear-gradient(135deg, var(--color-accent-soft), var(--color-surface));
    color: var(--color-accent-deep);
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }
  .card-body {
    padding: 1.1rem 1.15rem 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .cat {
    font-family: var(--font-serif-body);
    font-size: 0.72rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--color-accent);
  }
  .title { font-size: 1.15rem; margin: 0.6rem 0 0.45rem; line-height: 1.35; font-weight: 700; }
  .desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0 0 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  time {
    font-family: var(--font-serif-body);
    font-size: 0.76rem;
    color: var(--color-text-faint);
    letter-spacing: 0.03em;
  }
</style>

<script>
  // 文章卡 3D 傾斜（依游標位置）。尊重 reduced-motion；無 GSAP 時跳過。
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const cards = document.querySelectorAll('.card');
    const supportsGsap = typeof gsap !== 'undefined';
    cards.forEach((card) => {
      card.style.transformStyle = 'preserve-3d';
      card.addEventListener('mousemove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        const rx = (-py * 6).toFixed(2);
        const ry = (px * 8).toFixed(2);
        if (supportsGsap) {
          gsap.to(card, { rotateX: rx, rotateY: ry, duration: 0.3, ease: 'power2.out', transformPerspective: 800 });
        } else {
          card.style.transform = `perspective(800px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        }
      });
      card.addEventListener('mouseleave', () => {
        if (supportsGsap) gsap.to(card, { rotateX: 0, rotateY: 0, duration: 0.5, ease: 'power2.out' });
        else card.style.transform = '';
      });
    });
  })();
</script>
