---
import type { Post } from '../lib/content';
import { parseId, postPath, getContentZone } from '../lib/content';
import { SITE } from '../consts';
import { useTranslations } from '../i18n/ui';
import { Image } from 'astro:assets';

interface Props { post: Post; locale: 'zh' | 'en'; }
const { post, locale } = Astro.props;
const t = useTranslations(locale);
const { category } = parseId(post.id);
const zone = getContentZone(category, post.data.brand);
const href = postPath(post);
const cover = post.data.cover;
const catName = (SITE.categories[locale] as Record<string, string>)[category] ?? category;
const isSelect = zone === 'select';
---
<article class="border border-[var(--color-border)] bg-[var(--color-term-surface)] h-full hover:border-[var(--color-term-accent)] transition-colors duration-150 grid grid-rows-[auto_1fr]">
  <a href={href} class="block text-inherit no-underline">
    {cover ? (
      <Image src={cover} alt={post.data.title} width={640} height={360} class="w-full h-auto aspect-video object-cover block" loading="lazy" />
    ) : (
      <div class="w-full aspect-video flex items-center justify-center bg-[var(--color-term-accent-bg)] text-[var(--color-term-accent-dim)] text-sm tracking-wide">
        <span>{catName}</span>
      </div>
    )}
    <div class="p-[1rem_1rem_1.15rem] border-t border-[var(--color-border)]">
      <span class="text-[0.7rem] text-[var(--color-term-accent)] uppercase tracking-[0.12em]">
        {catName}{isSelect && <span class="ml-1.5 px-1 text-[0.6rem] border border-[var(--color-sel-accent-bg)] text-[var(--color-sel-accent-dim)] align-middle">{t('nav.select')}</span>}
      </span>
      <h3 class="text-[1rem] mt-2 mb-1.5 leading-snug font-medium">{post.data.title}</h3>
      <p class="text-[0.82rem] text-[var(--color-term-text-muted)] m-0 mb-2 line-clamp-2">{post.data.description}</p>
      <time datetime={post.data.date.toISOString()} class="text-[0.75rem] text-[var(--color-term-text-muted)] tracking-wide">
        {post.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}
      </time>
    </div>
  </a>
</article>
