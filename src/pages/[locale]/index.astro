---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';

export async function getStaticPaths() {
  const all = await getPosts();
  const locales = ['zh', 'en'] as Locale[];
  return locales.map((locale) => {
    const posts = all.filter((p) => p.id.startsWith(`${locale}/`));
    const counts: Record<string, number> = {};
    for (const p of posts) {
      const cat = p.id.split('/')[1];
      counts[cat] = (counts[cat] ?? 0) + 1;
    }
    return { params: { locale }, props: { posts, counts } };
  });
}

const { locale } = Astro.params as { locale: Locale };
const { posts, counts } = Astro.props as { posts: any[]; counts: Record<string, number> };
const t = useTranslations(locale);
const cats = SITE.categories[locale];
const path = `/${locale}`;
---
<BaseLayout title={SITE.title} description={SITE.description} path={path} breadcrumb={[]} wide>
  <section class="hero" data-parallax-root>
    <div class="hero-shapes" data-parallax="back" aria-hidden="true">
      <span class="shape s1"></span>
      <span class="shape s2"></span>
    </div>
    <div class="hero-shapes-mid" data-parallax="mid" aria-hidden="true">
      <span class="shape s3"></span>
    </div>
    <div class="hero-inner" data-parallax="fore">
      <span class="kicker" data-hero>{t('home.categories')}</span>
      <span class="rule-line hero-rule" data-hero><span>❧</span></span>
      <h1 class="hero-title" data-hero>{SITE.name}</h1>
      <p class="hero-sub muted serif-body" data-hero>{t('home.tagline')}</p>
      <div class="hero-meta" data-hero>
        <span>AI TOOLS</span><i>·</i><span>PYTHON</span><i>·</i><span>REVIEWS</span>
      </div>
      <a class="hero-cta" href="#latest" data-hero>{t('home.latest')} →</a>
    </div>
  </section>

  <div class="rule-line section-rule reveal"><span>✦</span></div>
  <h2 class="section-title serif-display reveal">{t('home.categories')}</h2>
  <div class="cat-grid">
    {Object.entries(cats).map(([key, name], i) => (
      <a class="cat-card print-frame reveal" href={withBase(`/${locale}/${key}`)}>
        <span class="cat-no">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="serif-display">{name}</h3>
        <span class="cat-count">{t('home.postsCount', { n: counts[key] ?? 0 })}</span>
        <span class="cat-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>

  <div class="rule-line section-rule reveal"><span>❦</span></div>
  <h2 class="section-title serif-display reveal" id="latest">{t('home.latest')}</h2>
  <div class="grid">
    {posts.slice(0, 9).map((post) => (
      <div class="stagger-card">
        <ArticleCard post={post} locale={locale} />
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  /* ── Hero：復古刊頭式滿版 ── */
  .hero {
    position: relative;
    margin: 1.5rem 0 1rem;
    padding: 5.5rem 2rem 5rem;
    border-radius: var(--radius-lg);
    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(120% 130% at 78% -15%, var(--accent-soft) 0%, transparent 52%),
      linear-gradient(165deg, #f7f1e7 0%, var(--bg) 72%);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }
  .hero-shapes,
  .hero-shapes-mid {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-shapes .shape,
  .hero-shapes-mid .shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(8px);
  }
  .s1 {
    width: 280px; height: 280px;
    top: -90px; left: -60px;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 70%);
    opacity: 0.8;
  }
  .s2 {
    width: 220px; height: 220px;
    bottom: -80px; right: -40px;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 70%);
    opacity: 0.7;
  }
  .s3 {
    width: 120px; height: 120px;
    top: 30%; right: 14%;
    border: 1px solid var(--color-accent);
    opacity: 0.25;
  }
  .hero-inner { position: relative; z-index: 2; max-width: 46rem; margin: 0 auto; }
  .hero-rule { margin: 1rem auto 1.4rem; max-width: 18rem; }
  .hero-title {
    font-family: var(--font-serif-display);
    font-size: clamp(3rem, 1rem + 9vw, 6rem);
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.02;
  }
  .hero-sub { font-size: 1.15rem; max-width: 34rem; margin: 1.4rem auto 0; }
  .hero-meta {
    display: flex;
    gap: 0.7rem;
    justify-content: center;
    align-items: center;
    margin: 1.5rem 0 2rem;
    font-family: var(--font-serif-body);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    color: var(--color-text-faint);
    text-transform: uppercase;
  }
  .hero-meta i { color: var(--color-accent); font-style: normal; }
  .hero-cta {
    display: inline-block;
    background: var(--color-accent);
    color: #fbf8f1;
    text-decoration: none;
    font-family: var(--font-serif-body);
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: 0.04em;
    padding: 0.7rem 1.8rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-accent-deep);
    transition: background 0.18s var(--ease), transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .hero-cta:hover {
    background: var(--color-accent-deep);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  /* ── 章節標題 ── */
  .section-rule { max-width: 22rem; margin-left: auto; margin-right: auto; }
  .section-title {
    text-align: center;
    font-family: var(--font-serif-display);
    font-size: clamp(1.8rem, 1rem + 3vw, 2.6rem);
    font-weight: 700;
    margin: var(--space-4) 0 var(--space-6);
  }

  /* ── 分類卡：復古編號卡 ── */
  .cat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--color-surface);
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .cat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent);
  }
  .cat-no {
    font-family: var(--font-serif-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }
  .cat-card h3 {
    margin: 0 0 var(--space-1);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .cat-count {
    font-family: var(--font-serif-body);
    font-size: 0.82rem;
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.03em;
  }
  .cat-arrow {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    color: var(--color-text-faint);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), color 0.2s var(--ease);
  }
  .cat-card:hover .cat-arrow { opacity: 1; transform: translateX(0); color: var(--color-accent); }

  /* 文章卡外層包覆：保留原有 .grid 间距 */
  .stagger-card { height: 100%; }
</style>
