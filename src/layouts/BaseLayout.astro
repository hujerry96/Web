---
import '../styles/global.css';
import { SITE } from '../consts';
import { HREFLANG } from '../i18n/config';
import type { Post } from '../lib/content';
import { buildCanonical, buildHreflang } from '../lib/seo';
import Meta from '../components/seo/Meta.astro';
import OpenGraph from '../components/seo/OpenGraph.astro';
import TwitterCard from '../components/seo/TwitterCard.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string;              // 當前頁路徑，如 /zh/reviews/foo
  post?: Post | null;        // 文章頁傳入，用於 JSON-LD / OG 細節
  type?: 'website' | 'article';
  breadcrumb?: { name: string; url: string }[];
  wide?: boolean;
}

const { title, description, path, post = null, type = post ? 'article' : 'website', breadcrumb, wide = false } = Astro.props;
const locale = (path.startsWith('/en') ? 'en' : 'zh') as keyof typeof HREFLANG;
const url = `${SITE.url}${path}`;
const canonical = buildCanonical(post, path);
const hreflang = buildHreflang(post, path);
const image = post?.data.cover ? new URL(post.data.cover, SITE.url).href : `${SITE.url}/images/og-default.png`;

const jsonLd: Record<string, unknown>[] = [];
if (post) jsonLd.push(buildArticleLd());
if (breadcrumb) jsonLd.push(buildBreadcrumbLd());
if (type === 'website' && !post) jsonLd.push(websiteLd());

function buildArticleLd() {
  return {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post!.data.title,
    description: post!.data.description,
    image,
    datePublished: post!.data.date.toISOString(),
    dateModified: (post!.data.updated ?? post!.data.date).toISOString(),
    author: { '@type': 'Person', name: post!.data.author },
    publisher: { '@type': 'Organization', name: SITE.name },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    keywords: post!.data.keywords.join(', '),
  };
}
function buildBreadcrumbLd() {
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumb!.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      item: `${SITE.url}${item.url}`,
    })),
  };
}
function websiteLd() {
  return { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, inLanguage: SITE.locale };
}
---
<!doctype html>
<html lang={HREFLANG[locale]}>
  <head>
    <Meta title={title} description={description} canonical={canonical} path={path} hreflang={hreflang}
      published={post?.data.date.toISOString()} modified={post?.data.updated?.toISOString()} />
    <OpenGraph title={title} description={description} url={url} image={image} locale={HREFLANG[locale]} siteName={SITE.name} type={type} />
    <TwitterCard title={title} description={description} image={image} twitter={SITE.twitter} />
    {jsonLd.length > 0 && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <Header path={path} locale={locale} />
    <main class={`container${wide ? ' wide' : ''}`}>
      <slot />
    </main>
    <Footer locale={locale} />
    <button class="back-to-top" id="back-to-top" aria-label="回到頂部">↑</button>
    <script>
      // 輕量滾動淡入：為帶 .reveal 的元素加入進場動畫
      const els = document.querySelectorAll('.reveal');
      if (els.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }

      // 返回頂部按鈕
      const btn = document.getElementById('back-to-top');
      if (btn) {
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              btn.classList.toggle('is-visible', window.scrollY > 300);
              ticking = false;
            });
            ticking = true;
          }
        });
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>
