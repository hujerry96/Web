---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  path={path}
  image={`${SITE.url}${promoPoster}`}
  jsonLd={[productSchema, faqSchema]}
  wide
>
  <div class="product-page">
    <nav class="product-nav" aria-label={isZh ? 'Spectra Studio 頁面導覽' : 'Spectra Studio page navigation'}>
      <a class="product-brand" href="#top" aria-label="Spectra Studio">
        <span class="product-mark" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
        </span>
        <span>Spectra Studio</span>
      </a>
      <div class="product-nav__links">
        <a href="#workflow">{c.navWorkflow}</a>
        <a href="#analysis">{c.navResults}</a>
        <a href="#trust">{c.navTrust}</a>
        <a href="#pricing">{c.navPricing}</a>
      </div>
      <a class="product-nav__cta" href={DOWNLOAD_URL}>{c.navDownload}</a>
    </nav>

    <section class="hero" id="top">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-copy">
        <a class="release-pill" href={RELEASE_URL} target="_blank" rel="noopener noreferrer">
          <span></span>{c.version}
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 11L11 5M6 5h5v5"/></svg>
        </a>
        <p class="eyebrow">{c.eyebrow}</p>
        <h1><span>{c.headlineA}</span><strong>{c.headlineB}</strong></h1>
        <div class="spectrum-types" aria-label={isZh ? '支援數據類型' : 'Supported data types'}>XRD <span>·</span> FTIR <span>·</span> Raman <span>·</span> UV-Vis <span>·</span> DSC / TGA</div>
        <p class="hero-body">{c.heroBody}</p>
