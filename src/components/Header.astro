---
import { SITE, withBase } from '../consts';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import LangSwitch from './LangSwitch.astro';

interface Props { path: string; locale: Locale; zone?: 'lab' | 'select'; }
const { path, locale, zone = 'lab' } = Astro.props;
const t = useTranslations(locale);

const allCats = SITE.categories[locale] as Record<string, string>;
const labNav = Object.keys(allCats).filter((k) => k !== 'select').map((key) => ({ href: `/${locale}/${key}`, key: `nav.${key}` as Parameters<typeof t>[0] }));
const selectNav = allCats.select ? { href: `/${locale}/select`, key: 'nav.select' as Parameters<typeof t>[0] } : null;
const staticLinks: { href: string; key: Parameters<typeof t>[0] }[] = [
  { href: `/${locale}/free-resources`, key: 'nav.free' },
  { href: `/${locale}/about`, key: 'nav.about' },
  { href: `/${locale}/contact`, key: 'nav.contact' },
];
const shortPath = path === '/' || path === '/zh' ? '~' : path;
---
<header class="border-b border-[var(--color-term-accent-dim)]" id="site-header">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-5 h-12">
    <a href={withBase(zone === 'select' ? `/${locale}/select` : `/${locale}`)} class="term-prompt no-underline whitespace-nowrap text-sm">
      <span class="text-[var(--color-term-accent)]">cd</span>
      <span class="text-[var(--color-term-text)]"> {shortPath}</span>
    </a>
    <div class="flex items-center gap-1.5">
      <a class="no-underline text-[var(--color-term-text-muted)] hover:text-[var(--color-term-accent)] text-sm px-1.5" href={withBase(`/${locale}/search`)} aria-label={t('nav.search')} title={t('nav.search')}>find</a>
      <button class="theme-toggle border-none bg-transparent cursor-pointer text-[var(--color-term-text-muted)] hover:text-[var(--color-term-accent)] text-sm px-1.5 font-mono" id="theme-toggle" aria-label={t('a11y.theme')} title={t('a11y.theme')}>
        <span class="tt-icon inline-block" aria-hidden="true">☾</span>
      </button>
      <LangSwitch path={path} locale={locale} />
    </div>
  </div>
  <nav class="mx-auto flex max-w-4xl items-center gap-3 px-5 pb-2.5 flex-wrap text-sm" aria-label="primary">
    {labNav.map((item) => (
      <a href={withBase(item.href)} class="no-underline text-[var(--color-term-text-muted)] hover:text-[var(--color-term-accent)] transition-colors duration-150">{t(item.key)}</a>
    ))}
    {selectNav ? (
      <>
        <span class="text-[var(--color-term-text-muted)] opacity-40">|</span>
        <a href={withBase(selectNav.href)} class="no-underline text-[var(--color-sel-accent)] hover:text-[var(--color-sel-accent-dim)]">{t(selectNav.key)}</a>
      </>
    ) : null}
    <span class="text-[var(--color-term-text-muted)] opacity-40">|</span>
    {staticLinks.map((item) => (
      <a href={withBase(item.href)} class="no-underline text-[var(--color-term-text-muted)] hover:text-[var(--color-term-accent)] transition-colors duration-150">{t(item.key)}</a>
    ))}
  </nav>
</header>
