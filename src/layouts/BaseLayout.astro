---
import '../styles/global.css';
import { SITE } from '../consts';
import { HREFLANG } from '../i18n/config';
import type { Post } from '../lib/content';
import { buildCanonical, buildHreflang, articleLd, breadcrumbLd, websiteLd } from '../lib/seo';
import Meta from '../components/seo/Meta.astro';
import OpenGraph from '../components/seo/OpenGraph.astro';
import TwitterCard from '../components/seo/TwitterCard.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  path: string;              // 當前頁路徑，如 /zh/reviews/foo
  post?: Post | null;        // 文章頁傳入，用於 JSON-LD / OG 細節
  type?: 'website' | 'article';
  breadcrumb?: { name: string; url: string }[];
  wide?: boolean;
}

const { title, description, path, post = null, type = post ? 'article' : 'website', breadcrumb, wide = false } = Astro.props;
const locale = (path.startsWith('/en') ? 'en' : 'zh') as keyof typeof HREFLANG;
const t = useTranslations(locale);
const url = `${SITE.url}${path}`;
const canonical = buildCanonical(post, path);
const hreflang = buildHreflang(post, path);
const image = post?.data.cover ? new URL(post.data.cover, SITE.url).href : `${SITE.url}/images/og-default.png`;

const jsonLd: Record<string, unknown>[] = [];
if (post) jsonLd.push(articleLd(post, url));
if (breadcrumb) jsonLd.push(breadcrumbLd(breadcrumb, SITE.url));
if (type === 'website' && !post) jsonLd.push(websiteLd());
---
<!doctype html>
<html lang={HREFLANG[locale]}>
  <head>
    <Meta title={title} description={description} canonical={canonical} path={path} hreflang={hreflang}
      published={post?.data.date.toISOString()} modified={post?.data.updated?.toISOString()} />
    <OpenGraph title={title} description={description} url={url} image={image} locale={HREFLANG[locale]} siteName={SITE.name} type={type} />
    <TwitterCard title={title} description={description} image={image} twitter={SITE.twitter} />
    {jsonLd.length > 0 && <JsonLd data={jsonLd} />}
    <!-- 全襯線字體：Lora（英文）+ Noto Serif TC（中文）。preconnect + preload 防 FOUC -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Noto+Serif+TC:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Noto+Serif+TC:wght@400;500;600;700&display=swap"
    />
    <script>
      (function() {
        const saved = localStorage.getItem('theme');
        const prefers = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', saved || prefers);
      })();
    </script>
  </head>
  <body>
    <Header path={path} locale={locale} />
    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
    <main class={`container${wide ? ' wide' : ''}`}>
      <slot />
    </main>
    <Footer locale={locale} />
    <button class="back-to-top" id="back-to-top" aria-label={t('a11y.top')}>↑</button>
  <script>
    // 返回頂部按鈕
    const btn = document.getElementById('back-to-top');
    if (btn) {
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            btn.classList.toggle('is-visible', window.scrollY > 300);
            ticking = false;
          });
          ticking = true;
        }
      });
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // 主題切換
    const toggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    if (toggle) {
      const icon = toggle.querySelector('.tt-icon');
      const updateIcon = () => {
        const isDark = html.getAttribute('data-theme') === 'dark';
        if (icon) icon.textContent = isDark ? '☀️' : '🌙';
      };
      updateIcon();
      toggle.addEventListener('click', () => {
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateIcon();
      });
    }

    // 閱讀進度條
    const bar = document.getElementById('reading-progress');
    if (bar) {
      let ticking = false;
      const update = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        const p = max > 0 ? Math.min(1, h.scrollTop / max) : 0;
        bar.style.transform = `scaleX(${p})`;
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(update); ticking = true; }
      }, { passive: true });
      update();
    }
  </script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <script is:inline>
    // 編輯風淡入動畫（GSAP）。尊重 prefers-reduced-motion；無 GSAP 時直接顯示。
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const reveals = document.querySelectorAll('.reveal');
      const staggerCards = document.querySelectorAll('.stagger-card');

      if (reduce || typeof gsap === 'undefined') {
        reveals.forEach((el) => el.classList.add('is-visible'));
        return;
      }

      gsap.registerPlugin(ScrollTrigger);

      // 輕量 CSS 淡入（.reveal）
      reveals.forEach((el) => gsap.set(el, { opacity: 0, y: 24 }));
      ScrollTrigger.batch('.reveal', {
        start: 'top 90%',
        onEnter: (batch) =>
          gsap.to(batch, {
            opacity: 1,
            y: 0,
            duration: 0.7,
            stagger: 0.08,
            ease: 'power2.out',
            onComplete: () => batch.forEach((el) => el.classList.add('is-visible')),
          }),
      });

      // 文章卡滾動浮起（stagger，無 3D 傾斜）
      if (staggerCards.length) {
        ScrollTrigger.batch('.stagger-card', {
          start: 'top 92%',
          onEnter: (batch) =>
            gsap.fromTo(
              batch,
              { opacity: 0, y: 28 },
              { opacity: 1, y: 0, duration: 0.6, stagger: 0.07, ease: 'power2.out' }
            ),
        });
      }
    })();
  </script>
  </body>
</html>
