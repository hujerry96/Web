---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';
import { getTools } from '../../lib/tools';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const path = `/${locale}/tools`;
const tools = getTools(locale);
---
<BaseLayout title={`${t('nav.tools')} | ${SITE.name}`} description={t('page.toolsDesc', { name: SITE.name })} path={path}>
  <section class="py-8 max-w-4xl mx-auto">
    <Breadcrumb locale={locale} items={[{ name: t('nav.tools'), url: path }]} />
    <h1 class="text-[clamp(2rem,1rem+3vw,2.8rem)] font-display font-semibold mb-4 reveal">{t('nav.tools')}</h1>
    <article class="prose mb-8 reveal reveal-delay-1">
      <p>{t('page.toolsDesc')}</p>
    </article>

    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,360px),1fr))] gap-6 reveal reveal-delay-2">
      {tools.map((tool) => (
        <section class="tool-card">
          <div class="tool-card__header">
            <span class="text-[0.7rem] font-medium tracking-[0.1em] uppercase text-[var(--color-accent)]">{tool.tag}</span>
          </div>
          <div class="tool-card__body">
            <h2 class="text-[1.25rem] font-display font-semibold m-0 mb-2">{tool.name}</h2>
            <p class="text-[var(--color-text-secondary)] m-0 mb-4 leading-relaxed">{tool.desc}</p>
            <ul class="list-none p-0 m-0 mb-5 grid gap-1.5">
              {tool.points.map((p) => (
                <li class="relative pl-5 text-[0.9rem] text-[var(--color-text)]">
                  <span class="absolute left-0 text-[var(--color-accent)]">→</span>
                  {p}
                </li>
              ))}
            </ul>
            <div class="flex items-center justify-between border-t border-[var(--color-border-subtle)] pt-4">
              <span class="text-[0.78rem] text-[var(--color-text-tertiary)]">{tool.lang}</span>
              <span class="flex gap-4 flex-wrap">
                <a class="text-[var(--color-accent)] text-[0.85rem] font-medium hover:text-[var(--color-accent-dim)] transition-colors duration-200" href={withBase(tool.guide)}>{locale === 'zh' ? '使用指南' : 'Guide'} →</a>
                {tool.repo && (
                  <a class="text-[var(--color-accent)] text-[0.85rem] font-medium hover:text-[var(--color-accent-dim)] transition-colors duration-200" href={tool.repo} target="_blank" rel="noopener">GitHub →</a>
                )}
              </span>
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- ── Online tools ── -->
    <h2 class="text-[0.7rem] font-mono font-semibold tracking-[0.12em] uppercase text-[var(--color-text-tertiary)] mb-4 mt-10">
      {locale === 'zh' ? '線上工具' : 'Online Tools'}
    </h2>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,360px),1fr))] gap-6">
      <a class="tool-card group" href={withBase(`/${locale}/tools/crystallite-size-calculator`)}>
        <div class="tool-card__header">
          <span class="text-[0.7rem] font-medium tracking-[0.1em] uppercase text-[var(--color-accent)]">Scherrer Calculator</span>
        </div>
        <div class="tool-card__body">
          <h2 class="text-[1.25rem] font-display font-semibold m-0 mb-2">
            {locale === 'zh' ? '晶粒尺寸計算器（Scherrer 公式）' : 'Crystallite Size Calculator (Scherrer Equation)'}
          </h2>
          <p class="text-[var(--color-text-secondary)] m-0 mb-4 leading-relaxed">
            {locale === 'zh'
              ? '輸入 XRD 峰位 2θ 與 FWHM，即時以 Scherrer 公式估算晶粒尺寸，附單位換算與注意事項。'
              : 'Enter XRD peak position 2θ and FWHM to estimate crystallite size instantly with the Scherrer equation — unit conversion included.'}
          </p>
          <div class="flex items-center justify-between border-t border-[var(--color-border-subtle)] pt-4">
            <span class="text-[0.78rem] text-[var(--color-text-tertiary)]">Web</span>
            <span class="text-[var(--color-accent)] text-[0.85rem] font-medium group-hover:underline">{locale === 'zh' ? '開啟計算器 →' : 'Open calculator →'}</span>
          </div>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .tool-card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
    transition: border-color 280ms var(--ease), box-shadow 280ms var(--ease), transform 280ms var(--ease);
  }
  .tool-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px -6px var(--color-accent-glow), 0 2px 8px rgba(0,0,0,0.12);
  }
  .tool-card__header {
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-muted);
  }
  .tool-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
  }
</style>
