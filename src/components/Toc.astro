---
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  headings: { text: string; id: string; level: number }[];
  locale: Locale;
}
const { headings, locale } = Astro.props;
const t = useTranslations(locale);
---

{headings.length > 0 && (
  <nav class="toc" aria-label={t('article.toc')}>
    <span class="kicker">{t('article.toc')}</span>
    <ul>
      {headings.map((h) => (
        <li class={`lvl-${h.level}`}>
          <a href={`#${h.id}`} data-toc-link={h.id}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  // 滾動時高亮目前章節（IntersectionObserver）
  const links = Array.from(document.querySelectorAll('[data-toc-link]')) as HTMLAnchorElement[];
  if (links.length && 'IntersectionObserver' in window) {
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => map.set(l.getAttribute('data-toc-link')!, l));

    const setActive = (id: string | null) => {
      links.forEach((l) => l.classList.remove('is-active'));
      if (id && map.has(id)) map.get(id)!.classList.add('is-active');
    };

    const heads = links
      .map((l) => document.getElementById(l.getAttribute('data-toc-link')!))
      .filter((el): el is HTMLElement => !!el);

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );
    heads.forEach((h) => io.observe(h));

    // 點擊平滑滾動並更新網址 hash
    links.forEach((l) => {
      l.addEventListener('click', (e) => {
        const id = l.getAttribute('data-toc-link')!;
        const target = document.getElementById(id);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${id}`);
          setActive(id);
        }
      });
    });
  }
</script>

<style>
  .toc {
    position: sticky;
    top: 104px;
    align-self: start;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    font-family: var(--font-serif-body);
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-border);
  }
  .toc .kicker {
    margin-bottom: 0.8rem;
    display: block;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li { margin: 0; }
  .toc a {
    display: block;
    padding: 0.3rem 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: 0.8rem;
    margin-left: -1px;
    transition: color var(--duration-fast) var(--ease), border-color var(--duration-fast) var(--ease);
  }
  .toc .lvl-3 a { font-size: 0.8rem; padding-left: 1.6rem; }
  .toc a:hover { color: var(--color-accent); }
  .toc a.is-active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    font-weight: 600;
  }
</style>
