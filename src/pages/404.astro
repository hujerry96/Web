---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, withBase } from '../consts';

const path = '/404';
const locale = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
const home = withBase(`/${locale}`);
const title = locale === 'zh' ? '這一頁走失了' : 'This page is lost';
const desc = locale === 'zh' ? '你找的頁面可能已經移動或不存在。' : 'The page you are looking for may have moved or no longer exists.';
const btn = locale === 'zh' ? '回到首頁 →' : 'Back to home →';
---
<BaseLayout title={`404 — ${SITE.name}`} description={desc} path={path}>
  <section class="text-center py-[clamp(4rem,10vw,8rem)] max-w-[36rem] mx-auto">
    <span class="inline-block font-serif text-[0.74rem] font-medium tracking-[0.28em] uppercase text-lab-accent">404</span>
    <h1 class="font-serif text-[clamp(2rem,1rem+4vw,3.5rem)] font-medium mt-4 mb-4">{title}</h1>
    <p class="text-lab-text-muted">{desc}</p>
    <a class="inline-block mt-6 bg-lab-accent text-[#fbf8f1] no-underline font-serif font-medium text-[0.98rem] tracking-wide py-2.5 px-7 rounded-full border border-lab-accent-deep transition-all duration-[180ms] hover:bg-lab-accent-deep hover:-translate-y-0.5 hover:shadow-lg" href={home}>{btn}</a>
  </section>
</BaseLayout>
