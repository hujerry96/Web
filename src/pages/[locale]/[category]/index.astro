---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getPosts } from '../../../lib/content';
import { useTranslations } from '../../../i18n/ui';
import { SITE, type Locale } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const paths: { params: { locale: string; category: string }; props: { posts: any[] } }[] = [];
  for (const locale of ['zh', 'en'] as Locale[]) {
    const cats = Object.keys(SITE.categories[locale]);
    for (const category of cats) {
      const inCat = posts.filter((p: any) => p.id.startsWith(`${locale}/${category}/`));
      paths.push({ params: { locale, category }, props: { posts: inCat } });
    }
  }
  return paths;
}

const { locale, category } = Astro.params as { locale: Locale; category: string };
const { posts } = Astro.props as { posts: any[] };
const t = useTranslations(locale);
const catName = (SITE.categories[locale] as Record<string, string>)[category] ?? category;
const path = `/${locale}/${category}`;
---
<BaseLayout title={`${catName} | ${SITE.name}`} description={`${catName} — ${SITE.name}`} path={path} wide>
  <section class="py-8">
    <Breadcrumb locale={locale} items={[{ name: catName, url: path }]} />
    <h1 class="text-[clamp(2rem,1rem+3vw,2.8rem)] font-display font-semibold mb-2 reveal">{catName}</h1>
    <p class="text-[var(--color-text-secondary)] text-[0.95rem] mb-8 reveal reveal-delay-1">{t('home.postsCount', { n: posts.length })}</p>
    {posts.length > 0 ? (
      <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,300px),1fr))] gap-5 reveal reveal-delay-2">
        {posts.map((post) => <ArticleCard post={post} locale={locale} />)}
      </div>
    ) : (
      <p class="text-[var(--color-text-secondary)] text-[1.05rem] py-12 text-center reveal">{t('category.empty')}</p>
    )}
  </section>
</BaseLayout>
