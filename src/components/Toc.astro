---
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  headings: { text: string; id: string; level: number }[];
  locale: Locale;
}
const { headings, locale } = Astro.props;
const t = useTranslations(locale);
---

{headings.length > 0 && (
  <nav class="sticky top-24 self-start max-h-[calc(100vh-8rem)] overflow-y-auto pl-4 border-l-2 border-[var(--color-border)]" aria-label={t('article.toc')}>
    <span class="inline-block text-[0.7rem] font-medium tracking-[0.1em] uppercase text-[var(--color-accent)] mb-3">{t('article.toc')}</span>
    <ul class="list-none m-0 p-0">
      {headings.map((h) => (
        <li>
          <a href={`#${h.id}`} data-toc-link={h.id} class:list={[
            'block py-1.5 text-[0.82rem] leading-snug text-[var(--color-text-secondary)] no-underline border-l-2 border-transparent pl-3 -ml-[2px] transition-all duration-300 hover:text-[var(--color-text)]',
            h.level === 3 && 'text-[0.78rem] pl-5'
          ]}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  const links = Array.from(document.querySelectorAll('[data-toc-link]')) as HTMLAnchorElement[];
  if (links.length && 'IntersectionObserver' in window) {
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => map.set(l.getAttribute('data-toc-link')!, l));

    const setActive = (id: string | null) => {
      links.forEach((l) => l.classList.remove('is-active'));
      if (id && map.has(id)) map.get(id)!.classList.add('is-active');
    };

    const heads = links
      .map((l) => document.getElementById(l.getAttribute('data-toc-link')!))
      .filter((el): el is HTMLElement => !!el);

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );
    heads.forEach((h) => io.observe(h));

    links.forEach((l) => {
      l.addEventListener('click', (e) => {
        const id = l.getAttribute('data-toc-link')!;
        const target = document.getElementById(id);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${id}`);
          setActive(id);
        }
      });
    });
  }
</script>

<style>
  a.is-active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    font-weight: 500;
  }
</style>
