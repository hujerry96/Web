---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getPosts, getRelated, parseId, postSlug, readingTime, extractHeadings } from '../../../lib/content';
import { render } from 'astro:content';
import { useTranslations } from '../../../i18n/ui';
import { SITE, withBase, type Locale } from '../../../consts';
import ArticleCard from '../../../components/ArticleCard.astro';
import Toc from '../../../components/Toc.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const { locale, category } = parseId(post.id);
    return { params: { locale, category, slug: postSlug(post) }, props: { post } };
  });
}

const { locale, category } = Astro.params as { locale: Locale; category: string };
const { post } = Astro.props as { post: any };
const t = useTranslations(locale);
const { Content } = await render(post);
const catName =
  (SITE.categories[locale] as Record<string, string>)[category] ?? category;
const slug = postSlug(post);
const path = `/${locale}/${category}/${slug}`;
const related = await getRelated(post);
const headings = extractHeadings(post.body);
const breadcrumb = [
  { name: catName, url: `/${locale}/${category}` },
  { name: post.data.title, url: path },
];
---
<BaseLayout title={`${post.data.title} | ${SITE.name}`} description={post.data.description} path={path} post={post} breadcrumb={breadcrumb} wide>
  <Breadcrumb locale={locale} items={breadcrumb} />

  <div class="article-layout">
    <div class="article-main">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <span>{t('article.by')} {post.data.author}</span>
        <span>{readingTime(post.body, locale)}</span>
        <time datetime={post.data.date.toISOString()}>{t('article.published')} {post.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</time>
        {post.data.updated && <time datetime={post.data.updated.toISOString()}>{t('article.updated')} {post.data.updated.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</time>}
      </div>

      {post.data.cover && (
        <img src={withBase(post.data.cover)} alt={post.data.title} width={1280} height={720} class="cover" />
      )}

      <article class="prose">
        <Content />
      </article>

      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag: string) => <span class="tag">#{tag}</span>)}
        </div>
      )}

      {post.data.affiliate?.shopee && (
        <p class="aff"><a href={post.data.affiliate.shopee}>{t('page.buyShopee')}</a></p>
      )}
      {post.data.affiliate?.amazon && (
        <p class="aff"><a href={post.data.affiliate.amazon}>{t('page.buyAmazon')}</a></p>
      )}
    </div>

    <aside class="article-side">
      <Toc headings={headings} locale={locale} />
    </aside>
  </div>

  {related.length > 0 && (
    <>
      <h2 class="section-title">{t('article.related')}</h2>
      <div class="grid">
        {related.map((r) => <ArticleCard post={r} locale={locale} />)}
      </div>
    </>
  )}
</BaseLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: var(--space-10);
    align-items: stretch;
  }
  .article-main { min-width: 0; }
  .article-main > h1 {
    font-size: clamp(1.9rem, 1rem + 2.4vw, 2.8rem);
    line-height: 1.15;
    overflow-wrap: break-word;
    word-break: break-word;
    margin-top: 0;
  }
  .article-side { display: block; position: relative; }
  @media (max-width: 980px) {
    .article-layout { grid-template-columns: 1fr; gap: var(--space-6); }
    .article-side { display: none; }
  }
  .aff { margin: 1rem 0; }
  .aff a { font-weight: 600; }
</style>
