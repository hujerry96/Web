---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, readingTime } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const all = await getPosts();
  const locales = ['zh', 'en'] as Locale[];
  return locales.map((locale) => {
    const posts = all.filter((p) => p.id.startsWith(`${locale}/`) && p.data.brand !== 'select');
    return { params: { locale }, props: { posts } };
  });
}

const { locale } = Astro.params as { locale: Locale };
const { posts } = Astro.props as { posts: any[] };
const t = useTranslations(locale);
const cats = SITE.categories[locale] as Record<string, string>;
const path = `/${locale}`;

const featured = posts[0];
const rest = posts.slice(1, 10);
const featuredCat = featured ? (featured.id.split('/')[1] as string) : '';
const featuredCatName = featured ? ((SITE.categories[locale] as Record<string, string>)[featuredCat] ?? featuredCat) : '';
const catCounts: Record<string, number> = {};
for (const p of posts) { const c = p.id.split('/')[1]; catCounts[c] = (catCounts[c] ?? 0) + 1; }
---
<BaseLayout title={SITE.meta[locale].title} description={SITE.meta[locale].description} path={path} post={featured} breadcrumb={[]} wide>

  {/* ── Hero ── */}
  <section class="pt-[clamp(3rem,8vw,7rem)] pb-[clamp(2rem,4vw,4rem)] reveal">
    <div class="max-w-3xl">
      <span class="inline-block text-[0.72rem] font-medium tracking-[0.15em] uppercase text-[var(--color-accent)] mb-4">{t('home.tagline')}</span>
      <h1 class="text-[clamp(2.2rem,1rem+5vw,3.75rem)] tracking-tight leading-[1.08] mb-5">{SITE.name}</h1>
      <p class="text-[var(--color-text-secondary)] text-[clamp(1rem,0.9rem+0.5vw,1.15rem)] leading-relaxed max-w-[38rem]">{t('home.intro')}</p>
    </div>
  </section>

  {/* ── Category filters ── */}
  <nav class="flex flex-wrap gap-2 mb-10 reveal reveal-delay-1" aria-label="categories">
    {Object.entries(cats).map(([key, name]) => {
      const isSel = key === 'select';
      return (
        <a
          href={withBase(`/${locale}/${key}`)}
          class:list={[
            'inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-sm font-medium border transition-all duration-200',
            isSel
              ? 'border-[var(--color-select-accent)] bg-[var(--color-select-muted)] text-[var(--color-select-accent)] hover:bg-[var(--color-select-glow)]'
              : 'border-[var(--color-border)] text-[var(--color-text-secondary)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] hover:bg-[var(--color-accent-muted)]'
          ]}
        >
          {name}
          <span class="text-[0.7rem] opacity-60">{catCounts[key] ?? 0}</span>
        </a>
      );
    })}
  </nav>

  {/* ── Featured ── */}
  {featured && (
    <section class="mb-14 reveal reveal-delay-2">
      <a
        class="featured-card group"
        href={withBase(`/${locale}/${featuredCat}/${featured.data.slug ?? featured.id.split('/').slice(2).join('/')}`)}
      >
        <div class="featured-card__image">
          {featured.data.cover
            ? <Image src={featured.data.cover} alt={featured.data.title} width={900} height={560} class="w-full h-full object-cover" loading="eager" />
            : <div class="w-full h-full flex items-center justify-center bg-[var(--color-accent-muted)] text-[var(--color-accent)] text-sm"><span>{featuredCatName}</span></div>
          }
        </div>
        <div class="featured-card__body">
          <span class="text-[0.72rem] font-medium uppercase tracking-[0.1em] text-[var(--color-accent)]">{featuredCatName}</span>
          <h2 class="text-[clamp(1.15rem,0.9rem+1vw,1.5rem)] font-display font-semibold mt-3 mb-2 leading-snug group-hover:text-[var(--color-accent)] transition-colors duration-200">{featured.data.title}</h2>
          <p class="text-[var(--color-text-secondary)] text-[0.9rem] mb-3 leading-relaxed">{featured.data.description}</p>
          <div class="flex gap-3 items-center text-[0.8rem] text-[var(--color-text-tertiary)]">
            <span>{featured.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</span>
            <span class="opacity-40">·</span>
            <span>{readingTime(featured.body, locale)}</span>
          </div>
        </div>
      </a>
    </section>
  )}

  {/* ── Latest posts ── */}
  <section class="mb-16 reveal reveal-delay-3">
    <h2 class="text-[0.72rem] font-medium tracking-[0.1em] uppercase text-[var(--color-text-tertiary)] mb-5 font-body">{t('home.latest')}</h2>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,300px),1fr))] gap-5">
      {rest.map((post) => (
        <ArticleCard post={post} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .featured-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 280ms var(--ease), box-shadow 280ms var(--ease);
  }
  .featured-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 12px 40px -10px var(--color-accent-glow), 0 4px 12px rgba(0,0,0,0.15);
  }
  .featured-card__image {
    min-height: 280px;
    overflow: hidden;
    background: var(--color-surface);
  }
  .featured-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }
  .featured-card:hover .featured-card__image :global(img) {
    transform: scale(1.03);
  }
  .featured-card__body {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-surface);
  }

  @media (max-width: 640px) {
    .featured-card {
      grid-template-columns: 1fr;
    }
    .featured-card__image {
      min-height: 180px;
    }
  }
</style>
