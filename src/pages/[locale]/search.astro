---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const path = `/${locale}/search`;
const searchIndexUrl = withBase('/search-index.json');
---
<BaseLayout title={`${t('nav.search')} | ${SITE.name}`} description={t('page.searchDesc', { name: SITE.name })} path={path}>
  <section class="py-8 max-w-3xl mx-auto">
    <Breadcrumb locale={locale} items={[{ name: t('nav.search'), url: path }]} />
    <h1 class="text-[clamp(2rem,1rem+3vw,2.8rem)] font-display font-semibold mb-6 reveal">{t('nav.search')}</h1>

    <div class="mb-12 reveal reveal-delay-1">
      <input
        type="search"
        id="q"
        class="search-input"
        placeholder={t('search.placeholder')}
        autocomplete="off"
        aria-label={t('nav.search')}
        data-index={searchIndexUrl}
      />
      <p class="text-[0.85rem] text-[var(--color-text-secondary)] mt-3 mb-0" id="count"></p>
      <ul class="list-none p-0 m-0 flex flex-col gap-3 mt-5" id="results"></ul>
      <p class="text-[var(--color-text-secondary)]" id="empty" hidden></p>
    </div>
  </section>
</BaseLayout>

<style>
  .search-input {
    width: 100%;
    font-size: 1.05rem;
    font-family: var(--font-body);
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-text);
    transition: border-color 200ms var(--ease), box-shadow 200ms var(--ease);
  }
  .search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-muted);
  }
  .search-input::placeholder {
    color: var(--color-text-tertiary);
  }
</style>

<script>
  const input = document.getElementById('q') as HTMLInputElement;
  const results = document.getElementById('results') as HTMLUListElement;
  const count = document.getElementById('count') as HTMLParagraphElement;
  const empty = document.getElementById('empty') as HTMLParagraphElement;

  let index: { locale: string; category: string; title: string; description: string; tags: string[]; url: string }[] = [];
  const currentLocale = document.documentElement.lang?.startsWith('en') ? 'en' : 'zh';

  const indexUrl = (input as HTMLInputElement).dataset.index ?? '/search-index.json';
  fetch(indexUrl)
    .then((r) => r.json())
    .then((data) => { index = data; })
    .catch(() => {});

  function render(q: string) {
    const term = q.trim().toLowerCase();
    if (!term) { results.innerHTML = ''; count.textContent = ''; empty.hidden = true; return; }
    const hits = index
      .filter((p) => p.locale === currentLocale)
      .filter((p) =>
        p.title.toLowerCase().includes(term) ||
        p.description.toLowerCase().includes(term) ||
        p.tags.some((t) => t.toLowerCase().includes(term))
      )
      .slice(0, 20);
    count.textContent = `${hits.length} ${currentLocale === 'zh' ? '筆結果' : 'results'}`;
    empty.hidden = hits.length > 0;
    empty.textContent = currentLocale === 'zh' ? '沒有找到結果。' : 'No results found.';
    results.innerHTML = hits
      .map(
        (p) =>
          `<li><a href="${p.url}" class="search-result"><span class="text-[0.7rem] font-medium tracking-[0.08em] uppercase text-[var(--color-accent)]">${p.category}</span><span class="text-[1.05rem] text-[var(--color-text)] font-medium">${p.title}</span><span class="text-[0.88rem] text-[var(--color-text-secondary)]">${p.description}</span></a></li>`
      )
      .join('');
  }

  input?.addEventListener('input', (e) => render((e.target as HTMLInputElement).value));
</script>

<style is:global>
  .search-result {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color 200ms var(--ease), transform 200ms var(--ease), box-shadow 200ms var(--ease);
  }
  .search-result:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px -4px var(--color-accent-glow);
  }
</style>
