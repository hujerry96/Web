---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, postPath } from '../../lib/content';
import { getTools } from '../../lib/tools';
import { groupByTopic } from '../../lib/topics';
import { SITE, withBase, type Locale } from '../../consts';
import { Image } from 'astro:assets';
import appScreenshot from '../../assets/spectra-studio/interface.png';
import peakFitImage from '../../content/en/guides/spectra-studio-guide-en/examples/gaussian-peak-fitting.png';

export async function getStaticPaths() {
  const all = await getPosts();
  return (['zh', 'en'] as Locale[]).map((locale) => ({
    params: { locale },
    props: { posts: all.filter((p) => p.id.startsWith(`${locale}/`)) },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const { posts } = Astro.props as { posts: Awaited<ReturnType<typeof getPosts>> };
const zh = locale === 'zh';
const path = `/${locale}`;
const tools = getTools(locale);
const featuredTool = tools.find((tool) => tool.featured)!;
const sideTools = tools.filter((tool) => !tool.featured);
const groups = groupByTopic(posts);
const latest = posts.slice(0, 6);

const copy = zh
  ? {
      eyebrow: 'Hu Lab · 材料表徵分析工具',
      h1a: 'XRD、FTIR、Raman、UV-Vis',
      h1b: '光譜分析與論文繪圖工具',
      lead: '給材料研究者的免費 Windows 光譜軟體與分析教學：直接讀取儀器檔、尋峰與分峰擬合、計算晶粒尺寸與能隙，輸出可投稿的期刊圖。資料全程留在你的電腦。',
      primary: '免費下載 Spectra Studio',
      secondary: '閱讀分析教學',
      proof: ['免費版無浮水印', '不需 Origin / Python', '數據不上傳'],
      toolsEyebrow: '軟體與工具',
      toolsTitle: '從原始數據到投稿圖，一套工作流程',
      featuredCta: '查看功能與免費下載',
      guide: '使用指南',
      online: '線上工具',
      calcTitle: 'XRD 晶粒尺寸計算器',
      calcDesc: '輸入 2θ 與 FWHM，即時以 Scherrer 公式估算晶粒尺寸，可批次多峰、匯出 CSV 與圖表。',
      calcCta: '開啟計算器',
      topicsEyebrow: '分析教學',
      topicsTitle: '依分析方法找教學',
      topicsAll: '全部教學 →',
      latestEyebrow: '最新文章',
      latestTitle: '最近更新的教學與筆記',
      articles: '篇',
    }
  : {
      eyebrow: 'Hu Lab · Materials characterization tools',
      h1a: 'XRD, FTIR, Raman & UV-Vis',
      h1b: 'analysis and publication figures',
      lead: 'Free Windows spectroscopy software and practical guides for materials researchers: open instrument files, detect and fit peaks, calculate crystallite size and band gap, and export journal-ready figures — with your data kept on your own computer.',
      primary: 'Download Spectra Studio free',
      secondary: 'Browse analysis guides',
      proof: ['No watermark on Free', 'No Origin or Python', 'Data stays local'],
      toolsEyebrow: 'Software & tools',
      toolsTitle: 'One workflow from raw data to a submitted figure',
      featuredCta: 'See features & download free',
      guide: 'Guide',
      online: 'Online tool',
      calcTitle: 'XRD crystallite size calculator',
      calcDesc: 'Enter 2θ and FWHM to estimate Scherrer crystallite size instantly — multiple peaks, CSV export and a journal-style chart.',
      calcCta: 'Open calculator',
      topicsEyebrow: 'Analysis guides',
      topicsTitle: 'Find a guide by technique',
      topicsAll: 'All guides →',
      latestEyebrow: 'Latest',
      latestTitle: 'Recently published guides and notes',
      articles: 'guides',
    };

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Spectra Studio',
  applicationCategory: 'ScientificApplication',
  operatingSystem: 'Windows 10, Windows 11',
  url: `${SITE.url}/${locale}/spectra-studio`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---
<BaseLayout title={SITE.meta[locale].title} description={SITE.meta[locale].description} path={path} jsonLd={[softwareLd]} wide>

  <!-- ── Hero ── -->
  <section class="home-hero graph-paper">
    <div class="home-hero__inner">
      <div class="home-hero__copy">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1 class="home-hero__title">{copy.h1a}<span>{copy.h1b}</span></h1>
        <p class="home-hero__lead">{copy.lead}</p>
        <div class="home-hero__actions">
          <a class="btn btn--primary" href={withBase(`/${locale}/spectra-studio`)}>{copy.primary} <span aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href={withBase(`/${locale}/guides`)}>{copy.secondary}</a>
        </div>
        <ul class="home-hero__proof">
          {copy.proof.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <figure class="instrument" aria-label="Spectra Studio">
        <div class="instrument__bar" aria-hidden="true">
          <span class="instrument__dots"><i></i><i></i><i></i></span>
          <span>SPECTRA STUDIO · v2.2.2</span>
          <span class="instrument__status">● LIVE</span>
        </div>
        <Image src={appScreenshot} alt={zh ? 'Spectra Studio 實機畫面：XRD 數據與期刊樣式設定' : 'Spectra Studio interface showing XRD data with journal-style settings'} width={960} height={576} loading="eager" fetchpriority="high" class="instrument__screen" />
        <figcaption class="instrument__readout" aria-hidden="true">
          <span><b>λ</b> 1.5406 Å</span>
          <span><b>2θ</b> 10–80°</span>
          <span><b>FWHM</b> 0.42°</span>
          <span><b>EXPORT</b> 300 DPI</span>
        </figcaption>
      </figure>
    </div>
    <div class="technique-strip" aria-hidden="true">
      <span>XRD</span><span>FTIR</span><span>RAMAN</span><span>UV-VIS</span><span>DSC / TGA</span><span>SEM</span>
    </div>
  </section>

  <!-- ── Software ── -->
  <section class="home-section">
    <div class="section-head">
      <div><span class="eyebrow">{copy.toolsEyebrow}</span><h2>{copy.toolsTitle}</h2></div>
    </div>
    <div class="tool-grid">
      <a class="tool-featured" href={withBase(featuredTool.landing ?? featuredTool.guide)}>
        <span class="tool-code">01 · {featuredTool.tag}</span>
        <h3>{featuredTool.name}</h3>
        <p>{featuredTool.desc}</p>
        <ul>{featuredTool.points.map((point) => <li>{point}</li>)}</ul>
        <Image src={peakFitImage} alt={zh ? 'Spectra Studio 高斯分峰擬合結果，含擬合曲線與殘差' : 'Spectra Studio Gaussian peak-fitting output with fitted curve and residuals'} width={640} height={400} loading="lazy" class="tool-featured__img" />
        <span class="tool-link">{copy.featuredCta} →</span>
      </a>
      {sideTools.map((tool, i) => (
        <a class="tool-card" href={withBase(tool.guide)}>
          <span class="tool-code">{String(i + 2).padStart(2, '0')} · {tool.tag}</span>
          <h3>{tool.name}</h3>
          <p>{tool.desc}</p>
          <span class="tool-link">{copy.guide} →</span>
        </a>
      ))}
      <a class="tool-card" href={withBase(`/${locale}/tools/crystallite-size-calculator`)}>
        <span class="tool-code">{String(sideTools.length + 2).padStart(2, '0')} · {copy.online}</span>
        <h3>{copy.calcTitle}</h3>
        <p>{copy.calcDesc}</p>
        <span class="tool-link">{copy.calcCta} →</span>
      </a>
    </div>
  </section>

  <!-- ── Topics ── -->
  <section class="home-section">
    <div class="section-head">
      <div><span class="eyebrow">{copy.topicsEyebrow}</span><h2>{copy.topicsTitle}</h2></div>
      <a href={withBase(`/${locale}/guides`)}>{copy.topicsAll}</a>
    </div>
    <div class="topic-grid">
      {groups.map(({ topic, posts: topicPosts }) => (
        <section class="topic-card" aria-labelledby={`topic-${topic.id}`}>
          <div class="topic-card__head">
            <span class="tool-code">{topic.code}</span>
            <span class="topic-card__count">{topicPosts.length} {copy.articles}</span>
          </div>
          <h3 id={`topic-${topic.id}`}><a href={withBase(`/${locale}/guides#${topic.id}`)}>{topic.name[locale]}</a></h3>
          <p>{topic.desc[locale]}</p>
          <ul>
            {topicPosts.slice(0, 3).map((post) => <li><a href={postPath(post)}>{post.data.title}</a></li>)}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <!-- ── Latest ── -->
  <section class="home-section">
    <div class="section-head">
      <div><span class="eyebrow">{copy.latestEyebrow}</span><h2>{copy.latestTitle}</h2></div>
    </div>
    <div class="post-grid">
      {latest.map((post) => <ArticleCard post={post} locale={locale} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    border-bottom: 1px solid var(--color-border);
  }
  .home-hero__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5.5rem) 1.25rem clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }
  .home-hero__title {
    margin: 1rem 0 1.1rem;
    font-size: clamp(2rem, 1.2rem + 2.8vw, 3.15rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }
  .home-hero__title span { display: block; color: var(--color-accent); }
  .home-hero__lead { margin: 0 0 1.75rem; max-width: 34rem; font-size: 1.04rem; line-height: 1.75; color: var(--color-text-secondary); }
  .home-hero__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .home-hero__proof { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 1.4rem 0 0; padding: 0; list-style: none; font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-text-secondary); }
  .home-hero__proof li::before { content: '✓'; margin-right: 0.4rem; color: #16a34a; }

  .instrument { margin: 0; border: 1px solid var(--color-border-hover); border-radius: 10px; overflow: hidden; background: var(--color-surface); box-shadow: 0 1px 0 var(--color-border), 0 30px 60px -30px rgba(15, 27, 45, 0.35); }
  .instrument__bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.55rem 0.85rem; background: var(--color-ink-panel); color: #c9d3e3; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; }
  .instrument__dots { display: inline-flex; gap: 0.35rem; }
  .instrument__dots i { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: #3a465c; }
  .instrument__status { color: #4ade80; }
  .instrument__screen { width: 100%; height: auto; display: block; }
  .instrument__readout { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--color-border); font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-text-secondary); }
  .instrument__readout span { padding: 0.6rem 0.75rem; border-left: 1px solid var(--color-border); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .instrument__readout span:first-child { border-left: 0; }
  .instrument__readout b { margin-right: 0.35rem; font-weight: 600; color: var(--color-accent); }

  .technique-strip { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.25rem 2.25rem; padding: 0.9rem 1.25rem; border-top: 1px solid var(--color-border); background: var(--color-surface); font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.16em; color: var(--color-text-tertiary); }

  .home-section { max-width: 72rem; margin: 0 auto; padding: clamp(3rem, 6vw, 4.5rem) 0 0; }

  .tool-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 1rem; }
  .tool-featured, .tool-card { display: flex; flex-direction: column; gap: 0.55rem; padding: 1.4rem; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-surface); color: inherit; text-decoration: none; transition: border-color 200ms var(--ease), transform 200ms var(--ease), box-shadow 200ms var(--ease); }
  .tool-featured:hover, .tool-card:hover { border-color: var(--color-accent); transform: translateY(-2px); box-shadow: 0 10px 28px -14px var(--color-accent-glow); }
  .tool-featured { grid-row: span 3; position: relative; overflow: hidden; padding-top: 1.7rem; }
  .tool-featured::before { content: ''; position: absolute; inset: 0 0 auto; height: 3px; background: var(--spectrum); }
  .tool-featured h3 { font-size: 1.3rem; }
  .tool-featured ul { margin: 0.25rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.45rem; }
  .tool-featured li { position: relative; padding-left: 1.2rem; font-size: 0.88rem; color: var(--color-text-secondary); }
  .tool-featured li::before { content: '→'; position: absolute; left: 0; color: var(--color-accent); }
  .tool-featured__img { width: 100%; height: auto; margin-top: 0.75rem; border: 1px solid var(--color-border); border-radius: 6px; background: #fff; }
  .tool-code { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent); }
  .tool-featured h3, .tool-card h3 { margin: 0; font-size: 1.05rem; line-height: 1.35; }
  .tool-featured p, .tool-card p { margin: 0; font-size: 0.87rem; line-height: 1.65; color: var(--color-text-secondary); }
  .tool-link { margin-top: auto; padding-top: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-accent); }

  .topic-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .topic-card { padding: 1.4rem; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-surface); }
  .topic-card__head { display: flex; justify-content: space-between; gap: 1rem; }
  .topic-card__count { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-text-tertiary); }
  .topic-card h3 { margin: 0.6rem 0 0.35rem; font-size: 1.15rem; }
  .topic-card h3 a { color: var(--color-text); }
  .topic-card h3 a:hover { color: var(--color-accent); }
  .topic-card p { margin: 0 0 0.9rem; font-size: 0.87rem; line-height: 1.65; color: var(--color-text-secondary); }
  .topic-card ul { margin: 0; padding: 0.85rem 0 0; list-style: none; border-top: 1px dashed var(--color-border); display: grid; gap: 0.5rem; }
  .topic-card li a { display: block; font-size: 0.88rem; line-height: 1.5; color: var(--color-text); }
  .topic-card li a::before { content: '›'; margin-right: 0.45rem; color: var(--color-accent); }
  .topic-card li a:hover { color: var(--color-accent); }

  .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 1rem; }

  @media (max-width: 900px) {
    .home-hero__inner { grid-template-columns: 1fr; }
    .tool-grid { grid-template-columns: 1fr; }
    .tool-featured { grid-row: auto; }
  }
  @media (max-width: 640px) {
    .topic-grid { grid-template-columns: 1fr; }
    .instrument__readout { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .instrument__readout span:nth-child(3) { border-left: 0; }
    .instrument__readout span:nth-child(n + 3) { border-top: 1px solid var(--color-border); }
    .technique-strip { gap: 0.25rem 1.25rem; }
  }
</style>
