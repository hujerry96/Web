---
import '../styles/global.css';
import { SITE } from '../consts';
import { HREFLANG } from '../i18n/config';
import type { Post } from '../lib/content';
import { buildCanonical, buildHreflang, articleLd, breadcrumbLd, websiteLd } from '../lib/seo';
import Meta from '../components/seo/Meta.astro';
import OpenGraph from '../components/seo/OpenGraph.astro';
import TwitterCard from '../components/seo/TwitterCard.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  path: string;
  post?: Post | null;
  type?: 'website' | 'article';
  breadcrumb?: { name: string; url: string }[];
  wide?: boolean;
}

const { title, description, path, post = null, type = post ? 'article' : 'website', breadcrumb, wide = false } = Astro.props;
const locale = (path.startsWith('/en') ? 'en' : 'zh') as keyof typeof HREFLANG;
const t = useTranslations(locale);
const url = `${SITE.url}${path}`;
const canonical = buildCanonical(post, path);
const hreflang = buildHreflang(post, path);
const image = post?.data.cover ? post.data.cover.src : `${SITE.url}/images/og-default.png`;

const jsonLd: Record<string, unknown>[] = [];
if (post) jsonLd.push(articleLd(post, url));
if (breadcrumb && breadcrumb.length > 0) jsonLd.push(breadcrumbLd(breadcrumb, SITE.url));
if (/^\/(en|zh)?$/.test(path)) jsonLd.push(websiteLd());
---
<!doctype html>
<html lang={HREFLANG[locale]}>
  <head>
    <Meta title={title} description={description} canonical={canonical} path={path} hreflang={hreflang}
      published={post?.data.date.toISOString()} modified={post?.data.updated?.toISOString()} />
    <OpenGraph title={title} description={description} url={url} image={image} locale={HREFLANG[locale]} siteName={SITE.name} type={type} />
    <TwitterCard title={title} description={description} image={image} twitter={SITE.twitter} />
    {jsonLd.length > 0 && <JsonLd data={jsonLd} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
    <script>
      (function() {
        const saved = localStorage.getItem('theme');
        const prefers = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', saved || prefers);
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t('a11y.skip')}</a>
    <Header path={path} locale={locale} />
    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
    <main id="main-content" class={`mx-auto px-5 ${wide ? 'max-w-6xl' : 'max-w-4xl'}`}>
      <slot />
    </main>
    <Footer locale={locale} />
    <button class="back-to-top" id="back-to-top" aria-label={t('a11y.top')}>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12V4M4 7l4-4 4 4"/></svg>
    </button>
  <script>
    // ── Back to top ──
    const btn = document.getElementById('back-to-top');
    if (btn) {
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            btn.classList.toggle('is-visible', window.scrollY > 400);
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // ── Theme toggle ──
    const toggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    if (toggle) {
      const icon = toggle.querySelector('.tt-icon');
      const updateIcon = () => {
        const isDark = html.getAttribute('data-theme') === 'dark';
        if (icon) icon.textContent = isDark ? '☀' : '☾';
      };
      updateIcon();
      toggle.addEventListener('click', () => {
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateIcon();
      });
    }

    // ── Reading progress ──
    const bar = document.getElementById('reading-progress');
    if (bar) {
      let ticking = false;
      const update = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        const p = max > 0 ? Math.min(1, h.scrollTop / max) : 0;
        bar.style.transform = `scaleX(${p})`;
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(update); ticking = true; }
      }, { passive: true });
      update();
    }

    // ── Scroll reveal（無 JS / IO 失敗時內容仍可見；僅在 JS 成功時套用隱藏動畫）──
    if ('IntersectionObserver' in window) {
      const reveals = document.querySelectorAll('.reveal');
      if (reveals.length) {
        document.documentElement.classList.add('reveal-init');
        const show = (el) => el.classList.add('revealed');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              show(e.target);
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        reveals.forEach((el) => {
          // 已在視口內的元素立即顯示，不依賴 IO 回呼排程
          if (el.getBoundingClientRect().top < window.innerHeight) show(el);
          else io.observe(el);
        });
        // 保險：任何情況下 6 秒後全部顯示（動畫早已淡入，使用者無感）
        setTimeout(() => reveals.forEach(show), 6000);
      }
    }

    // ── Frosted glass header ──
    const header = document.getElementById('site-header');
    if (header) {
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            header.classList.toggle('is-scrolled', window.scrollY > 20);
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
    }
  </script>
  </body>
</html>
