---
import { SITE, withBase } from '../consts';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import LangSwitch from './LangSwitch.astro';

interface Props { path: string; locale: Locale; }
const { path, locale } = Astro.props;
const t = useTranslations(locale);

type NavItem = { href: string; key: Parameters<typeof t>[0] };

const nav: NavItem[] = locale === 'zh'
  ? [
      { href: '/zh/ai', key: 'nav.ai' },
      { href: '/zh/shopee', key: 'nav.shopee' },
      { href: '/zh/python', key: 'nav.python' },
      { href: '/zh/reviews', key: 'nav.reviews' },
      { href: '/zh/blog', key: 'nav.blog' },
    ]
  : [
      { href: '/en/books', key: 'nav.books' },
      { href: '/en/study', key: 'nav.study' },
      { href: '/en/blog', key: 'nav.blog' },
      { href: '/en/lab', key: 'nav.lab' },
      { href: '/en/printable', key: 'nav.printable' },
      { href: '/en/engineering', key: 'nav.engineering' },
    ];
const staticLinks: NavItem[] = [
  { href: `/${locale}/free-resources`, key: 'nav.free' },
  { href: `/${locale}/about`, key: 'nav.about' },
  { href: `/${locale}/contact`, key: 'nav.contact' },
];
---
<header class="site-header" id="site-header">
  <div class="container header-top">
    <button class="hamburger" id="hamburger" aria-label={t('nav.home')}>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
    <a href={withBase(`/${locale}`)} class="brand">{SITE.name}</a>
    <div class="header-actions">
      <button class="theme-toggle" id="theme-toggle" aria-label="切換深色模式">🌙</button>
      <LangSwitch path={path} locale={locale} />
    </div>
  </div>
  <nav class="container nav" aria-label="primary">
    {nav.map((item) => <a href={withBase(item.href)}>{t(item.key)}</a>)}
    <span class="nav-sep" aria-hidden="true"></span>
    {staticLinks.map((item) => <a href={withBase(item.href)} class="muted-link">{t(item.key)}</a>)}
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const hamburger = document.getElementById('hamburger');
  if (header && hamburger) {
    hamburger.addEventListener('click', () => {
      header.classList.toggle('nav-open');
    });
    // 點擊導覽連結後自動關閉選單
    header.querySelectorAll('.nav a').forEach((link) => {
      link.addEventListener('click', () => {
        header.classList.remove('nav-open');
      });
    });
  }
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: rgba(250, 246, 240, 0.85);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    backdrop-filter: saturate(180%) blur(8px);
  }
  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .brand {
    font-weight: var(--font-weight-bold);
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }
  .brand::after {
    content: '';
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    margin-left: 0.3rem;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    vertical-align: middle;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-bottom: var(--space-3);
    border-top: 1px solid var(--color-border);
    margin-top: -1px;
  }
  .nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    transition: color var(--duration-fast) ease;
  }
  .nav a:hover { color: var(--color-accent); }
  .nav .muted-link { color: var(--color-text-muted); font-weight: var(--font-weight-normal); }
  .nav .muted-link:hover { color: var(--color-accent); }
  .nav-sep {
    flex: 1 1 auto;
    min-width: var(--space-4);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
</style>
