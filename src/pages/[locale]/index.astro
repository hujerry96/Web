---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, readingTime } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const all = await getPosts();
  const locales = ['zh', 'en'] as Locale[];
  return locales.map((locale) => {
    const posts = all.filter((p) => p.id.startsWith(`${locale}/`));
    return { params: { locale }, props: { posts } };
  });
}

const { locale } = Astro.params as { locale: Locale };
const { posts } = Astro.props as { posts: any[] };
const t = useTranslations(locale);
const path = `/${locale}`;

const projects = posts.filter((p) => p.data.project).slice(0, 2);
const latest = posts.slice(0, 6);
const catCounts: Record<string, number> = {};
for (const p of posts) { const c = p.id.split('/')[1]; catCounts[c] = (catCounts[c] ?? 0) + 1; }
const cats = SITE.categories[locale] as Record<string, string>;
---
<BaseLayout title={SITE.meta[locale].title} description={SITE.meta[locale].description} path={path} wide>

  <!-- ── FFT Hero ── -->
  <section class="hero" id="hero">
    <canvas class="hero-canvas" id="hero-canvas" aria-hidden="true"></canvas>
    <!-- TEM/FFT annotation overlays -->
    <div class="hero-anno hero-anno--tl" aria-hidden="true">
      <span class="anno-key">FFT</span>
      <span class="anno-val">[1<span class="unit">⁻¹</span>/<span class="unit">nm</span>]</span>
    </div>
    <div class="hero-anno hero-anno--tr" aria-hidden="true">
      <span class="anno-key">hkl</span>
      <span class="anno-val">{`{220}`}</span>
    </div>
    <div class="hero-scale" aria-hidden="true">
      <span class="scale-line"></span>
      <span class="scale-label">2 1/nm</span>
    </div>
    <div class="hero-content">
      <span class="hero-badge">{t('home.tagline')}</span>
      <h1 class="hero-title">{SITE.name}</h1>
      <p class="hero-desc">{t('home.intro')}</p>
      <div class="hero-cats">
        {Object.entries(cats).map(([key, name]) => (
          <a href={withBase(`/${locale}/${key}`)} class="hero-cat">
            <span class="hero-cat-name">{name}</span>
            <span class="hero-cat-count">{String(catCounts[key] ?? 0).padStart(2,'0')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Projects ── -->
  {projects.length > 0 && (
    <section class="section reveal">
      <h2 class="section-label">{t('home.projects')}</h2>
      <div class="project-grid">
        {projects.map((post) => {
          const cat = post.id.split('/')[1];
          const catName = cats[cat] ?? cat;
          const slug = post.data.slug ?? post.id.split('/').slice(2).join('/');
          return (
            <a href={withBase(`/${locale}/${cat}/${slug}`)} class="project-card group">
              <div class="project-card__image">
                {post.data.cover
                  ? <Image src={post.data.cover} alt={post.data.title} width={640} height={400} class="w-full h-full object-cover" loading="lazy" />
                  : <div class="w-full h-full flex items-center justify-center bg-[var(--color-accent-muted)] text-[var(--color-accent)] text-sm">{catName}</div>
                }
              </div>
              <div class="project-card__body">
                <span class="project-card__cat">{catName}</span>
                <h3 class="project-card__title">{post.data.title}</h3>
                <p class="project-card__desc">{post.data.description}</p>
                <div class="project-card__meta">
                  <span>{post.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</span>
                  <span class="opacity-40">·</span>
                  <span>{readingTime(post.body, locale)}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- ── Latest posts ── -->
  <section class="section reveal reveal-delay-1">
    <h2 class="section-label">{t('home.latest')}</h2>
    <div class="post-grid">
      {latest.map((post) => (
        <ArticleCard post={post} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 4rem;
    width: 100vw;
    max-width: none;
    margin-left: calc(-50vw + 50% - 1.25rem);
    background:
      radial-gradient(ellipse 70% 60% at 50% 50%, rgba(91,141,239,0.04), transparent 70%),
      var(--color-bg);
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 640px;
  }
  .hero-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-accent-muted);
    border-radius: 4px;
    background: var(--color-accent-muted);
    margin-bottom: 1.5rem;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.4rem + 5vw, 4.2rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    margin: 0 0 1.25rem;
    color: var(--color-text);
  }
  .hero-desc {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.15rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 480px;
    margin: 0 auto 2.5rem;
  }
  .hero-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .hero-cat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: all 200ms var(--ease);
  }
  .hero-cat:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-muted);
  }
  .hero-cat-count {
    font-size: 0.7rem;
    opacity: 0.55;
    font-variant-numeric: tabular-nums;
  }

  /* ── TEM annotations (corners + scale bar) ── */
  .hero-anno {
    position: absolute;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-text-tertiary);
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    letter-spacing: 0.04em;
    pointer-events: none;
    opacity: 0.7;
  }
  .hero-anno--tl { top: 1.3rem; left: 1.5rem; }
  .hero-anno--tr { top: 1.3rem; right: 1.5rem; }
  .anno-key {
    color: var(--color-accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .anno-val { font-variant-numeric: tabular-nums; }
  .unit { opacity: 0.7; }
  .hero-scale {
    position: absolute;
    bottom: 2rem;
    left: 1.5rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-text-tertiary);
    pointer-events: none;
    opacity: 0.7;
  }
  .scale-line {
    display: inline-block;
    width: 56px;
    height: 2px;
    background: var(--color-text-tertiary);
    position: relative;
  }
  .scale-line::before, .scale-line::after {
    content: '';
    position: absolute;
    top: -3px;
    width: 2px;
    height: 8px;
    background: var(--color-text-tertiary);
  }
  .scale-line::before { left: 0; }
  .scale-line::after { right: 0; }
  .scale-label { letter-spacing: 0.04em; }

  /* ── Sections ── */
  .section {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin: 0 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .section-label::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
  }

  /* ── Project cards ── */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 280ms var(--ease), box-shadow 280ms var(--ease), transform 280ms var(--ease);
    background: var(--color-surface);
  }
  .project-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 12px 40px -10px var(--color-accent-glow), 0 4px 12px rgba(0,0,0,0.15);
    transform: translateY(-3px);
  }
  .project-card__image {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--color-surface-raised);
  }
  .project-card__image :global(img) {
    transition: transform 500ms var(--ease);
  }
  .project-card:hover .project-card__image :global(img) {
    transform: scale(1.04);
  }
  .project-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }
  .project-card__cat {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }
  .project-card__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    color: var(--color-text);
    transition: color 200ms var(--ease);
  }
  .project-card:hover .project-card__title {
    color: var(--color-accent);
  }
  .project-card__desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-card__meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--color-text-tertiary);
    margin-top: auto;
    padding-top: 0.75rem;
  }

  /* ── Post grid ── */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
    .hero {
      min-height: 80vh;
      padding: 4rem 1.5rem 3rem;
    }
    .hero-anno--tl { top: 0.9rem; left: 1rem; }
    .hero-anno--tr { top: 0.9rem; right: 1rem; }
    .hero-scale { bottom: 1rem; left: 1rem; }
  }
  @media (min-width: 72rem) {
    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 2;
      background: radial-gradient(ellipse at center, transparent 58%, var(--color-bg) 100%);
    }
  }
</style>

<script>
  // ── FFT spot lattice canvas ──
  // TEM-like Fourier-transform diffraction pattern:
  // reciprocal-lattice spots rendered as gaussian blobs whose intensity
  // falls off with distance from the optical centre (frequency envelope).
  // Slow sample drift + cursor-induced local diffraction-ring brightening.
  (function() {
    const canvas = document.getElementById('hero-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let w, h, spots = [];
    const mouse = { x: -9999, y: -9999, active: false };
    let time = 0;
    let cx = 0, cy = 0; // optical centre

    // ── Colour helpers (read token; sample once per rebuild) ──
    function getAccent() {
      return getComputedStyle(document.documentElement)
        .getPropertyValue('--color-accent').trim() || '#5b8def';
    }
    function getSpotColor() {
      // Use --color-spot for the bright spot core; fall back to accent.
      return getComputedStyle(document.documentElement)
        .getPropertyValue('--color-spot').trim() || '#cfe0ff';
    }
    function getBg() {
      return getComputedStyle(document.documentElement)
        .getPropertyValue('--color-bg').trim() || '#08090c';
    }
    function hexToRgb(hex) {
      return {
        r: parseInt(hex.slice(1,3), 16),
        g: parseInt(hex.slice(3,5), 16),
        b: parseInt(hex.slice(5,7), 16),
      };
    }

    // ── Resize ──
    function resize() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = w / 2;
      cy = h / 2;
    }

    // ── Build reciprocal-lattice spots ──
    // Square grid of spots; intensity = base × envelope(freq distance)
    function createSpots() {
      spots = [];
      const accent = hexToRgb(getAccent());
      const spotC = hexToRgb(getSpotColor());

      // Spot spacing chosen so the lattice reads as a diffraction pattern.
      const SPACING = 46;
      const cols = Math.ceil(w / SPACING) + 4;
      const rows = Math.ceil(h / SPACING) + 4;
      const startX = cx - ((cols - 1) * SPACING) / 2;
      const startY = cy - ((rows - 1) * SPACING) / 2;
      const maxR = Math.sqrt(cx * cx + cy * cy);

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x0 = startX + c * SPACING;
          const y0 = startY + r * SPACING;
          // Skip spots far outside viewport (kept some margin so envelope decays naturally).
          if (x0 < -SPACING || x0 > w + SPACING || y0 < -SPACING || y0 > h + SPACING) continue;
          // Distance from optical centre — the FFT frequency coordinate.
          const ddx = x0 - cx;
          const ddy = y0 - cy;
          const dist = Math.sqrt(ddx * ddx + ddy * ddy);
          // Gaussian envelope: bright at centre, falls off.
          const env = Math.exp(-(dist * dist) / (2 * (maxR * 0.46) * (maxR * 0.46)));
          // Skip the dim outer ones entirely for perf.
          if (env < 0.012) continue;
          // Central spot is the transmitted beam → brightest.
          const central = dist < SPACING * 0.5;
          const baseI = central ? 0.95 : (0.08 + 0.78 * env);
          // Gaussian spot radius (scales with intensity a touch, central = bigger).
          const sigma = central ? 3.2 : (1.5 + 1.1 * env);
          spots.push({
            x0, y0, x: x0, y: y0,
            dx: 0, dy: 0,
            sigma, baseI, I: baseI,
            accent, spotC,
            // Per-spot drift phase (sample drift / beam shift).
            ph: Math.random() * Math.PI * 2,
            phY: Math.random() * Math.PI * 2,
            f: 0.0009 + Math.random() * 0.0012,
            amp: 1.4 + Math.random() * 1.8,
            // Twinkle (intensity flicker, very slow).
            tPh: Math.random() * Math.PI * 2,
            tF: 0.003 + Math.random() * 0.004,
          });
        }
      }
    }

    // ── Draw a gaussian spot via radial gradient (cached-by-rebuild palette) ──
    function drawSpot(p) {
      const x = p.x + p.dx;
      const y = p.y + p.dy;
      const I = p.I;
      if (I < 0.01) return;
      const R = p.sigma * 3.2;
      const sc = p.spotC, ac = p.accent;
      // Outer ring in accent (cool steel-blue), core in bright spot colour.
      const g = ctx.createRadialGradient(x, y, 0, x, y, R);
      g.addColorStop(0, `rgba(${sc.r},${sc.g},${sc.b},${(I * 0.95).toFixed(3)})`);
      g.addColorStop(0.35, `rgba(${ac.r},${ac.g},${ac.b},${(I * 0.55).toFixed(3)})`);
      g.addColorStop(1, `rgba(${ac.r},${ac.g},${ac.b},0)`);
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(x, y, R, 0, Math.PI * 2);
      ctx.fill();
    }

    // ── Draw ──
    function draw() {
      ctx.clearRect(0, 0, w, h);
      for (const p of spots) drawSpot(p);
    }

    // ── Update ──
    function update() {
      time++;
      for (const p of spots) {
        // Slow sample drift (sine, bounded amplitude).
        p.x = p.x0 + Math.sin(time * p.f + p.ph) * p.amp;
        p.y = p.y0 + Math.cos(time * p.f * 0.8 + p.phY) * p.amp;

        // Twinkle.
        let I = p.baseI * (0.85 + 0.15 * Math.sin(time * p.tF + p.tPh));

        // Cursor: local diffraction-ring brightening (ripple). Spots near cursor
        // brighten as if the beam is exciting a local reflection.
        if (mouse.active) {
          const sx = p.x + p.dx;
          const sy = p.y + p.dy;
          const dx = sx - mouse.x;
          const dy = sy - mouse.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          // Ring peaks at ~70px radius (Ewald-shell flavour).
          const RING = 70;
          const W = 36;
          const ring = Math.exp(-((d - RING) * (d - RING)) / (2 * W * W));
          // Plus a near-field push (spot displacement).
          if (d < 140 && d > 0.5) {
            const push = (1 - d / 140) * 3.2;
            const ang = Math.atan2(dy, dx);
            p.dx += Math.cos(ang) * push;
            p.dy += Math.sin(ang) * push;
            I += ring * 0.45;
          } else {
            I += ring * 0.3;
          }
        }
        p.dx *= 0.9;
        p.dy *= 0.9;
        p.I = Math.min(1.2, I);
      }
      draw();
      requestAnimationFrame(update);
    }

    // ── Events ──
    function handleMouse(e) {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.active = true;
    }
    function handleLeave() {
      mouse.active = false;
      mouse.x = -9999;
      mouse.y = -9999;
    }
    function handleResize() {
      resize();
      createSpots();
    }

    // ── Re-read palette on theme toggle ──
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        setTimeout(createSpots, 60);
      });
    }

    // ── Init ──
    resize();
    createSpots();
    update();
    window.addEventListener('resize', handleResize);
    window.addEventListener('mousemove', handleMouse);
    window.addEventListener('mouseleave', handleLeave);
  })();
</script>
