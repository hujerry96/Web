---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const path = `/${locale}/tools`;

const tools = [
  {
    name: locale === 'zh' ? 'SEM 粒徑分析工具' : 'SEM Particle Analyzer',
    tag: 'Particle Analyzer',
    desc:
      locale === 'zh'
        ? '從 SEM 影像自動量測顆粒與孔洞的粒徑分布，支援 Watershed 與 Hough 圓形偵測雙演算法，可直接校正比例尺並匯出統計報表。'
        : 'Measure particle and pore size distributions from SEM images automatically. Two algorithms (Watershed and Hough Circle), interactive scale calibration, and exportable statistics.',
    points:
      locale === 'zh'
        ? ['Watershed 分割重疊顆粒', 'Hough 圓形偵測圓形顆粒', '互動校正 SEM 比例尺', '匯出 CSV / 統計 / 分布圖']
        : ['Watershed for overlapping particles', 'Hough Circle for round particles', 'Interactive SEM scale-bar calibration', 'Export CSV / stats / distribution plot'],
    repo: 'https://github.com/hujerry96/particle-analyzer',
    lang: locale === 'zh' ? '中文 / English' : '中文 / English',
    guide: locale === 'zh' ? '/zh/guides/particle-analyzer-guide' : '/en/guides/particle-analyzer-guide-en',
  },
  {
    name: locale === 'zh' ? '論文格式修正工具' : 'Thesis Format Fixer',
    tag: 'Thesis Formatter',
    desc:
      locale === 'zh'
        ? '一鍵修正 Word 碩博士論文格式：頁碼、圖表編號、標題階層、參考文獻與封面，規則以 YAML 設定，GUI 拖檔即用。'
        : 'One-click fix for Word thesis formatting: page numbers, figure/table numbering, heading levels, references, and cover. Rules live in YAML, and the GUI takes a drag-and-drop file.',
    points:
      locale === 'zh'
        ? ['頁碼羅馬/阿拉伯自動切換', '圖表編號與標題統一', '標題階層與縮排修正', '參考文獻交叉參照']
        : ['Auto Roman/Arabic page numbers', 'Unified figure & table numbering', 'Heading levels and indents', 'Reference cross-references'],
    repo: 'https://github.com/hujerry96/thesis-formatter',
    lang: locale === 'zh' ? '中文 / English' : '中文 / English',
    guide: locale === 'zh' ? '/zh/guides/thesis-formatter-guide' : '/en/guides/thesis-formatter-guide-en',
  },
];
---
<BaseLayout title={`${t('nav.tools')} | ${SITE.name}`} description={t('page.toolsDesc', { name: SITE.name })} path={path}>
  <section class="py-8 max-w-4xl mx-auto">
    <Breadcrumb locale={locale} items={[{ name: t('nav.tools'), url: path }]} />
    <h1 class="text-[clamp(2rem,1rem+3vw,2.8rem)] font-display font-semibold mb-4 reveal">{t('nav.tools')}</h1>
    <article class="prose mb-8 reveal reveal-delay-1">
      <p>{t('page.toolsDesc')}</p>
    </article>

    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,360px),1fr))] gap-6 reveal reveal-delay-2">
      {tools.map((tool) => (
        <section class="tool-card">
          <div class="tool-card__header">
            <span class="text-[0.7rem] font-medium tracking-[0.1em] uppercase text-[var(--color-accent)]">{tool.tag}</span>
          </div>
          <div class="tool-card__body">
            <h2 class="text-[1.25rem] font-display font-semibold m-0 mb-2">{tool.name}</h2>
            <p class="text-[var(--color-text-secondary)] m-0 mb-4 leading-relaxed">{tool.desc}</p>
            <ul class="list-none p-0 m-0 mb-5 grid gap-1.5">
              {tool.points.map((p) => (
                <li class="relative pl-5 text-[0.9rem] text-[var(--color-text)]">
                  <span class="absolute left-0 text-[var(--color-accent)]">→</span>
                  {p}
                </li>
              ))}
            </ul>
            <div class="flex items-center justify-between border-t border-[var(--color-border-subtle)] pt-4">
              <span class="text-[0.78rem] text-[var(--color-text-tertiary)]">{tool.lang}</span>
              <span class="flex gap-4 flex-wrap">
                <a class="text-[var(--color-accent)] text-[0.85rem] font-medium hover:text-[var(--color-accent-dim)] transition-colors duration-200" href={withBase(tool.guide)}>{locale === 'zh' ? '使用指南' : 'Guide'} →</a>
                <a class="text-[var(--color-accent)] text-[0.85rem] font-medium hover:text-[var(--color-accent-dim)] transition-colors duration-200" href={tool.repo} target="_blank" rel="noopener">GitHub →</a>
              </span>
            </div>
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .tool-card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
    transition: border-color 400ms var(--ease-out), box-shadow 400ms var(--ease-out), transform 400ms var(--ease-out-expo);
  }
  .tool-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-5px) scale(1.01);
    box-shadow: 0 12px 32px -8px var(--color-accent-glow), 0 4px 12px rgba(0,0,0,0.15);
  }
  .tool-card:active {
    transform: scale(0.98);
    transition-duration: 100ms;
  }
  .tool-card__header {
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-muted);
  }
  .tool-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
  }
</style>
