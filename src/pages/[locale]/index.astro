---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, readingTime } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const all = await getPosts();
  const locales = ['zh', 'en'] as Locale[];
  return locales.map((locale) => {
    const posts = all.filter((p) => p.id.startsWith(`${locale}/`));
    return { params: { locale }, props: { posts } };
  });
}

const { locale } = Astro.params as { locale: Locale };
const { posts } = Astro.props as { posts: any[] };
const t = useTranslations(locale);
const path = `/${locale}`;

const projects = posts.filter((p) => p.data.project).slice(0, 2);
const latest = posts.slice(0, 6);
const catCounts: Record<string, number> = {};
for (const p of posts) { const c = p.id.split('/')[1]; catCounts[c] = (catCounts[c] ?? 0) + 1; }
const cats = SITE.categories[locale] as Record<string, string>;
---
<BaseLayout title={SITE.meta[locale].title} description={SITE.meta[locale].description} path={path} wide>

  <!-- ── Particle Hero ── -->
  <section class="hero" id="hero">
    <canvas class="hero-canvas" id="hero-canvas" aria-hidden="true"></canvas>
    <div class="hero-content">
      <span class="hero-badge">{t('home.tagline')}</span>
      <h1 class="hero-title">Hu Lab</h1>
      <p class="hero-desc">{t('home.intro')}</p>
      <div class="hero-cats">
        {Object.entries(cats).map(([key, name]) => (
          <a href={withBase(`/${locale}/${key}`)} class="hero-cat">
            {name}
            <span class="hero-cat-count">{catCounts[key] ?? 0}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Projects ── -->
  {projects.length > 0 && (
    <section class="section reveal">
      <h2 class="section-label">{t('home.projects')}</h2>
      <div class="project-grid">
        {projects.map((post) => {
          const cat = post.id.split('/')[1];
          const catName = cats[cat] ?? cat;
          const slug = post.data.slug ?? post.id.split('/').slice(2).join('/');
          return (
            <a href={withBase(`/${locale}/${cat}/${slug}`)} class="project-card group">
              <div class="project-card__image">
                {post.data.cover
                  ? <Image src={post.data.cover} alt={post.data.title} width={640} height={400} class="w-full h-full object-cover" loading="lazy" />
                  : <div class="w-full h-full flex items-center justify-center bg-[var(--color-accent-muted)] text-[var(--color-accent)] text-sm">{catName}</div>
                }
              </div>
              <div class="project-card__body">
                <span class="project-card__cat">{catName}</span>
                <h3 class="project-card__title">{post.data.title}</h3>
                <p class="project-card__desc">{post.data.description}</p>
                <div class="project-card__meta">
                  <span>{post.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</span>
                  <span class="opacity-40">·</span>
                  <span>{readingTime(post.body, locale)}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- ── Latest posts ── -->
  <section class="section reveal reveal-delay-1">
    <h2 class="section-label">{t('home.latest')}</h2>
    <div class="post-grid">
      {latest.map((post) => (
        <ArticleCard post={post} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 4rem;
    /* Break out of parent max-w container */
    width: 100vw;
    max-width: none;
    margin-left: calc(-50vw + 50% - 1.25rem);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle, var(--color-border-subtle) 0.5px, transparent 0.5px);
    background-size: 32px 32px;
    opacity: 0.5;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 640px;
  }
  .hero-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 1.5rem + 6vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 1rem;
    color: var(--color-text);
  }
  .hero-desc {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.2rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 480px;
    margin: 0 auto 2rem;
  }
  .hero-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .hero-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: all 200ms var(--ease);
  }
  .hero-cat:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-muted);
  }
  .hero-cat-count {
    font-size: 0.7rem;
    opacity: 0.6;
  }

  /* ── Sections ── */
  .section {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }
  .section-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin: 0 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .section-label::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
  }

  /* ── Project cards ── */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 280ms var(--ease), box-shadow 280ms var(--ease), transform 280ms var(--ease);
    background: var(--color-surface);
  }
  .project-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 12px 40px -10px var(--color-accent-glow), 0 4px 12px rgba(0,0,0,0.15);
    transform: translateY(-3px);
  }
  .project-card__image {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--color-surface-raised);
  }
  .project-card__image :global(img) {
    transition: transform 500ms var(--ease);
  }
  .project-card:hover .project-card__image :global(img) {
    transform: scale(1.04);
  }
  .project-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }
  .project-card__cat {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .project-card__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    color: var(--color-text);
    transition: color 200ms var(--ease);
  }
  .project-card:hover .project-card__title {
    color: var(--color-accent);
  }
  .project-card__desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-card__meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--color-text-tertiary);
    margin-top: auto;
    padding-top: 0.75rem;
  }

  /* ── Post grid ── */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
    .hero {
      min-height: 80vh;
      padding: 4rem 1.5rem 3rem;
    }
  }
  @media (min-width: 72rem) {
    /* Subtle radial edge fade so particles don't clip harshly at viewport edges */
    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 2;
      background: radial-gradient(ellipse at center, transparent 60%, var(--color-bg) 100%);
    }
  }
</style>

<script>
  // ── Crystal lattice canvas ──
  // Hexagonal (triangular) lattice with bond connections, phonon wave
  // undulation, and cursor ripple. Inspired by TEM lattice imaging.
  (function() {
    const canvas = document.getElementById('hero-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let w, h, lattice = [], bonds = [], fireflies = [], dust = [];
    const mouse = { x: -9999, y: -9999, prevX: -9999, prevY: -9999 };
    let time = 0;

    // ── Colour helpers ──
    function getAccent() {
      const style = getComputedStyle(document.documentElement);
      return style.getPropertyValue('--color-accent').trim() || '#6c8cff';
    }
    function hexToRgb(hex) {
      const r = parseInt(hex.slice(1,3), 16);
      const g = parseInt(hex.slice(3,5), 16);
      const b = parseInt(hex.slice(5,7), 16);
      return { r, g, b };
    }

    // Science-inspired palette
    const COPPER = { r: 232, g: 168, b: 124 };
    const TEAL  = { r: 94,  g: 234, b: 212 };
    const CYAN  = { r: 0,   g: 212, b: 170 };
    const WHITE = { r: 255, g: 255, b: 255 };
    const GOLD  = { r: 234, g: 200, b: 80 };
    const PALETTE = ['accent', 'teal', 'cyan', 'copper', 'white'];
    function pickColor(accent) {
      const t = PALETTE[Math.floor(Math.random() * PALETTE.length)];
      if (t === 'teal') return TEAL;
      if (t === 'cyan') return CYAN;
      if (t === 'copper') return COPPER;
      if (t === 'white') return WHITE;
      return accent;
    }

    // ── Resize ──
    function resize() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      w = rect.width;
      h = rect.height;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // ── Build triangular lattice ──
    function createParticles() {
      lattice = [];
      bonds = [];
      fireflies = [];
      dust = [];
      const accent = hexToRgb(getAccent());

      const SPACING = 36;
      const ROW_SP = SPACING * 0.866; // sqrt(3)/2
      const JITTER = 2.5;

      const rows = Math.ceil(h / ROW_SP) + 4;
      const cols = Math.ceil(w / SPACING) + 4;
      const grid = [];

      for (let r = -2; r < rows; r++) {
        const offX = (r & 1) * SPACING * 0.5;
        for (let c = -2; c < cols; c++) {
          const px = c * SPACING + offX + (Math.random() - 0.5) * JITTER;
          const py = r * ROW_SP + (Math.random() - 0.5) * JITTER;
          const edge = px < 0 || px > w || py < 0 || py > h;
          const size = edge ? 0.8 + Math.random() * 0.6 : 1.5 + Math.random() * 1.0;
          const baseOp = edge ? 0.03 + Math.random() * 0.05 : 0.08 + Math.random() * 0.1;
          const color = pickColor(accent);
          const idx = lattice.length;
          lattice.push({
            x: px, y: py, baseX: px, baseY: py,
            size, baseOpacity: baseOp, opacity: baseOp, color,
            dx: 0, dy: 0, row: r, col: c,
            wPhX: (px * 0.006 + py * 0.004) % (Math.PI * 2),
            wPhY: (px * 0.004 + py * 0.006) % (Math.PI * 2),
          });
          grid.push({ r, c, idx });
        }
      }

      // Pre-compute bonds (triangular lattice neighbours)
      for (let i = 0; i < grid.length; i++) {
        const pi = lattice[grid[i].idx];
        for (let j = i + 1; j < grid.length; j++) {
          const pj = lattice[grid[j].idx];
          const dr = Math.abs(grid[i].r - grid[j].r);
          const dc = Math.abs(grid[i].c - grid[j].c);
          if ((dr === 0 && dc === 1) || (dr === 1 && (dc === 0 || dc === 1))) {
            const dx = pi.baseX - pj.baseX;
            const dy = pi.baseY - pj.baseY;
            const dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < SPACING * 1.25) {
              bonds.push({ a: grid[i].idx, b: grid[j].idx, origDist: dist });
            }
          }
        }
      }

      // Fireflies (charge-carrier-like drifters)
      for (let i = 0; i < 18; i++) {
        const c = pickColor(accent);
        fireflies.push({
          x: Math.random() * w, y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.12, vy: (Math.random() - 0.5) * 0.12,
          size: 3 + Math.random() * 4, baseOpacity: 0.3 + Math.random() * 0.3,
          opacity: 0.3 + Math.random() * 0.3, color: c,
          phX: Math.random() * Math.PI * 2, phY: Math.random() * Math.PI * 2,
          fX: 0.0015 + Math.random() * 0.003, fY: 0.0015 + Math.random() * 0.003,
          aX: 5 + Math.random() * 8, aY: 5 + Math.random() * 8,
        });
      }

      // Background dust
      for (let i = 0; i < 80; i++) {
        const c = pickColor(accent);
        dust.push({
          x: Math.random() * w, y: Math.random() * h,
          size: 1 + Math.random() * 1.5,
          baseOpacity: 0.03 + Math.random() * 0.06,
          opacity: 0.03 + Math.random() * 0.06, color: c,
        });
      }
    }

    // ── Draw ──
    function draw() {
      ctx.clearRect(0, 0, w, h);

      // 1. Bonds
      ctx.lineWidth = 0.5;
      for (const bd of bonds) {
        const pa = lattice[bd.a], pb = lattice[bd.b];
        const x1 = pa.x + pa.dx, y1 = pa.y + pa.dy;
        const x2 = pb.x + pb.dx, y2 = pb.y + pb.dy;
        const dx = x2 - x1, dy = y2 - y1;
        const d = Math.sqrt(dx*dx + dy*dy);
        const ratio = d / bd.origDist;
        if (ratio > 2.5) continue;
        const bondOp = Math.max(0, 0.12 * (1 - (ratio - 1) * 0.8));
        const avgOp = (pa.opacity + pb.opacity) / 2;
        if (bondOp < 0.01 || avgOp < 0.02) continue;
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.strokeStyle = `rgba(108,140,255,${(bondOp * avgOp * 3).toFixed(4)})`;
        ctx.stroke();
      }

      // 2. Lattice dots
      for (const p of lattice) {
        const px = p.x + p.dx, py = p.y + p.dy;
        ctx.beginPath();
        ctx.arc(px, py, p.size * 0.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${p.color.r},${p.color.g},${p.color.b},${p.opacity})`;
        ctx.fill();
      }

      // 3. Dust
      for (const p of dust) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * 0.4, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${p.color.r},${p.color.g},${p.color.b},${p.opacity})`;
        ctx.fill();
      }

      // 4. Fireflies (glow + core)
      for (const p of fireflies) {
        if (p.opacity > 0.15) {
          const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size * 3);
          g.addColorStop(0, `rgba(${p.color.r},${p.color.g},${p.color.b},${(p.opacity * 0.4).toFixed(3)})`);
          g.addColorStop(0.5, `rgba(${p.color.r},${p.color.g},${p.color.b},${(p.opacity * 0.08).toFixed(3)})`);
          g.addColorStop(1, `rgba(${p.color.r},${p.color.g},${p.color.b},0)`);
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size * 2.5, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * 0.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${p.color.r},${p.color.g},${p.color.b},${p.opacity})`;
        ctx.fill();
      }
    }

    // ── Update ──
    function update() {
      time++;
      mouse.prevX = mouse.x;
      mouse.prevY = mouse.y;

      // Lattice: phonon wave + thermal jitter + ripple
      for (const p of lattice) {
        const wX = Math.sin(time * 0.0008 + p.wPhX) * 2.5
                 + Math.sin(time * 0.0012 + p.wPhX * 1.3) * 1.5;
        const wY = Math.cos(time * 0.0006 + p.wPhY) * 2.5
                 + Math.cos(time * 0.0010 + p.wPhY * 1.3) * 1.5;
        p.x = p.baseX + wX;
        p.y = p.baseY + wY;
        p.x += (Math.random() - 0.5) * 0.12;
        p.y += (Math.random() - 0.5) * 0.12;

        const sx = p.x + p.dx, sy = p.y + p.dy;
        const dxR = sx - mouse.x, dyR = sy - mouse.y;
        const dist = Math.sqrt(dxR * dxR + dyR * dyR);
        const RADIUS = 150, PUSH = 5;
        if (dist < RADIUS && dist > 0.5) {
          const str = (1 - dist / RADIUS);
          const ang = Math.atan2(dyR, dxR);
          p.dx += Math.cos(ang) * str * PUSH * (1 + Math.abs(Math.cos(ang)) * 0.3);
          p.dy += Math.sin(ang) * str * PUSH * (1 + Math.abs(Math.sin(ang)) * 0.3);
        }
        p.dx *= 0.90;
        p.dy *= 0.90;

        if (dist < 180) {
          p.opacity = Math.min(0.5, p.baseOpacity + (1 - dist / 180) * 0.5);
        } else {
          p.opacity += (p.baseOpacity - p.opacity) * 0.04;
        }
      }

      // Fireflies
      for (const p of fireflies) {
        p.x += p.vx + Math.sin(time * p.fX + p.phX) * 0.06;
        p.y += p.vy + Math.sin(time * p.fY + p.phY) * 0.06;
        const m = 80;
        if (p.x < -m) p.x = w + m;
        if (p.x > w + m) p.x = -m;
        if (p.y < -m) p.y = h + m;
        if (p.y > h + m) p.y = -m;
      }

      draw();
      requestAnimationFrame(update);
    }

    // ── Events ──
    function handleMouse(e) {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    }
    function handleLeave() {
      mouse.x = -9999;
      mouse.y = -9999;
    }
    function handleResize() {
      resize();
      createParticles();
    }

    // ── Re-read accent on theme toggle ──
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        setTimeout(createParticles, 50);
      });
    }

    // ── Init ──
    resize();
    createParticles();
    update();
    window.addEventListener('resize', handleResize);
    window.addEventListener('mousemove', handleMouse);
    window.addEventListener('mouseleave', handleLeave);
  })();
</script>
