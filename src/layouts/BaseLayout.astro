---
import '../styles/global.css';
import { SITE } from '../consts';
import { HREFLANG } from '../i18n/config';
import type { Post } from '../lib/content';
import { buildCanonical, buildHreflang } from '../lib/seo';
import Meta from '../components/seo/Meta.astro';
import OpenGraph from '../components/seo/OpenGraph.astro';
import TwitterCard from '../components/seo/TwitterCard.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string;              // 當前頁路徑，如 /zh/reviews/foo
  post?: Post | null;        // 文章頁傳入，用於 JSON-LD / OG 細節
  type?: 'website' | 'article';
  breadcrumb?: { name: string; url: string }[];
  wide?: boolean;
}

const { title, description, path, post = null, type = post ? 'article' : 'website', breadcrumb, wide = false } = Astro.props;
const locale = (path.startsWith('/en') ? 'en' : 'zh') as keyof typeof HREFLANG;
const url = `${SITE.url}${path}`;
const canonical = buildCanonical(post, path);
const hreflang = buildHreflang(post, path);
const image = post?.data.cover ? new URL(post.data.cover, SITE.url).href : `${SITE.url}/images/og-default.png`;

const jsonLd: Record<string, unknown>[] = [];
if (post) jsonLd.push(buildArticleLd());
if (breadcrumb) jsonLd.push(buildBreadcrumbLd());
if (type === 'website' && !post) jsonLd.push(websiteLd());

function buildArticleLd() {
  return {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post!.data.title,
    description: post!.data.description,
    image,
    datePublished: post!.data.date.toISOString(),
    dateModified: (post!.data.updated ?? post!.data.date).toISOString(),
    author: { '@type': 'Person', name: post!.data.author },
    publisher: { '@type': 'Organization', name: SITE.name },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    keywords: post!.data.keywords.join(', '),
  };
}
function buildBreadcrumbLd() {
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumb!.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      item: `${SITE.url}${item.url}`,
    })),
  };
}
function websiteLd() {
  return { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, inLanguage: SITE.locale };
}
---
<!doctype html>
<html lang={HREFLANG[locale]}>
  <head>
    <Meta title={title} description={description} canonical={canonical} path={path} hreflang={hreflang}
      published={post?.data.date.toISOString()} modified={post?.data.updated?.toISOString()} />
    <OpenGraph title={title} description={description} url={url} image={image} locale={HREFLANG[locale]} siteName={SITE.name} type={type} />
    <TwitterCard title={title} description={description} image={image} twitter={SITE.twitter} />
    {jsonLd.length > 0 && <JsonLd data={jsonLd} />}
    <!-- 復古印刷風字體：中文襯線 + 英文襯線 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;0,800;1,500&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Noto+Serif+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script>
      (function() {
        const saved = localStorage.getItem('theme');
        const prefers = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', saved || prefers);
      })();
    </script>
  </head>
  <body>
    <Header path={path} locale={locale} />
    <main class={`container${wide ? ' wide' : ''}`}>
      <slot />
    </main>
    <Footer locale={locale} />
    <button class="back-to-top" id="back-to-top" aria-label="回到頂部">↑</button>
  <script>
    // 返回頂部按鈕
    const btn = document.getElementById('back-to-top');
    if (btn) {
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            btn.classList.toggle('is-visible', window.scrollY > 300);
            ticking = false;
          });
          ticking = true;
        }
      });
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // 主題切換
    const toggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    if (toggle) {
      const updateIcon = () => {
        toggle.textContent = html.getAttribute('data-theme') === 'dark' ? '☀️' : '🌙';
      };
      updateIcon();
      toggle.addEventListener('click', () => {
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateIcon();
      });
    }
  </script>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <script is:inline>
    // 復古印刷風進階動畫（GSAP）。無障礙：尊重 prefers-reduced-motion。
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 輕量 CSS 淡入（.reveal）：未載入 GSAP 或減動時直接顯示
      const reveals = document.querySelectorAll('.reveal');
      if (reduce || typeof gsap === 'undefined') {
        reveals.forEach((el) => el.classList.add('is-visible'));
      } else {
        gsap.registerPlugin(ScrollTrigger);
        reveals.forEach((el) => gsap.set(el, { opacity: 0, y: 28 }));
        ScrollTrigger.batch('.reveal', {
          start: 'top 88%',
          onEnter: (batch) =>
            gsap.to(batch, {
              opacity: 1,
              y: 0,
              duration: 0.8,
              stagger: 0.09,
              ease: 'power2.out',
              onComplete: () => batch.forEach((el) => el.classList.add('is-visible')),
            }),
        });
      }

      if (reduce || typeof gsap === 'undefined') return;
      gsap.registerPlugin(ScrollTrigger);

      // Hero 進場時間軸
      const heroBits = document.querySelectorAll('[data-hero]');
      if (heroBits.length) {
        gsap.set(heroBits, { opacity: 0, y: 34 });
        gsap
          .timeline({ defaults: { ease: 'power3.out' } })
          .to(heroBits, { opacity: 1, y: 0, duration: 0.9, stagger: 0.14 });
      }

      // Hero 滑鼠視差（深度層）
      const hero = document.querySelector('[data-parallax-root]');
      if (hero) {
        const back = hero.querySelector('[data-parallax="back"]');
        const mid = hero.querySelector('[data-parallax="mid"]');
        const fore = hero.querySelector('[data-parallax="fore"]');
        hero.addEventListener('mousemove', (e) => {
          const x = (e.clientX / window.innerWidth - 0.5) * 2;
          const y = (e.clientY / window.innerHeight - 0.5) * 2;
          if (back) gsap.to(back, { x: x * 40, y: y * 20, duration: 0.9, ease: 'power2.out' });
          if (mid) gsap.to(mid, { x: x * 22, y: y * 11, duration: 0.9, ease: 'power2.out' });
          if (fore) gsap.to(fore, { x: x * 9, y: y * 5, duration: 0.9, ease: 'power2.out' });
        });
      }

      // 文章卡滾動浮起（stagger）
      ScrollTrigger.batch('.stagger-card', {
        start: 'top 90%',
        onEnter: (batch) =>
          gsap.fromTo(
            batch,
            { opacity: 0, y: 40, rotateX: 8 },
            { opacity: 1, y: 0, rotateX: 0, duration: 0.7, stagger: 0.08, ease: 'power2.out' }
          ),
      });
    })();
  </script>
  </body>
</html>
