---
import type { Locale } from '../i18n/config';
import { LOCALES } from '../i18n/config';
import { withBase } from '../consts';

interface Props { path: string; locale: Locale; }
const { path, locale } = Astro.props;

function switchPath(target: Locale): string {
  return withBase(`/${target}`);
}
const others = LOCALES.filter((l) => l !== locale);
const label: Record<Locale, string> = { zh: '中', en: 'EN' };
---
<div class="inline-flex items-center gap-1.5 text-xs">
  <span aria-current="true" class="cursor-default text-[var(--color-accent)] font-medium">{label[locale]}</span>
  <span class="text-[var(--color-text-tertiary)] opacity-40">/</span>
  {others.map((l) => (
    <a href={switchPath(l)} hreflang={l === 'en' ? 'en-US' : 'zh-TW'} class="no-underline text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors duration-200">{label[l]}</a>
  ))}
</div>
