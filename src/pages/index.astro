---
// root / → 導向 /en 或 /zh（專案頁需含 base 前綴，來自 consts.BASE）
// 靜態頁無法讀請求標頭，語系由 client 端 navigator.language 決定；
// 此處 meta refresh 預設 en（英文為主），client script 再即時改導 zh。
import { BASE } from '../consts';

const target = (BASE.replace(/\/$/, '') + '/en/').replace(/\/{2,}/g, '/');
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="6BKS1UzkFp8C0T4foAaRIy17em4j1IxYLyJDMvSDvbI" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Loading…</title>
  </head>
  <body>
    <p>Going to <a href={target}>homepage</a>…</p>
    <script is:inline>
      const base = '{BASE}';
      const nav = (navigator.language || 'zh').toLowerCase().startsWith('en') ? 'en/' : 'zh/';
      const t = (base.replace(/\/$/, '') + '/' + nav).replace(/\/{2,}/g, '/');
      if (location.pathname === base || location.pathname === base.replace(/\/$/, '') || location.pathname === '/') {
        location.replace(t);
      }
    </script>
  </body>
</html>
