---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { withBase } from '../consts';

interface Props { items: { name: string; url: string }[]; locale: Locale; }
const { items, locale } = Astro.props;
const t = useTranslations(locale);
const trail = [{ name: t('breadcrumb.home'), url: withBase(`/${locale}`) }, ...items];
---
<nav class="breadcrumb" aria-label="breadcrumb">
  {trail.map((item, i) => (
    <span class="crumb">
      {i > 0 && <span class="sep">/</span>}
      {i === trail.length - 1
        ? <span class="current">{item.name}</span>
        : <a href={item.url}>{item.name}</a>}
    </span>
  ))}
</nav>

<style>
  .breadcrumb {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .sep { margin: 0 0.35rem; opacity: 0.5; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--text); }
  .current { color: var(--text); }
</style>
