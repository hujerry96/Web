---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getPosts, getRelated, parseId, postSlug, readingTime, extractHeadings } from '../../../lib/content';
import { render } from 'astro:content';
import { useTranslations } from '../../../i18n/ui';
import { SITE, type Locale } from '../../../consts';
import { Image } from 'astro:assets';
import ArticleCard from '../../../components/ArticleCard.astro';
import Toc from '../../../components/Toc.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const { locale, category } = parseId(post.id);
    return { params: { locale, category, slug: postSlug(post) }, props: { post } };
  });
}

const { locale, category } = Astro.params as { locale: Locale; category: string };
const { post } = Astro.props as { post: any };
const t = useTranslations(locale);
const { Content } = await render(post);
const catName = (SITE.categories[locale] as Record<string, string>)[category] ?? category;
const slug = postSlug(post);
const path = `/${locale}/${category}/${slug}`;
const related = await getRelated(post);
const headings = extractHeadings(post.body);
const breadcrumb = [
  { name: catName, url: `/${locale}/${category}` },
  { name: post.data.title, url: path },
];
---
<BaseLayout title={`${post.data.title} | ${SITE.name}`} description={post.data.description} path={path} post={post} breadcrumb={breadcrumb} wide>
  <article class="py-8 max-w-4xl mx-auto">
    <div class="reveal">
      <Breadcrumb locale={locale} items={breadcrumb} />

      <header class="mb-8">
        <h1 class="text-[clamp(1.8rem,1rem+3vw,2.8rem)] leading-tight break-words mt-0 mb-5">{post.data.title}</h1>
        <div class="flex gap-4 flex-wrap text-[0.85rem] text-[var(--color-text-secondary)] mb-2">
          <span>{t('article.by')} {post.data.author}</span>
          <span class="opacity-30">·</span>
          <span>{readingTime(post.body, locale)}</span>
          <span class="opacity-30">·</span>
          <time datetime={post.data.date.toISOString()}>{t('article.published')} {post.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</time>
          {post.data.updated && (
            <>
              <span class="opacity-30">·</span>
              <time datetime={post.data.updated.toISOString()}>{t('article.updated')} {post.data.updated.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</time>
            </>
          )}
        </div>
      </header>

      {post.data.cover && (
        <div class="mb-8 rounded-xl overflow-hidden border border-[var(--color-border-subtle)]">
          <Image src={post.data.cover} alt={post.data.title} width={1280} height={720} class="w-full aspect-video object-cover" />
        </div>
      )}
    </div>

    <div class="grid grid-cols-[minmax(0,1fr)_240px] gap-12 items-stretch max-[980px]:!grid-cols-1 max-[980px]:!gap-6 max-[980px]:[&_aside]:hidden">
      <div class="min-w-0 reveal reveal-delay-1">
        <article class="prose">
          <Content />
        </article>

        {post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag: string) => <span class="tag">#{tag}</span>)}
          </div>
        )}

      </div>

      <aside class="block relative">
        <Toc headings={headings} locale={locale} />
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-16 pt-10 border-t border-[var(--color-border-subtle)] reveal">
        <h2 class="text-center text-[clamp(1.3rem,0.9rem+1.5vw,1.75rem)] font-display font-semibold mb-8">{t('article.related')}</h2>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,280px),1fr))] gap-5">
          {related.map((r) => <ArticleCard post={r} locale={locale} />)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
