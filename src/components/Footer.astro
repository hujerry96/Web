---
import { SITE, withBase } from '../consts';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const cats = SITE.categories[locale] as Record<string, string>;
---
<footer class="border-t-3 border-lab-accent mt-12 bg-lab-surface py-12 px-5 text-lab-text-muted text-sm">
  <div class="mx-auto max-w-4xl">
    <div class="grid grid-cols-[2fr_1fr_1fr] gap-8 mb-8 max-sm:!grid-cols-1 max-sm:!gap-6">
      <div class="flex flex-col gap-2">
        <span class="font-serif font-bold text-2xl tracking-[0.14em] uppercase text-lab-text">{SITE.name}</span>
        <p class="font-serif m-0 leading-normal max-w-[24rem]">{SITE.meta[locale].description}</p>
        {SITE.social.github && <a class="font-serif text-lab-text-muted no-underline text-[0.82rem] mr-3 transition-colors duration-150 hover:text-lab-accent" href={SITE.social.github} rel="me">GitHub</a>}
        {SITE.social.x && <a class="font-serif text-lab-text-muted no-underline text-[0.82rem] mr-3 transition-colors duration-150 hover:text-lab-accent" href={SITE.social.x} rel="me">X</a>}
      </div>
      <div class="flex flex-col gap-2">
        <span class="font-serif font-semibold tracking-[0.16em] uppercase text-[0.72rem] text-lab-accent mb-2">{t('home.categories')}</span>
        {Object.entries(cats).map(([key, name]) => (
          <a href={withBase(`/${locale}/${key}`)} class="font-serif text-lab-text-muted no-underline transition-colors duration-150 hover:text-lab-accent">{name}</a>
        ))}
      </div>
      <div class="flex flex-col gap-2">
        <span class="font-serif font-semibold tracking-[0.16em] uppercase text-[0.72rem] text-lab-accent mb-2">{t('nav.about')}</span>
        <a href={withBase(`/${locale}/about`)} class="font-serif text-lab-text-muted no-underline transition-colors duration-150 hover:text-lab-accent">{t('nav.about')}</a>
        <a href={withBase(`/${locale}/contact`)} class="font-serif text-lab-text-muted no-underline transition-colors duration-150 hover:text-lab-accent">{t('nav.contact')}</a>
        <a href={withBase(`/${locale}/free-resources`)} class="font-serif text-lab-text-muted no-underline transition-colors duration-150 hover:text-lab-accent">{t('nav.free')}</a>
        <a href={withBase(`/${locale}/rss.xml`)} class="font-serif text-lab-text-muted no-underline transition-colors duration-150 hover:text-lab-accent">{t('rss.subscribe')}</a>
      </div>
    </div>
    <div class="flex justify-between items-center flex-wrap gap-2 pt-6 border-t border-border">
      <span>&copy; {year} {SITE.name}. {t('footer.rights')}.</span>
      <span class="opacity-70">{t('footer.built')}</span>
    </div>
  </div>
</footer>
