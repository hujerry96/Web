---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { withBase } from '../consts';

interface Props { items: { name: string; url: string }[]; locale: Locale; }
const { items, locale } = Astro.props;
const t = useTranslations(locale);
const trail = [{ name: t('breadcrumb.home'), url: withBase(`/${locale}`) }, ...items];
---
<nav class="text-[0.82rem] text-[var(--color-text-secondary)] mb-6 flex flex-wrap gap-1.5 animate-fade-in" aria-label="breadcrumb" style="animation: fadeIn 0.6s var(--ease-out-expo) both;">
  {trail.map((item, i) => (
    <span class="flex items-center gap-1.5">
      {i > 0 && <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="opacity-30"><path d="M4.5 2.5l3.5 3.5-3.5 3.5"/></svg>}
      {i === trail.length - 1
        ? <span class="text-[var(--color-text)] font-medium">{item.name}</span>
        : <a href={item.url} class="text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">{item.name}</a>}
    </span>
  ))}
</nav>
