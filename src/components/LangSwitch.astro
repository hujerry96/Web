---
import type { Locale } from '../i18n/config';
import { LOCALES } from '../i18n/config';
import { withBase } from '../consts';

interface Props { path: string; locale: Locale; }
const { path, locale } = Astro.props;

function switchPath(target: Locale): string {
  const parts = path.split('/').filter(Boolean);
  // 首頁或無法確認對應譯文時，跳該語系首頁（避免 404）
  if (parts.length <= 1 || parts[0] !== locale) return withBase(`/${target}`);
  // 嘗試把目前分類/路徑切換到目標語系；若無對應譯文，後端仍會 404，
  // 故僅對「文章/分類」做語系前綴替換，首頁與靜態頁安全回退。
  const rest = parts.slice(1);
  return withBase(`/${target}/${rest.join('/')}`);
}
const others = LOCALES.filter((l) => l !== locale);
const flag: Record<Locale, string> = { zh: '🇹🇼', en: '🇺🇸' };
---
<div class="lang-switch">
  <span class="current" aria-current="true">{flag[locale]}</span>
  <span class="sep" aria-hidden="true">·</span>
  {others.map((l) => (
    <a href={switchPath(l)} hreflang={l === 'en' ? 'en-US' : 'zh-TW'}>{flag[l]}</a>
  ))}
</div>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.85rem;
    line-height: 1;
    font-family: var(--font-serif-body);
  }
  .current {
    cursor: default;
    filter: drop-shadow(0 0 1px rgba(0,0,0,0.1));
  }
  .sep {
    color: var(--color-text-faint);
    font-size: 0.7rem;
  }
  .lang-switch a {
    text-decoration: none;
    opacity: 0.55;
    transition: opacity var(--duration-fast) var(--ease);
  }
  .lang-switch a:hover { opacity: 1; }
</style>
