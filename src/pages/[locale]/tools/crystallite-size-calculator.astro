---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CrystalliteWorkbench from '../../../components/CrystalliteWorkbench.astro';
import { useTranslations } from '../../../i18n/ui';
import { SITE, withBase, type Locale } from '../../../consts';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const zh = locale === 'zh';
const path = `/${locale}/tools/crystallite-size-calculator`;
const toolsPath = `/${locale}/tools`;
const appPath = `/${locale}/spectra-studio`;
const description = zh
  ? '免費多峰 XRD 晶粒尺寸工作台。從 Excel 貼上峰位與 FWHM，選擇儀器展寬修正，比較 Scherrer 表觀尺寸並匯出完整計算紀錄。'
  : 'Free multi-peak XRD crystallite size workbench. Paste peaks from Excel, select instrumental broadening corrections, compare Scherrer apparent sizes and export calculation records.';
const faqItems = [
  { question: t('calc.faqQ1'), answer: t('calc.faqA1') },
  { question: t('calc.faqQ2'), answer: t('calc.faqA2') },
  { question: zh ? '多峰結果可以直接取平均嗎？' : 'Should I average the sizes from different peaks?', answer: zh ? '多峰尺寸可用於描述性比較，但簡單平均不一定更準確。不同晶向的相干域尺寸、微應變、峰重疊與擬合方式都可能影響結果。請保留逐峰數據及分析假設。' : 'Multiple peaks support descriptive comparison, but a simple average is not necessarily more accurate. Direction-dependent domain size, microstrain, overlapping peaks and fitting choices can affect each result. Keep individual peak results and analysis assumptions.' },
];
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: t('calc.title'), url: `${SITE.url}${path}`, description, applicationCategory: 'EducationalApplication', operatingSystem: 'All', browserRequirements: 'Requires JavaScript', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, author: { '@type': 'Person', name: SITE.author }, inLanguage: zh ? 'zh-TW' : 'en-US', featureList: ['Multi-peak Scherrer calculation', 'Excel and CSV paste', 'Gaussian and Lorentzian instrument corrections', 'Peak size comparison', 'CSV export and calculation summary'] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
];
---
<BaseLayout title={t('calc.metaTitle', { name: SITE.name })} description={description} path={path} wide breadcrumb={[{ name: t('nav.tools'), url: toolsPath }, { name: t('calc.title'), url: path }]} jsonLd={structuredData}>
  <section class="calc-page">
    <Breadcrumb locale={locale} items={[{ name: t('nav.tools'), url: toolsPath }, { name: t('calc.title'), url: path }]} />
    <header class="calc-hero">
      <div><p class="kicker">{zh ? 'XRD 分析工具' : 'XRD ANALYSIS TOOL'}</p><h1>{t('calc.title')}</h1><p class="subtitle">{zh ? '貼上峰資料、比較表觀晶粒尺寸，帶走完整計算紀錄。' : 'Paste your peaks. Compare apparent crystallite sizes. Keep the calculation record.'}</p></div>
      <p class="formula"><code>D = Kλ / (β cosθ)</code><span>{zh ? '免費 · 本機計算 · 不需上傳' : 'Free · Local calculation · No upload'}</span></p>
    </header>
    <CrystalliteWorkbench locale={locale} />
    <div class="support">
      <section aria-labelledby="workflow-heading"><h2 id="workflow-heading">{zh ? '從峰擬合到尺寸估算' : 'From fitted peaks to size estimates'}</h2><ol><li>{zh ? '先處理背景與重疊峰，再取得峰位 2θ 和 FWHM。FWHM 是 2θ 軸上的完整半高寬，不是半寬。' : 'Fit the background and resolve overlapping peaks first. Use the peak position 2θ and full width at half maximum on the 2θ axis, not the half width.'}</li><li>{zh ? '設定量測使用的波長與 K。若有標準樣品的儀器峰寬，再選擇適當的修正模型。' : 'Set the measured wavelength and K. If you have instrument widths from a standard, choose a correction consistent with the line shape.'}</li><li>{zh ? '檢查各峰結果與計算明細。匯出時會保留輸入、設定、逐峰狀態與限制說明。' : 'Inspect individual results and calculation details. Exports retain inputs, settings, per-peak status and limitations.'}</li></ol><a href={withBase('/en/guides/how-to-calculate-crystallite-size-from-xrd')}>{zh ? '閱讀 FWHM 與 Scherrer 計算教學（英文） →' : 'Read the worked FWHM and Scherrer guide →'}</a></section>
      <section aria-labelledby="fitting-heading"><h2 id="fitting-heading">{zh ? '需要分析原始光譜？' : 'Working with raw diffraction patterns?'}</h2><p>{zh ? '這裡使用已量得的峰位與峰寬，不自動找峰或移除微應變。原始光譜的找峰、擬合與進階分析，請使用 Spectra Studio。' : 'This workbench uses measured peak positions and widths. It does not detect peaks or remove microstrain. For raw-pattern peak detection, fitting and advanced analysis, explore Spectra Studio.'}</p><a href={withBase(appPath)}>{t('calc.ctaLink')}</a><p class="reference">{zh ? '方法與限制參考：' : 'Method and limitations: '}<a href="https://journals.iucr.org/j/issues/2004/06/00/ks0213/">IUCr size–strain analysis</a> · <a href="https://pubs.rsc.org/en/content/articlehtml/2011/nr/c0nr00561d">Scherrer interpretation pitfalls</a></p></section>
    </div>
    <section class="faq" aria-labelledby="faq-heading"><h2 id="faq-heading">{t('calc.faqTitle')}</h2>{faqItems.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
  </section>
</BaseLayout>
<style>
  .calc-page { padding: 1rem 0 3rem; }
  .calc-hero { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: .6rem 0 1rem; }
  .kicker { margin: 0 0 .55rem; color: var(--color-accent); font-size: .72rem; font-weight: 600; letter-spacing: .06em; }
  h1 { font-family: var(--font-body); font-size: clamp(1.7rem, 3.2vw, 2.5rem); line-height: 1.18; letter-spacing: -.025em; margin: 0 0 .7rem; text-wrap: balance; }
  .subtitle { font-size: .95rem; color: var(--color-text-secondary); margin: 0; max-width: 65ch; }
  .formula { flex-shrink: 0; margin: 0; } .formula code { font-family: var(--font-mono); font-size: 1rem; } .formula span { display: block; margin-top: .6rem; color: var(--color-text-secondary); font-size: .72rem; }
  h2 { font-family: var(--font-body); font-size: 1.1rem; margin: 0 0 1rem; }
  .support { display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; border-top: 1px solid var(--color-border); padding-top: 2rem; margin-top: 2rem; font-size: .9rem; }
  .support p, .support li, .faq p { color: var(--color-text-secondary); line-height: 1.8; } ol { padding-left: 1.2rem; margin: 0 0 1rem; } li { padding-left: .3rem; margin-bottom: .65rem; } .reference { font-size: .76rem; margin-top: 1.5rem; }
  .faq { margin-top: 2.5rem; max-width: 75ch; } .faq details { border-top: 1px solid var(--color-border); padding: .9rem 0; } summary { cursor: pointer; font-size: .9rem; } summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; } .faq p { font-size: .9rem; }
  @media (max-width: 760px) { .calc-hero { flex-direction: column; align-items: start; gap: 1rem; } .formula { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; } .formula span { margin: 0; } .support { grid-template-columns: 1fr; gap: 2rem; } }
</style>
