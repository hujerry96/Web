---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, type Locale } from '../../consts';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const path = `/${locale}/about`;
---
<BaseLayout title={`${t('nav.about')} | ${SITE.name}`} description={t('page.aboutDesc', { name: SITE.name, author: SITE.author })} path={path}>
  <Breadcrumb locale={locale} items={[{ name: t('nav.about'), url: path }]} />
  <article class="prose about">
    <div class="about-head">
      {SITE.avatar
        ? <img class="avatar" src={SITE.avatar} alt={SITE.author} width={120} height={120} />
        : <div class="avatar avatar--empty" aria-hidden="true">{SITE.author.split(' ').map((w) => w[0]).join('')}</div>}
      <div>
        <h1>{SITE.author}</h1>
        <p class="muted serif-body role">{t('page.aboutRole')}</p>
      </div>
    </div>

    <p class="lead serif-body">{t('page.aboutLead', { name: SITE.name })}</p>

    <h2>{t('page.aboutWhyTitle')}</h2>
    <p>{t('page.aboutWhy1')}</p>
    <p>{t('page.aboutWhy2')}</p>

    <h2>{t('page.aboutTopicsTitle')}</h2>
    <ul>
      <li set:html={t('page.aboutTopic1')} />
      <li set:html={t('page.aboutTopic2')} />
      <li set:html={t('page.aboutTopic3')} />
      <li set:html={t('page.aboutTopic4')} />
    </ul>

    <h2>{t('page.aboutContactTitle')}</h2>
    <p set:html={t('page.aboutContact', { email: SITE.email })} />
  </article>
</BaseLayout>

<style>
  .about-head {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 2px solid var(--color-accent);
    flex-shrink: 0;
  }
  .avatar--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-soft);
    color: var(--color-accent-deep);
    font-family: var(--font-serif-display);
    font-size: 2rem;
    font-weight: 500;
  }
  .about-head h1 { margin: 0; font-size: clamp(1.6rem, 1rem + 2vw, 2.2rem); }
  .role { margin: 0.3rem 0 0; font-size: 0.95rem; }
  .lead { font-size: 1.1rem; color: var(--color-text-secondary); }
  .about .lead::first-letter {
    font-family: var(--font-serif-display);
    font-size: 2.6em;
    line-height: 0.8;
    float: left;
    padding: 0.05em 0.12em 0 0;
    color: var(--color-accent);
    font-weight: 500;
  }
</style>
