---
import { SITE, withBase } from '../consts';
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import LangSwitch from './LangSwitch.astro';

interface Props { path: string; locale: Locale; }
const { path, locale } = Astro.props;
const t = useTranslations(locale);

type NavItem = { href: string; key: Parameters<typeof t>[0] };

// 依語系產生導覽項目
const nav: NavItem[] = locale === 'zh'
  ? [
      { href: '/zh/ai', key: 'nav.ai' },
      { href: '/zh/shopee', key: 'nav.shopee' },
      { href: '/zh/python', key: 'nav.python' },
      { href: '/zh/reviews', key: 'nav.reviews' },
      { href: '/zh/blog', key: 'nav.blog' },
    ]
  : [
      { href: '/en/books', key: 'nav.books' },
      { href: '/en/study', key: 'nav.study' },
      { href: '/en/blog', key: 'nav.blog' },
      { href: '/en/lab', key: 'nav.lab' },
      { href: '/en/printable', key: 'nav.printable' },
      { href: '/en/engineering', key: 'nav.engineering' },
    ];
const staticLinks: NavItem[] = [
  { href: `/${locale}/free-resources`, key: 'nav.free' },
  { href: `/${locale}/about`, key: 'nav.about' },
  { href: `/${locale}/contact`, key: 'nav.contact' },
];
---
<header class="site-header">
  <div class="container header-top">
    <a href={withBase(`/${locale}`)} class="brand">{SITE.name}</a>
    <LangSwitch path={path} locale={locale} />
  </div>
  <nav class="container nav" aria-label="primary">
    {nav.map((item) => <a href={withBase(item.href)}>{t(item.key)}</a>)}
    <span class="nav-sep" aria-hidden="true"></span>
    {staticLinks.map((item) => <a href={withBase(item.href)} class="muted-link">{t(item.key)}</a>)}
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: rgba(250, 246, 240, 0.85);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: saturate(180%) blur(8px);
  }
  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
  }
  .brand::after {
    content: '';
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    margin-left: 0.3rem;
    border-radius: 999px;
    background: var(--accent);
    vertical-align: middle;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
    padding-bottom: 0.75rem;
    border-top: 1px solid var(--border);
    margin-top: -1px;
  }
  .nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .nav a:hover { color: var(--accent); }
  .nav .muted-link { color: var(--text-muted); font-weight: 400; }
  .nav .muted-link:hover { color: var(--accent); }
  .nav-sep {
    flex: 1 1 auto;
    min-width: 1rem;
  }
</style>
