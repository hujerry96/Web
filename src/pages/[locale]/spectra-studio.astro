<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.copy-checksum');
  const toast = document.querySelector<HTMLElement>('.copy-toast');
  let toastTimer = 0;

  buttons.forEach((button) => {
    button.addEventListener('click', async () => {
      const checksum = button.dataset.checksum;
      if (!checksum) return;
      try {
        await navigator.clipboard.writeText(checksum);
        if (toast) {
          window.clearTimeout(toastTimer);
          toast.classList.add('is-visible');
          toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1800);
        }
      } catch {
        const selection = window.getSelection();
        const code = document.querySelector('.checksum-row code');
        if (selection && code) {
          const range = document.createRange();
          range.selectNodeContents(code);
          selection.removeAllRanges();
          selection.addRange(range);
        }
      }
    });
  });
</script>
