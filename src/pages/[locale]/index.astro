---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, readingTime } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const all = await getPosts();
  const locales = ['zh', 'en'] as Locale[];
  return locales.map((locale) => {
    const posts = all.filter((p) => p.id.startsWith(`${locale}/`) && p.data.brand !== 'select');
    const counts: Record<string, number> = {};
    for (const p of posts) {
      const cat = p.id.split('/')[1];
      counts[cat] = (counts[cat] ?? 0) + 1;
    }
    return { params: { locale }, props: { posts, counts } };
  });
}

const { locale } = Astro.params as { locale: Locale };
const { posts, counts } = Astro.props as { posts: any[]; counts: Record<string, number> };
const t = useTranslations(locale);
const cats = SITE.categories[locale] as Record<string, string>;
const path = `/${locale}`;

const featured = posts[0];
const rest = posts.slice(1, 10);
const featuredCat = featured ? (featured.id.split('/')[1] as string) : '';
const featuredCatName = featured ? ((SITE.categories[locale] as Record<string, string>)[featuredCat] ?? featuredCat) : '';
---
<BaseLayout title={SITE.meta[locale].title} description={SITE.meta[locale].description} path={path} post={featured} breadcrumb={[]} wide>
  {/* ── Masthead ── */}
  <section class="text-center py-[clamp(3rem,6vw,5.5rem)] pb-[clamp(1.5rem,4vw,2.5rem)]">
    <span class="inline-block font-sans text-[0.74rem] font-medium tracking-[0.28em] uppercase text-lab-accent reveal" data-hero>{t('home.tagline')}</span>
    <h1 class="font-serif font-medium text-[clamp(3rem,1rem+8vw,5.5rem)] tracking-tight leading-[1.02] mt-2 mb-0 reveal" data-hero>{SITE.name}</h1>
    <p class="font-sans text-[clamp(1rem,0.9rem+0.6vw,1.2rem)] text-lab-text-muted max-w-[36rem] mt-5 mx-auto reveal" data-hero>{t('home.intro')}</p>
  </section>

  {/* ── Featured card ── */}
  {featured && (
    <a class="grid grid-cols-[1.25fr_1fr] bg-lab-surface text-inherit no-underline transition-all duration-150 border border-border hover:border-lab-accent reveal max-sm:!grid-cols-1" href={withBase(`/${locale}/${featuredCat}/${featured.data.slug ?? featured.data.slug ?? featured.id.split('/').slice(2).join('/')}`)}>
      <div class="relative min-h-[320px] max-sm:min-h-[200px]">
        {featured.data.cover
          ? <Image src={featured.data.cover} alt={featured.data.title} width={800} height={500} class="w-full h-full object-cover" loading="eager" />
          : <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-lab-accent-soft to-lab-surface text-lab-accent-deep font-serif font-medium text-lg tracking-wide"><span>{featuredCatName}</span></div>}
      </div>
      <div class="p-[clamp(1.5rem,3vw,2.5rem)] flex flex-col justify-center">
        <span class="font-serif text-[0.72rem] text-lab-accent uppercase tracking-[0.18em] border-b border-lab-accent pb-0.5 self-start">{featuredCatName}</span>
        <h2 class="font-serif text-[clamp(1.2rem,0.9rem+1.2vw,1.6rem)] font-medium mt-4 mb-3 leading-tight">{featured.data.title}</h2>
        <p class="font-serif text-lab-text-muted text-[0.9rem] mb-3">{featured.data.description}</p>
        <div class="flex gap-2.5 items-center font-serif text-[0.78rem] text-lab-text-muted tracking-wide">
          <span>{featured.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</span>
          <i class="text-lab-accent not-italic">·</i>
          <span>{readingTime(featured.body, locale)}</span>
        </div>
      </div>
    </a>
  )}

  {/* ── Category pills ── */}
  <nav class="flex flex-wrap gap-2.5 justify-center mt-2 mb-4 reveal" aria-label="categories">
    {Object.entries(cats).map(([key, name]) => (
      <a class="font-sans text-sm text-lab-text-secondary no-underline border border-border rounded-full py-1.5 px-4 transition-all duration-150 hover:border-lab-accent hover:text-lab-accent hover:bg-lab-accent-soft" href={withBase(`/${locale}/${key}`)}>
        {name}<span class="text-[0.7rem] text-lab-text-muted ml-1.5">{counts[key] ?? 0}</span>
      </a>
    ))}
  </nav>

  <div class="flex items-center gap-4 my-8 max-w-[22rem] mx-auto before:flex-1 before:h-px before:bg-gradient-to-r before:to-border after:flex-1 after:h-px after:bg-gradient-to-l after:to-border reveal"><span class="text-lab-accent text-base opacity-85">✦</span></div>
  <h2 class="text-center font-serif text-[clamp(1.8rem,1rem+3vw,2.4rem)] font-medium mt-4 mb-6 reveal">{t('home.latest')}</h2>
  <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,280px),1fr))] gap-5 my-6">
    {rest.map((post) => (
      <div class="stagger-card">
        <ArticleCard post={post} locale={locale} />
      </div>
    ))}
  </div>
</BaseLayout>
