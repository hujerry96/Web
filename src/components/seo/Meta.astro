---
import { withBase } from '../../consts';
interface Props {
  title: string;
  description: string;
  canonical: string;
  path: string;
  hreflang: { lang: string; href: string }[];
  published?: string;
  modified?: string;
}
const { title, description, canonical, hreflang, published, modified, path } = Astro.props;
// RSS 位於 /[locale]/rss.xml，需補 base 前綴
const locale = path.split('/')[1];
const rssHref = withBase(locale ? `/${locale}/rss.xml` : '/rss.xml');
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{published && <meta property="article:published_time" content={published} />}
{modified && <meta property="article:modified_time" content={modified} />}
{hreflang.map((h) => (
  <link rel="alternate" hreflang={h.lang} href={h.href} />
))}
<meta name="google-site-verification" content="6BKS1UzkFp8C0T4foAaRIy17em4j1IxYLyJDMvSDvbI" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#faf6f0" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1a1410" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={title} href={rssHref} />
