---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const path = `/${locale}/search`;
const searchIndexUrl = withBase('/search-index.json');
---
<BaseLayout title={`${t('nav.search')} | ${SITE.name}`} description={t('page.searchDesc', { name: SITE.name })} path={path}>
  <Breadcrumb locale={locale} items={[{ name: t('nav.search'), url: path }]} />
  <h1 class="text-[clamp(1.8rem,1rem+3vw,2.6rem)]">{t('nav.search')}</h1>

  <div class="my-4 mb-12">
    <input
      type="search"
      id="q"
      class="w-full font-serif text-[1.1rem] py-3 px-4 border border-border rounded-[10px] bg-lab-surface text-lab-text transition-all duration-150 focus:outline-none focus:border-lab-accent focus:shadow-[0_0_0_3px_var(--color-lab-accent-soft)]"
      placeholder={t('search.placeholder')}
      autocomplete="off"
      aria-label={t('nav.search')}
      data-index={searchIndexUrl}
    />
    <p class="text-[0.85rem] text-lab-text-muted mt-3 mb-0" id="count"></p>
    <ul class="list-none p-0 m-0 flex flex-col gap-3 mt-4" id="results"></ul>
    <p class="text-lab-text-muted" id="empty" hidden>沒有找到結果。</p>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('q') as HTMLInputElement;
  const results = document.getElementById('results') as HTMLUListElement;
  const count = document.getElementById('count') as HTMLParagraphElement;
  const empty = document.getElementById('empty') as HTMLParagraphElement;

  let index: { locale: string; category: string; title: string; description: string; tags: string[]; url: string }[] = [];
  const currentLocale = document.documentElement.lang?.startsWith('en') ? 'en' : 'zh';

  const indexUrl = (input as HTMLInputElement).dataset.index ?? '/search-index.json';
  fetch(indexUrl)
    .then((r) => r.json())
    .then((data) => { index = data; })
    .catch(() => {});

  function render(q: string) {
    const term = q.trim().toLowerCase();
    if (!term) { results.innerHTML = ''; count.textContent = ''; empty.hidden = true; return; }
    const hits = index
      .filter((p) => p.locale === currentLocale)
      .filter((p) =>
        p.title.toLowerCase().includes(term) ||
        p.description.toLowerCase().includes(term) ||
        p.tags.some((t) => t.toLowerCase().includes(term))
      )
      .slice(0, 20);
    count.textContent = `${hits.length} 筆結果`;
    empty.hidden = hits.length > 0;
    results.innerHTML = hits
      .map(
        (p) =>
          `<li><a href="${p.url}" class="flex flex-col gap-0.5 no-underline p-4 border border-border rounded-[10px] bg-lab-surface transition-all duration-150 hover:border-lab-accent hover:shadow-md"><span class="text-[0.7rem] tracking-[0.16em] uppercase text-lab-accent">${p.category}</span><span class="font-serif text-[1.1rem] text-lab-text font-medium">${p.title}</span><span class="text-[0.88rem] text-lab-text-muted">${p.description}</span></a></li>`
      )
      .join('');
  }

  input?.addEventListener('input', (e) => render((e.target as HTMLInputElement).value));
</script>
