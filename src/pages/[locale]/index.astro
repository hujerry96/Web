---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, readingTime } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';
import { SITE, withBase, type Locale } from '../../consts';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const all = await getPosts();
  const locales = ['zh', 'en'] as Locale[];
  return locales.map((locale) => {
    const posts = all.filter((p) => p.id.startsWith(`${locale}/`));
    return { params: { locale }, props: { posts } };
  });
}

const { locale } = Astro.params as { locale: Locale };
const { posts } = Astro.props as { posts: any[] };
const t = useTranslations(locale);
const path = `/${locale}`;

const projects = posts.filter((p) => p.data.project).slice(0, 2);
const latest = posts.slice(0, 6);
const catCounts: Record<string, number> = {};
for (const p of posts) { const c = p.id.split('/')[1]; catCounts[c] = (catCounts[c] ?? 0) + 1; }
const cats = SITE.categories[locale] as Record<string, string>;
---
<BaseLayout title={SITE.meta[locale].title} description={SITE.meta[locale].description} path={path} wide>

  <!-- ── Particle Hero ── -->
  <section class="hero" id="hero">
    <canvas class="hero-canvas" id="hero-canvas" aria-hidden="true"></canvas>
    <div class="hero-content">
      <span class="hero-badge">{t('home.tagline')}</span>
      <h1 class="hero-title">Hu Lab</h1>
      <p class="hero-desc">{t('home.intro')}</p>
      <div class="hero-cats">
        {Object.entries(cats).map(([key, name]) => (
          <a href={withBase(`/${locale}/${key}`)} class="hero-cat">
            {name}
            <span class="hero-cat-count">{catCounts[key] ?? 0}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Projects ── -->
  {projects.length > 0 && (
    <section class="section reveal">
      <h2 class="section-label">{t('home.projects')}</h2>
      <div class="project-grid">
        {projects.map((post) => {
          const cat = post.id.split('/')[1];
          const catName = cats[cat] ?? cat;
          const slug = post.data.slug ?? post.id.split('/').slice(2).join('/');
          return (
            <a href={withBase(`/${locale}/${cat}/${slug}`)} class="project-card group">
              <div class="project-card__image">
                {post.data.cover
                  ? <Image src={post.data.cover} alt={post.data.title} width={640} height={400} class="w-full h-full object-cover" loading="lazy" />
                  : <div class="w-full h-full flex items-center justify-center bg-[var(--color-accent-muted)] text-[var(--color-accent)] text-sm">{catName}</div>
                }
              </div>
              <div class="project-card__body">
                <span class="project-card__cat">{catName}</span>
                <h3 class="project-card__title">{post.data.title}</h3>
                <p class="project-card__desc">{post.data.description}</p>
                <div class="project-card__meta">
                  <span>{post.data.date.toLocaleDateString(locale === 'zh' ? 'zh-TW' : 'en-US')}</span>
                  <span class="opacity-40">·</span>
                  <span>{readingTime(post.body, locale)}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- ── Latest posts ── -->
  <section class="section reveal reveal-delay-1">
    <h2 class="section-label">{t('home.latest')}</h2>
    <div class="post-grid">
      {latest.map((post) => (
        <ArticleCard post={post} locale={locale} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 4rem;
    /* Break out of parent max-w container */
    width: 100vw;
    max-width: none;
    margin-left: calc(-50vw + 50% - 1.25rem);
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 640px;
  }
  .hero-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 1.5rem + 6vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 1rem;
    color: var(--color-text);
  }
  .hero-desc {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.2rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 480px;
    margin: 0 auto 2rem;
  }
  .hero-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .hero-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: all 200ms var(--ease);
  }
  .hero-cat:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-muted);
  }
  .hero-cat-count {
    font-size: 0.7rem;
    opacity: 0.6;
  }

  /* ── Sections ── */
  .section {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }
  .section-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin: 0 0 1.5rem;
  }

  /* ── Project cards ── */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 280ms var(--ease), box-shadow 280ms var(--ease), transform 280ms var(--ease);
    background: var(--color-surface);
  }
  .project-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 12px 40px -10px var(--color-accent-glow), 0 4px 12px rgba(0,0,0,0.15);
    transform: translateY(-3px);
  }
  .project-card__image {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--color-surface-raised);
  }
  .project-card__image :global(img) {
    transition: transform 500ms var(--ease);
  }
  .project-card:hover .project-card__image :global(img) {
    transform: scale(1.04);
  }
  .project-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }
  .project-card__cat {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .project-card__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    color: var(--color-text);
    transition: color 200ms var(--ease);
  }
  .project-card:hover .project-card__title {
    color: var(--color-accent);
  }
  .project-card__desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-card__meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--color-text-tertiary);
    margin-top: auto;
    padding-top: 0.75rem;
  }

  /* ── Post grid ── */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
    .hero {
      min-height: 80vh;
      padding: 4rem 1.5rem 3rem;
    }
  }
  @media (min-width: 72rem) {
    /* Subtle radial edge fade so particles don't clip harshly at viewport edges */
    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background: radial-gradient(ellipse at center, transparent 60%, var(--color-bg) 100%);
    }
  }
</style>

<script>
  // ── Dust particle canvas ──
  // Tiny floating dust specks with ripple-on-cursor + glow.
  // A few brighter "firefly" particles drift with sin-wave motion.
  (function() {
    const canvas = document.getElementById('hero-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let w, h, particles = [];
    const mouse = { x: -9999, y: -9999, vx: 0, vy: 0, prevX: -9999, prevY: -9999 };
    let time = 0;

    // ── Colour helpers ──
    function getAccent() {
      const style = getComputedStyle(document.documentElement);
      return style.getPropertyValue('--color-accent').trim() || '#6c8cff';
    }
    function hexToRgb(hex) {
      const r = parseInt(hex.slice(1,3), 16);
      const g = parseInt(hex.slice(3,5), 16);
      const b = parseInt(hex.slice(5,7), 16);
      return { r, g, b };
    }

    // 5-color palette
    const COPPER = { r: 232, g: 168, b: 124 };
    const PURPLE = { r: 167, g: 139, b: 250 };
    const TEAL  = { r: 94,  g: 234, b: 212 };
    const WHITE = { r: 255, g: 255, b: 255 };
    const PALETTE = ['accent', 'copper', 'purple', 'teal', 'white'];
    function pickColor(accent) {
      const t = PALETTE[Math.floor(Math.random() * PALETTE.length)];
      if (t === 'copper') return COPPER;
      if (t === 'purple') return PURPLE;
      if (t === 'teal') return TEAL;
      if (t === 'white') return WHITE;
      return accent;
    }

    // ── Resize ──
    function resize() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      w = rect.width;
      h = rect.height;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // ── Create particles ──
    function createParticles() {
      particles = [];
      const accent = hexToRgb(getAccent());
      const COUNT = 1100;
      const FIREFLY_COUNT = 30;

      for (let i = 0; i < COUNT; i++) {
        const isFirefly = i < FIREFLY_COUNT;
        const baseSize = isFirefly
          ? 3.0 + Math.random() * 5.0   // 3~8px
          : 3.0 + Math.random() * 2.0;  // 3~5px
        const baseOpacity = isFirefly
          ? 0.4 + Math.random() * 0.4
          : 0.1 + Math.random() * 0.2;
        const color = pickColor(accent);

        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          // Dust: barely moving; firefly: gentle drift
          vx: isFirefly
            ? (Math.random() - 0.5) * 0.12
            : (Math.random() - 0.5) * 0.025,
          vy: isFirefly
            ? (Math.random() - 0.5) * 0.12
            : (Math.random() - 0.5) * 0.025,
          size: baseSize,
          baseOpacity,
          opacity: baseOpacity,
          color,
          isFirefly,
          // For sin-wave floating (fireflies only)
          phaseX: Math.random() * Math.PI * 2,
          phaseY: Math.random() * Math.PI * 2,
          freqX: 0.002 + Math.random() * 0.004,
          freqY: 0.002 + Math.random() * 0.004,
          ampX: 4 + Math.random() * 6,
          ampY: 4 + Math.random() * 6,
          // Brownian jitter seed
          jitterX: (Math.random() - 0.5) * 0.2,
          jitterY: (Math.random() - 0.5) * 0.2,
          // Original position for ripple return
          originX: 0,
          originY: 0,
          // Ripple displacement
          dx: 0,
          dy: 0,
        });
        // Store initial position as origin
        particles[i].originX = particles[i].x;
        particles[i].originY = particles[i].y;
      }
    }

    // ── Draw ──
    function draw() {
      ctx.clearRect(0, 0, w, h);
      const accent = hexToRgb(getAccent());

      for (const p of particles) {
        const px = p.x + p.dx;
        const py = p.y + p.dy;

        // ── Glow pass for fireflies ──
        if (p.isFirefly && p.opacity > 0.15) {
          const g = ctx.createRadialGradient(px, py, 0, px, py, p.size * 4);
          g.addColorStop(0, `rgba(${p.color.r},${p.color.g},${p.color.b},${p.opacity * 0.5})`);
          g.addColorStop(0.5, `rgba(${p.color.r},${p.color.g},${p.color.b},${p.opacity * 0.1})`);
          g.addColorStop(1, `rgba(${p.color.r},${p.color.g},${p.color.b},0)`);
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(px, py, p.size * 3.5, 0, Math.PI * 2);
          ctx.fill();
        }

        // ── Core dot ──
        ctx.beginPath();
        ctx.arc(px, py, p.size * 0.6, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${p.color.r},${p.color.g},${p.color.b},${p.opacity})`;
        ctx.fill();
      }
    }

    // ── Update ──
    function update() {
      time++;
      const accent = hexToRgb(getAccent());

      // Update mouse velocity for ripple direction
      mouse.vx = mouse.x - mouse.prevX;
      mouse.vy = mouse.y - mouse.prevY;
      mouse.prevX = mouse.x;
      mouse.prevY = mouse.y;

      for (const p of particles) {
        // ── Firefly sin-wave floating ──
        if (p.isFirefly) {
          p.x += Math.sin(time * p.freqX + p.phaseX) * 0.04;
          p.y += Math.sin(time * p.freqY + p.phaseY) * 0.04;
        }

        // ── Brownian motion: random jitter each frame ──
        p.x += p.vx + (Math.random() - 0.5) * 0.14;
        p.y += p.vy + (Math.random() - 0.5) * 0.14;

        // ── Wrap around ──
        const margin = 100;
        if (p.x < -margin) p.x = w + margin;
        if (p.x > w + margin) p.x = -margin;
        if (p.y < -margin) p.y = h + margin;
        if (p.y > h + margin) p.y = -margin;

        // ── Ripple: cursor pushes particles away ──
        const dx = p.x + p.dx - mouse.x;
        const dy = p.y + p.dy - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const RADIUS = 160;
        const PUSH = 6;

        if (dist < RADIUS && dist > 0.5) {
          const strength = (1 - dist / RADIUS);
          const angle = Math.atan2(dy, dx);
          p.dx += Math.cos(angle) * strength * PUSH * (1 + Math.abs(Math.cos(angle)) * 0.3);
          p.dy += Math.sin(angle) * strength * PUSH * (1 + Math.abs(Math.sin(angle)) * 0.3);
        }

        // ── Restoring force (spring back to origin) ──
        p.dx *= 0.92;
        p.dy *= 0.92;

        // ── Cursor glow: particles near cursor brighten ──
        if (dist < 180) {
          const glow = (1 - dist / 180) * 0.5;
          p.opacity = Math.min(0.55, p.baseOpacity + glow);
        } else {
          // Fade back to base opacity
          p.opacity += (p.baseOpacity - p.opacity) * 0.06;
        }
      }

      draw();
      requestAnimationFrame(update);
    }

    // ── Events ──
    function handleMouse(e) {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    }
    function handleLeave() {
      mouse.x = -9999;
      mouse.y = -9999;
    }
    function handleResize() {
      resize();
      createParticles();
    }

    // ── Re-read accent on theme toggle ──
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        // Rebuild palette with new accent
        setTimeout(createParticles, 50);
      });
    }

    // ── Init ──
    resize();
    createParticles();
    update();
    window.addEventListener('resize', handleResize);
    window.addEventListener('mousemove', handleMouse);
    window.addEventListener('mouseleave', handleLeave);
  })();
</script>
