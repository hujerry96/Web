---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, type Locale } from '../../consts';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const path = `/${locale}/free-resources`;
---
<BaseLayout title={`${t('nav.free')} | ${SITE.name}`} description={t('page.freeDescTitle', { name: SITE.name })} path={path}>
  <Breadcrumb locale={locale} items={[{ name: t('nav.free'), url: path }]} />
  <h1>{t('nav.free')}</h1>
  <article class="prose">
    <p>{t('page.freeDesc')}</p>
  </article>
</BaseLayout>
